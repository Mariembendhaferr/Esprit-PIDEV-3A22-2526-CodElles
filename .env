# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local environment-specific overrides
#
# Real environment variables win over .env files.
#
# https://symfony.com/doc/current/configuration.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=32ba9a22e2127943d0274bb2e771f76f
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Base MySQL (doura_mondo) — adapter user/mot de passe dans .env.local si besoin
DATABASE_URL="mysql://root:@127.0.0.1:3306/doura_mondo?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Ex. SendGrid (recommandé) : mettez la clé API dans .env.local (ne commitez jamais la clé)
# MAILER_DSN=sendgrid+api://CLE_API_SENDGRID@default
# En local sans envoi : null://null
MAILER_DSN=null://null
MAILER_FROM_EMAIL=noreply@localhost
MAILER_FROM_NAME="Doura Mondo"
###< symfony/mailer ###

###> textrazor ###
# Put real key in .env.local:
# TEXTRAZOR_API_KEY=your_textrazor_key
TEXTRAZOR_API_KEY=
###< textrazor ###

###> laratranslate ###
# Put real credentials in .env.local
LARATRANSLATE_API_ID=
LARATRANSLATE_API_SECRET=
LARATRANSLATE_ENDPOINT=https://api.laratranslate.com/translate
###< laratranslate ###

###> moderation (Sightengine) ###
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
###< moderation ###
