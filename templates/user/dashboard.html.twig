{# templates/user/dashboard.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Mon Dashboard - Doura Mondo{% endblock %}
{% block page_title %}Mon Dashboard{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
/* ════════════════════════════════════════════════
   DOURA MONDO — ANIMATION LAYER
   Drops on top of existing base.html.twig layout.
   Zero changes to navbar, sidebar, or base styles.
════════════════════════════════════════════════ */

/* ── Keyframes Library ── */
@keyframes fadeUp        { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
@keyframes fadeLeft      { from{opacity:0;transform:translateX(-30px)} to{opacity:1;transform:translateX(0)} }
@keyframes fadeRight     { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }
@keyframes scalePop      { from{opacity:0;transform:scale(0.88)} to{opacity:1;transform:scale(1)} }
@keyframes shimmerSlide  { from{left:-120%} to{left:160%} }
@keyframes goldPulse     { 0%,100%{box-shadow:0 0 0 0 rgba(201,168,76,0)} 50%{box-shadow:0 0 0 8px rgba(201,168,76,0.12)} }
@keyframes orbDrift      { 0%,100%{transform:translate(0,0) scale(1)} 33%{transform:translate(22px,-30px) scale(1.04)} 66%{transform:translate(-18px,18px) scale(0.96)} }
@keyframes gradShift     { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }
@keyframes bannerSweep   { 0%,100%{left:-90%} 50%{left:130%} }
@keyframes avatarRing    { 0%,100%{box-shadow:0 0 0 4px rgba(201,168,76,0.08)} 50%{box-shadow:0 0 0 10px rgba(201,168,76,0.03)} }
@keyframes starBurst     { from{opacity:0;transform:scale(0) rotate(-180deg)} to{opacity:1;transform:scale(1) rotate(0)} }
@keyframes barFill       { from{width:0!important} }
@keyframes chipScroll1   { from{transform:translateX(0)} to{transform:translateX(-50%)} }
@keyframes chipScroll2   { from{transform:translateX(-50%)} to{transform:translateX(0)} }
@keyframes weatherFloat  { 0%,100%{transform:translateY(0) rotate(0)} 50%{transform:translateY(-7px) rotate(5deg)} }
@keyframes noiseDrift    { 100%{background-position:200px 200px} }
@keyframes particleFade  { 0%{opacity:0;transform:translateY(0)} 20%{opacity:.6} 80%{opacity:.6} 100%{opacity:0;transform:translateY(-60px)} }
@keyframes spin          { to{transform:rotate(360deg)} }
@keyframes blinkCursor   { 0%,100%{opacity:1} 50%{opacity:0} }
@keyframes borderRun {
  0%   { background-position: 0% 0%; }
  100% { background-position: 200% 0%; }
}
@keyframes cardTilt {
  0%  { transform: perspective(800px) rotateX(0deg) rotateY(0deg) translateY(0); }
  100%{ transform: perspective(800px) rotateX(0deg) rotateY(0deg) translateY(-5px); }
}

/* ── Entrance helpers ── */
.anim-up    { opacity:0; animation:fadeUp   .75s cubic-bezier(.23,1,.32,1) forwards; }
.anim-left  { opacity:0; animation:fadeLeft .75s cubic-bezier(.23,1,.32,1) forwards; }
.anim-right { opacity:0; animation:fadeRight .75s cubic-bezier(.23,1,.32,1) forwards; }
.anim-pop   { opacity:0; animation:scalePop .65s cubic-bezier(.23,1,.32,1) forwards; }

/* ══════════════════════════════════════
   ANIMATED PAGE BACKGROUND
   Fixed layer behind existing content
══════════════════════════════════════ */
.dm-anim-bg {
  position: fixed; inset: 0;
  pointer-events: none; z-index: 0;
  overflow: hidden;
}
.dm-bg-grad {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 70% 55% at 15% 8%,  rgba(139,44,44,.28) 0%, transparent 65%),
    radial-gradient(ellipse 55% 70% at 85% 92%,  rgba(92,0,0,.24) 0%, transparent 65%),
    radial-gradient(ellipse 45% 45% at 50% 50%,  rgba(201,168,76,.03) 0%, transparent 70%);
  animation: gradShift 20s ease infinite;
  background-size: 300% 300%;
}
.dm-bg-noise {
  position: absolute; inset: 0; opacity: .3;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");
  background-size: 200px;
  animation: noiseDrift 12s linear infinite;
}
.dm-orb {
  position: absolute; border-radius: 50%;
  filter: blur(80px); pointer-events: none;
  animation: orbDrift ease-in-out infinite;
}
.dm-orb-1 { width:480px;height:480px;top:-200px;left:-200px;background:radial-gradient(circle,rgba(139,44,44,.22),transparent 70%);animation-duration:24s; }
.dm-orb-2 { width:380px;height:380px;bottom:-160px;right:-160px;background:radial-gradient(circle,rgba(201,168,76,.10),transparent 70%);animation-duration:30s;animation-delay:-8s; }
.dm-orb-3 { width:260px;height:260px;top:40%;left:55%;background:radial-gradient(circle,rgba(176,80,80,.15),transparent 70%);animation-duration:19s;animation-delay:-4s; }

/* Floating particles */
#dm-particles-canvas { position:fixed;inset:0;z-index:1;pointer-events:none; }

/* ══════════════════════════════════════
   PROFILE BANNER ANIMATIONS
══════════════════════════════════════ */
.profile-banner {
  position: relative;
  overflow: hidden;
}

/* Animated gradient background override */
.profile-banner-animated {
  background: linear-gradient(135deg,
    #1c0404 0%, #3a0000 40%, #5C0000 70%, #3a0000 100%) !important;
  background-size: 300% 300% !important;
  animation: gradShift 12s ease infinite !important;
}

/* Sweep light beam */
.dm-banner-sweep {
  position: absolute; top: -60%; left: -100%;
  width: 50%; height: 220%;
  background: linear-gradient(105deg, transparent, rgba(201,168,76,.055), transparent);
  transform: skewX(-15deg);
  animation: bannerSweep 8s ease-in-out infinite;
  pointer-events: none;
}

/* Crosshatch overlay */
.dm-banner-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(201,168,76,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(201,168,76,.03) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none;
}

/* Avatar ring pulse */
.pb-avatar {
  animation: avatarRing 4s ease-in-out infinite !important;
}

/* ── Running-border glow on banner ── */
.profile-banner::after {
  content: '';
  position: absolute; inset: 0; border-radius: inherit;
  padding: 1.5px;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(201,168,76,.7) 20%,
    rgba(201,168,76,.9) 50%,
    rgba(201,168,76,.7) 80%,
    transparent 100%);
  background-size: 200% 100%;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: destination-out;
  mask-composite: exclude;
  animation: borderRun 4s linear infinite;
  pointer-events: none;
}

/* ══════════════════════════════════════
   GLASS CARD EFFECT on existing cards
══════════════════════════════════════ */
.quick-card,
.info-card,
.weather-widget,
.weather-search,
.carbon-widget .card {
  position: relative;
  overflow: hidden;
  transition: transform .42s cubic-bezier(.23,1,.32,1),
              box-shadow .42s cubic-bezier(.23,1,.32,1),
              border-color .42s cubic-bezier(.23,1,.32,1) !important;
}

/* Shimmer sweep on every card */
.quick-card::after,
.info-card::after,
.weather-widget::after,
.weather-search::after,
.carbon-widget .card::after {
  content: '';
  position: absolute; top: 0; left: -130%;
  width: 55%; height: 100%;
  background: linear-gradient(105deg, transparent, rgba(201,168,76,.08) 50%, transparent);
  transform: skewX(-18deg);
  pointer-events: none;
  transition: none;
}
.quick-card:hover::after,
.info-card:hover::after,
.weather-widget:hover::after,
.weather-search:hover::after,
.carbon-widget .card:hover::after {
  left: 160%;
  transition: left .65s cubic-bezier(.23,1,.32,1);
}

/* Hover lift */
.quick-card:hover,
.info-card:hover,
.weather-widget:hover,
.carbon-widget .card:hover {
  transform: translateY(-6px) !important;
  box-shadow: 0 16px 48px rgba(92,0,0,.18), 0 0 0 1px rgba(201,168,76,.18) !important;
  border-color: rgba(201,168,76,.30) !important;
}
.weather-search:hover {
  box-shadow: 0 8px 28px rgba(92,0,0,.12) !important;
}

/* quick-card icon spin on hover */
.quick-card:hover .qc-ico {
  display: inline-block;
  animation: spin .5s ease;
}

/* ══════════════════════════════════════
   DESTINATION CHIPS CAROUSEL
══════════════════════════════════════ */
.dm-chips-section { margin-bottom: 1.5rem; overflow: hidden; }
.dm-chips-row { display: flex; gap: .85rem; white-space: nowrap; }
.dm-chips-r1 { animation: chipScroll1 26s linear infinite; }
.dm-chips-r2 { animation: chipScroll2 34s linear infinite; margin-top: .65rem; }
.dm-chips-section:hover .dm-chips-r1,
.dm-chips-section:hover .dm-chips-r2 { animation-play-state: paused; }
.dm-chip {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .45rem 1rem;
  background: rgba(92,0,0,.08);
  border: 1px solid rgba(201,168,76,.14);
  border-radius: 100px;
  font-size: .76rem; color: rgba(42,16,16,.7);
  white-space: nowrap; cursor: pointer;
  transition: all .35s cubic-bezier(.23,1,.32,1);
  font-family: 'Montserrat', sans-serif;
}
.dm-chip:hover {
  background: rgba(92,0,0,.14);
  border-color: rgba(201,168,76,.35);
  color: #5C0000;
  transform: translateY(-2px);
}

/* ══════════════════════════════════════
   SECTION LABEL DIVIDERS
══════════════════════════════════════ */
.dm-section-divider {
  display: flex; align-items: center; gap: .9rem;
  margin: 1.75rem 0 1.1rem;
}
.dm-section-divider::before,
.dm-section-divider::after {
  content: '';
  flex: 1; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(92,0,0,.18), transparent);
}
.dm-section-divider span {
  font-family: 'Cormorant Garamond', serif;
  font-size: .68rem; letter-spacing: .22em;
  text-transform: uppercase; color: #8B2C2C;
  white-space: nowrap; font-style: italic;
}

/* ══════════════════════════════════════
   STAT COUNTERS
══════════════════════════════════════ */
.dm-stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: .9rem;
  margin-bottom: 1.5rem;
}
.dm-stat-card {
  background: #fff;
  border-radius: 16px;
  border: 1px solid rgba(201,168,76,.15);
  padding: 1.25rem 1rem;
  text-align: center;
  position: relative; overflow: hidden;
  transition: all .4s cubic-bezier(.23,1,.32,1);
  box-shadow: 0 2px 12px rgba(92,0,0,.06);
}
.dm-stat-card::before {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, #8B2C2C, #C9A84C, #8B2C2C);
  background-size: 200% 100%;
  animation: borderRun 3s linear infinite;
}
.dm-stat-card::after {
  content: '';
  position: absolute; top: 0; left: -130%; width: 55%; height: 100%;
  background: linear-gradient(105deg, transparent, rgba(201,168,76,.07) 50%, transparent);
  transform: skewX(-18deg); pointer-events: none; transition: none;
}
.dm-stat-card:hover::after { left: 160%; transition: left .6s cubic-bezier(.23,1,.32,1); }
.dm-stat-card:hover {
  transform: translateY(-6px) scale(1.02);
  box-shadow: 0 12px 36px rgba(92,0,0,.14);
  border-color: rgba(201,168,76,.30);
}
.dm-stat-ico {
  font-size: 1.6rem; margin-bottom: .5rem;
  display: block;
  transition: transform .4s cubic-bezier(.23,1,.32,1);
}
.dm-stat-card:hover .dm-stat-ico { transform: scale(1.15) rotate(-6deg); }
.dm-stat-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2rem; font-weight: 700;
  color: #5C0000; line-height: 1; margin-bottom: .2rem;
}
.dm-stat-lbl {
  font-size: .65rem; font-weight: 600;
  letter-spacing: .1em; text-transform: uppercase;
  color: #9B6B6B;
}

/* ══════════════════════════════════════
   WEATHER ICON FLOAT
══════════════════════════════════════ */
.weather-widget .display-6 img,
.weather-widget .display-6 { 
  animation: weatherFloat 4s ease-in-out infinite;
}

/* Progress bar animated fill */
.progress-bar {
  animation: barFill 1.4s cubic-bezier(.23,1,.32,1) both !important;
  animation-delay: .6s !important;
}

/* ══════════════════════════════════════
   INFO ROW HOVER
══════════════════════════════════════ */
.info-row {
  transition: padding-left .25s ease, background .2s ease !important;
  border-radius: 6px;
}
.info-row:hover { padding-left: .6rem !important; background: rgba(201,168,76,.04); }

/* ══════════════════════════════════════
   BUTTON MICRO-INTERACTIONS
══════════════════════════════════════ */
.btn-primary {
  position: relative; overflow: hidden;
  transition: all .35s cubic-bezier(.23,1,.32,1) !important;
}
.btn-primary::after {
  content: '';
  position: absolute; inset: 0;
  background: rgba(255,255,255,.12);
  transform: scaleX(0); transform-origin: left;
  transition: transform .35s ease;
}
.btn-primary:hover::after { transform: scaleX(1); }
.btn-primary:hover { transform: translateY(-2px) !important; box-shadow: 0 8px 24px rgba(92,0,0,.35) !important; }
.btn-primary:active { transform: scale(.96) !important; }

.btn-outline-success {
  transition: all .3s cubic-bezier(.23,1,.32,1) !important;
}
.btn-outline-success:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(5,150,105,.25) !important; }

/* ══════════════════════════════════════
   LOADING SPINNER
══════════════════════════════════════ */
.dm-spinner {
  width: 16px; height: 16px;
  border: 2px solid rgba(201,168,76,.25);
  border-top-color: #C9A84C;
  border-radius: 50%;
  animation: spin .6s linear infinite;
  display: inline-block; vertical-align: middle; margin-right: 5px;
}

/* ══════════════════════════════════════
   STAR RATINGS BURST ANIMATION
══════════════════════════════════════ */
.dm-star-burst {
  display: inline-block;
  animation: starBurst .35s cubic-bezier(.23,1,.32,1) both;
}

/* ══════════════════════════════════════
   TILT CARD 3D on hover  (JS-driven)
══════════════════════════════════════ */
.tilt-card { transform-style: preserve-3d; will-change: transform; }

/* ══════════════════════════════════════
   SCROLL REVEAL
══════════════════════════════════════ */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity .65s cubic-bezier(.23,1,.32,1), transform .65s cubic-bezier(.23,1,.32,1); }
.reveal.visible { opacity: 1; transform: translateY(0); }

/* ══════════════════════════════════════
   PAGE LOAD CURTAIN
══════════════════════════════════════ */
#dm-curtain {
  position: fixed; inset: 0; z-index: 9999;
  background: #1c0404;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column; gap: 1rem;
  animation: curtainExit .5s cubic-bezier(.23,1,.32,1) .8s forwards;
}
@keyframes curtainExit {
  to { opacity: 0; visibility: hidden; pointer-events: none; }
}
.dm-curtain-logo {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.2rem; font-weight: 700; color: #C9A84C;
  letter-spacing: .08em;
  animation: fadeUp .6s ease both;
}
.dm-curtain-line {
  width: 120px; height: 1px;
  background: linear-gradient(90deg, transparent, #C9A84C, transparent);
  animation: fadeUp .6s ease .2s both;
}
.dm-curtain-sub {
  font-size: .7rem; letter-spacing: .25em; text-transform: uppercase;
  color: rgba(201,168,76,.45);
  animation: fadeUp .6s ease .35s both;
}
.dm-curtain-spinner {
  width: 28px; height: 28px;
  border: 2px solid rgba(201,168,76,.2);
  border-top-color: #C9A84C;
  border-radius: 50%;
  animation: spin .7s linear infinite, fadeUp .6s ease .4s both;
}

/* ========== CORRECTIONS LARGEUR ET BLOCS ========== */

/* Conteneur principal - ajout de marges */
.container-xxl {
    padding-left: 2rem !important;
    padding-right: 2rem !important;
    max-width: 100%;
    overflow-x: hidden;
}

/* Quick Actions Grid - CÔTE À CÔTE (pas en colonne) */
.quick-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-bottom: 2rem;
}

/* Responsive Quick Actions */
@media (max-width: 992px) {
    .quick-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
}

@media (max-width: 576px) {
    .quick-grid {
        grid-template-columns: 1fr;
    }
}

/* Stats row responsive */
@media (max-width: 992px) {
    .dm-stats-row {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 576px) {
    .dm-stats-row {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* Quick cards style amélioré */
.quick-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.2rem 0.8rem;
    background: #fff;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid rgba(201,168,128,0.15);
}

.quick-card .qc-ico {
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

.quick-card .qc-label {
    font-weight: 600;
    font-size: 0.9rem;
    color: #5C0000;
    margin-bottom: 0.2rem;
}

.quick-card .qc-sub {
    font-size: 0.7rem;
    color: #999;
}

/* Profile banner responsive */
@media (max-width: 768px) {
    .profile-banner {
        flex-direction: column;
        text-align: center;
    }
    .profile-banner > div:last-child {
        text-align: center !important;
    }
}

/* Weather widget responsive */
@media (max-width: 576px) {
    .weather-widget .d-flex {
        flex-direction: column;
        text-align: center;
    }
    .weather-widget .text-end {
        text-align: center !important;
        margin-top: 1rem;
    }
}

/* Carbon widget responsive */
@media (max-width: 576px) {
    .carbon-widget .row {
        flex-direction: column;
    }
    .carbon-widget .col-4,
    .carbon-widget .col-8 {
        width: 100%;
        text-align: center;
    }
}

/* Animation for quick cards on hover */
.quick-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(139,44,44,0.1);
    border-color: rgba(201,168,128,0.4);
}

/* Section dividers responsive */
@media (max-width: 576px) {
    .dm-section-divider span {
        font-size: 0.55rem;
        white-space: normal;
        text-align: center;
    }
}

/* Info card responsive */
@media (max-width: 576px) {
    .info-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.3rem;
    }
}
</style>
{% endblock %}

{% block body %}

<!-- ══ PAGE LOAD CURTAIN ══ -->
<div id="dm-curtain">
  <div class="dm-curtain-logo">✦ Doura Mondo</div>
  <div class="dm-curtain-line"></div>
  <div class="dm-curtain-sub">Voyages de Luxe</div>
  <div class="dm-curtain-spinner"></div>
</div>

<!-- ══ ANIMATED BACKGROUND LAYER ══ -->
<div class="dm-anim-bg">
  <div class="dm-bg-grad"></div>
  <div class="dm-bg-noise"></div>
  <div class="dm-orb dm-orb-1"></div>
  <div class="dm-orb dm-orb-2"></div>
  <div class="dm-orb dm-orb-3"></div>
</div>
<canvas id="dm-particles-canvas"></canvas>

<!-- ══ ORIGINAL CONTENT — UNTOUCHED ══ -->

<!-- Banner with animation classes injected via JS after load -->
<div class="profile-banner anim-up" style="animation-delay:.1s">
    <div class="dm-banner-grid"></div>
    <div class="dm-banner-sweep"></div>

    <div class="pb-avatar">
        {% if user.photoProfil and user.photoProfil != 'default.jpg' %}
            <img src="/{{ user.photoProfil }}" alt="avatar">
        {% else %}
            {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
        {% endif %}
    </div>
    <div class="pb-info">
        <div class="pb-name">{{ user.prenom }} {{ user.nom }}</div>
        <div class="pb-user">@{{ user.username }}</div>
        <div class="pb-badge">✈️ Voyageur</div>
        {% if user.averageRating > 0 %}
            <div style="margin-top:.5rem; position:relative; z-index:1;">
                {% for i in 1..5 %}
                    <span class="dm-star-burst" style="animation-delay:{{ i * 0.1 }}s">{{ i <= user.averageRating|round ? '⭐' : '☆' }}</span>
                {% endfor %}
                <span style="color:var(--gold); font-weight:700; font-size:.85rem;">
                    {{ user.averageRating|number_format(1) }}
                </span>
            </div>
        {% endif %}
    </div>
    <div style="position:relative;z-index:1;text-align:right;">
        <div style="font-size:.7rem;color:rgba(201,168,76,.35);letter-spacing:1px;">AUJOURD'HUI</div>
        <div style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;color:var(--gold);">
            {{ "now"|date("d M Y") }}
        </div>
    </div>
</div>

<!-- ══ STAT CARDS ROW ══ -->
<div class="dm-stats-row">
  <div class="dm-stat-card reveal tilt-card" data-delay="0">
    <span class="dm-stat-ico">✈️</span>
    <div class="dm-stat-num counter" data-target="12">0</div>
    <div class="dm-stat-lbl">Voyages</div>
  </div>
