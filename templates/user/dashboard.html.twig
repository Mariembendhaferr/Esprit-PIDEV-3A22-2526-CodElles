{% block javascripts %}
<script>
(function () {
'use strict';

/* ════════════════════════════
   1. PARTICLE CANVAS
════════════════════════════ */
var canvas = document.getElementById('dm-particles-canvas');
var ctx = canvas.getContext('2d');
var W, H, pts = [];

function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
resize();
window.addEventListener('resize', resize);

function Pt() { this.init(); }
Pt.prototype.init = function () {
  this.x  = Math.random() * W;
  this.y  = Math.random() * H;
  this.r  = Math.random() * 1.1 + 0.3;
  this.vx = (Math.random() - .5) * .28;
  this.vy = (Math.random() - .5) * .28 - .12;
  this.life = 0;
  this.max  = Math.random() * 260 + 140;
  this.gold = Math.random() > .45;
};
Pt.prototype.tick = function () {
  this.x += this.vx; this.y += this.vy; this.life++;
  if (this.life > this.max || this.x < 0 || this.x > W || this.y < 0 || this.y > H) this.init();
};
Pt.prototype.draw = function () {
  var t = this.life / this.max;
  var a = (t < .15 ? t/.15 : t > .85 ? (1-t)/.15 : 1) * .5;
  ctx.beginPath();
  ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
  ctx.fillStyle = this.gold ? 'rgba(201,168,76,' + a + ')' : 'rgba(253,250,244,' + a*.55 + ')';
  ctx.fill();
};

for (var i = 0; i < 80; i++) { var p = new Pt(); p.life = Math.random() * p.max; pts.push(p); }

(function loop() {
  ctx.clearRect(0, 0, W, H);
  pts.forEach(function (p) { p.tick(); p.draw(); });
  requestAnimationFrame(loop);
})();

/* ════════════════════════════
   2. SCROLL REVEAL
════════════════════════════ */
function checkReveal() {
  document.querySelectorAll('.reveal:not(.visible)').forEach(function (el) {
    var r = el.getBoundingClientRect();
    if (r.top < window.innerHeight - 60) {
      var delay = parseInt(el.dataset.delay || 0, 10);
      setTimeout(function () { el.classList.add('visible'); }, delay);
    }
  });
}
window.addEventListener('scroll', checkReveal, { passive: true });
checkReveal();

/* ════════════════════════════
   3. COUNTER UP
════════════════════════════ */
function runCounter(el) {
  var target = parseFloat(el.dataset.target) || 0;
  var isFloat = target % 1 !== 0;
  var dur = 1100, start = null;
  function tick(now) {
    if (!start) start = now;
    var t = Math.min((now - start) / dur, 1);
    var e = 1 - Math.pow(1 - t, 3);
    el.textContent = isFloat ? (e * target).toFixed(1) : Math.round(e * target);
    if (t < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

// Trigger counters when visible
var countersDone = new WeakSet();
var counterObserver = new IntersectionObserver(function (entries) {
  entries.forEach(function (entry) {
    if (entry.isIntersecting && !countersDone.has(entry.target)) {
      countersDone.add(entry.target);
      setTimeout(function () { runCounter(entry.target); }, 300);
    }
  });
}, { threshold: 0.3 });
document.querySelectorAll('.counter').forEach(function (el) { counterObserver.observe(el); });

/* ════════════════════════════
   4. 3D TILT ON HOVER
════════════════════════════ */
document.querySelectorAll('.tilt-card').forEach(function (card) {
  card.addEventListener('mousemove', function (e) {
    var r = card.getBoundingClientRect();
    var x = (e.clientX - r.left) / r.width  - .5;
    var y = (e.clientY - r.top)  / r.height - .5;
    card.style.transform = 'perspective(700px) rotateY(' + (x * 10) + 'deg) rotateX(' + (-y * 10) + 'deg) translateY(-5px) scale(1.02)';
  });
  card.addEventListener('mouseleave', function () {
    card.style.transform = '';
    card.style.transition = 'transform .5s cubic-bezier(.23,1,.32,1)';
    setTimeout(function () { card.style.transition = ''; }, 500);
  });
});

/* ════════════════════════════
   5. ORB PARALLAX ON MOUSE
════════════════════════════ */
document.addEventListener('mousemove', function (e) {
  var rx = (e.clientX / window.innerWidth  - .5) * 20;
  var ry = (e.clientY / window.innerHeight - .5) * 20;
  document.querySelectorAll('.dm-orb').forEach(function (o, i) {
    var d = (i + 1) * .55;
    o.style.transform = 'translate(' + rx * d + 'px,' + ry * d + 'px)';
  });
});

/* ════════════════════════════
   6. CITY AUTOCOMPLETE
════════════════════════════ */
function cityAuto(inputId, latId, lonId, cityId, sugId) {
  var inp = document.getElementById(inputId);
  var sug = document.getElementById(sugId);
  if (!inp) return;
  var tid;
  inp.addEventListener('input', function () {
    clearTimeout(tid);
    var q = this.value.trim();
    if (q.length < 2) { sug.style.display = 'none'; return; }
    tid = setTimeout(function () {
      fetch('https://nominatim.openstreetmap.org/search?q=' + encodeURIComponent(q) + '&format=json&limit=5&addressdetails=1')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.length) { sug.style.display = 'none'; return; }
          sug.innerHTML = '';
          data.forEach(function (place) {
            var div = document.createElement('div');
            div.className = 'city-suggestion-item';
            var city = place.display_name.split(',')[0];
            var country = (place.address && place.address.country) || '';
            div.innerHTML = '<div class="city-name">' + city + '</div><div class="country-name">' + country + '</div>';
            div.onclick = function () {
              inp.value = city;
              document.getElementById(latId).value = place.lat;
              document.getElementById(lonId).value = place.lon;
              document.getElementById(cityId).value = city;
              sug.style.display = 'none';
            };
            sug.appendChild(div);
          });
          sug.style.display = 'block';
        }).catch(function () { sug.style.display = 'none'; });
    }, 480);
  });
  document.addEventListener('click', function (e) {
    if (!inp.contains(e.target) && !sug.contains(e.target)) sug.style.display = 'none';
  });
}
cityAuto('fromCityInput','fromLat','fromLon','fromCity','fromSuggestions');
cityAuto('toCityInput','toLat','toLon','toCity','toSuggestions');

/* ════════════════════════════
   7. FORM LOADING SPINNERS
════════════════════════════ */
var wf = document.getElementById('weatherForm');
if (wf) wf.addEventListener('submit', function () {
  var t = document.getElementById('weatherBtnTxt');
  if (t) t.innerHTML = '<span class="dm-spinner"></span> Chargement…';
});

var cf = document.getElementById('carbonForm');
if (cf) cf.addEventListener('submit', function () {
  var t = document.getElementById('carbonBtnTxt');
  if (t) t.innerHTML = '<span class="dm-spinner"></span> Calcul en cours…';
});

/* ════════════════════════════
   8. BANNER ANIMATED BG
════════════════════════════ */
var banner = document.querySelector('.profile-banner');
if (banner) banner.classList.add('profile-banner-animated');

/* ════════════════════════════
   9. MAGNETIC BUTTON EFFECT
════════════════════════════ */
document.querySelectorAll('.btn-primary, .quick-card').forEach(function (btn) {
  btn.addEventListener('mousemove', function (e) {
    var r = btn.getBoundingClientRect();
    var x = e.clientX - r.left - r.width  / 2;
    var y = e.clientY - r.top  - r.height / 2;
    btn.style.transform = 'translate(' + x*.12 + 'px,' + y*.12 + 'px) translateY(-4px)';
  });
  btn.addEventListener('mouseleave', function () {
    btn.style.transform = '';
    btn.style.transition = 'transform .4s cubic-bezier(.23,1,.32,1)';
    setTimeout(function () { btn.style.transition = ''; }, 400);
  });
});

/* ════════════════════════════
   10. RIPPLE ON CLICK
════════════════════════════ */
document.querySelectorAll('.btn-primary, .dm-stat-card, .quick-card').forEach(function (el) {
  el.addEventListener('click', function (e) {
    var ripple = document.createElement('span');
    var r = el.getBoundingClientRect();
    var size = Math.max(r.width, r.height);
    ripple.style.cssText = [
      'position:absolute',
      'border-radius:50%',
      'background:rgba(201,168,76,.25)',
      'width:' + size + 'px',
      'height:' + size + 'px',
      'top:' + (e.clientY - r.top  - size/2) + 'px',
      'left:' + (e.clientX - r.left - size/2) + 'px',
      'transform:scale(0)',
      'pointer-events:none',
      'animation:rippleOut .55s ease forwards'
    ].join(';');
    el.style.position = 'relative';
    el.style.overflow = 'hidden';
    el.appendChild(ripple);
    setTimeout(function () { ripple.remove(); }, 600);
  });
});

/* Ripple keyframe injected once */
if (!document.getElementById('dm-ripple-style')) {
  var s = document.createElement('style');
  s.id = 'dm-ripple-style';
  s.textContent = '@keyframes rippleOut{to{transform:scale(2.5);opacity:0}}';
  document.head.appendChild(s);
}

})();
</script>
{% endblock %}