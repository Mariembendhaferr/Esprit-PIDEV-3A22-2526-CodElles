{% block javascripts %}
    {{ parent() }}
    <script>
        // ========== CAROUSEL LOGIC (inchangé) ==========
        function goTo(id) {
            event.preventDefault();
            const el = document.getElementById(id);
            if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: "smooth" });
        }

        const S = {
            europe: { c: 1, t: 3 },
            afrique: { c: 1, t: 3 },
            asie: { c: 1, t: 3 },
            ameriques: { c: 1, t: 3 },
            oceanie: { c: 1, t: 3 }
        };

        function render(n) {
            const { c, t } = S[n];
            const sl = document.querySelectorAll("#gw-" + n + " .gs");
            const dt = document.querySelectorAll("#d-" + n + " .gdot");
            const pv = (c - 1 + t) % t;
            const nx = (c + 1) % t;
            sl.forEach((s, i) => {
                s.className = "gs";
                if (i === c) s.classList.add("center");
                else if (i === pv) s.classList.add("left");
                else if (i === nx) s.classList.add("right");
                else s.classList.add("hr");
            });
            dt.forEach((d, i) => d.classList.toggle("on", i === c));
        }

        function slide(n, d) {
            S[n].c = (S[n].c + d + S[n].t) % S[n].t;
            render(n);
        }

        function go(n, i) {
            S[n].c = i;
            render(n);
        }

        document.querySelectorAll(".gs").forEach(s => {
            s.addEventListener("click", function () {
                if (this.classList.contains("left") || this.classList.contains("right")) {
                    const n = this.closest(".gw").id.replace("gw-", "");
                    slide(n, this.classList.contains("left") ? -1 : 1);
                }
            });
        });

        Object.keys(S).forEach(render);





        // ========== AUTOCOMPLETE PAYS — chargement unique au démarrage ==========


        const input = document.getElementById('destination-input');
        const list  = document.getElementById('autocomplete-list');
        const btn   = document.getElementById('search-btn');

        let tousLesPays = []; // sera rempli une seule fois

        // On charge TOUS les pays une seule fois au chargement de la page
        fetch('https://restcountries.com/v3.1/all?fields=name,translations,flags')
            .then(res => res.json())
            .then(data => {
                tousLesPays = data.map(country => ({
                    nom: country.translations?.fra?.common || country.name.common,
                    flag: country.flags?.emoji || ''
                }));
                // Trier alphabétiquement
                tousLesPays.sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));
            })
            .catch(() => console.warn('Impossible de charger la liste des pays.'));

        // Filtrage LOCAL instantané à chaque frappe
        input.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, ''); // ignorer accents à la frappe

            if (query.length < 1) {
                list.innerHTML = '';
                list.style.display = 'none';
                return;
            }

            const resultats = tousLesPays.filter(p => {
                const nomNorm = p.nom.toLowerCase()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                return nomNorm.startsWith(query);
            }).slice(0, 6);

            list.innerHTML = '';

            if (resultats.length === 0) {
                list.innerHTML = '<li class="no-result">Aucun pays trouvé</li>';
                list.style.display = 'block';
                return;
            }

            resultats.forEach(pays => {
                const li = document.createElement('li');
                li.innerHTML = `<span class="ac-flag">${pays.flag}</span><span>${pays.nom}</span>`;

                li.addEventListener('click', () => {
                    input.value = pays.nom;
                    list.innerHTML = '';
                    list.style.display = 'none';
                });

                list.appendChild(li);
            });

            list.style.display = 'block';
        });

        // Fermer le dropdown si on clique ailleurs
        document.addEventListener('click', function (e) {
            if (!input.contains(e.target) && !list.contains(e.target)) {
                list.innerHTML = '';
                list.style.display = 'none';
            }
        });



        // Bouton Rechercher → redirection vers la page du pays
        btn.addEventListener('click', function () {
            const pays = input.value.trim();
            if (pays) {
                // On redirige vers /destination/nom_du_pays
                window.location.href = "/destination/" + encodeURIComponent(pays);
            }
        });

        // Touche Entrée = Rechercher
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') btn.click();
        });
        // ========== FIN AUTOCOMPLETE ==========


        
    </script>
{% endblock %}