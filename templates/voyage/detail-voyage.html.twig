        <!-- Description du voyage -->
        <div class="vic-description">
            {{ voyage.description ? voyage.description : 'Une expérience de voyage unique et mémorable, soigneusement élaborée pour vous offrir le meilleur de la destination. Chaque détail a été pensé pour créer des souvenirs inoubliables.' }}
        </div>

        <!-- Stats Durée / Personnes -->
        <div class="vic-stats">
