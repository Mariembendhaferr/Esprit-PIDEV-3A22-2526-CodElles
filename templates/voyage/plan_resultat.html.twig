{# templates/voyage/plan_resultat.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Votre Plan — {{ plan.destination }} — Doura Mondo{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ═══════════════════════════════════════════════════════
   DOURA MONDO — PLAN RÉSULTAT
   Charte : Rouge bordeaux · Beige crème · Blanc · Luxe
═══════════════════════════════════════════════════════ */
:root {
    --bordeaux:      #8B2C2C;
    --bordeaux-dk:   #6B1F1F;
    --bordeaux-lt:   rgba(139,44,44,0.08);
    --gold:          #9B7240;
    --gold-light:    #C4A882;
    --cream:         #F5EFE0;
    --cream-2:       #EDE3D0;
    --beige:         #F9F5ED;
    --white:         #ffffff;
    --dark:          #1a1a2e;
    --text-mid:      #4a4a5a;
    --text-muted:    #888899;
    --border:        rgba(139,44,44,0.12);
    --border-cream:  #E8DFD0;
    --shadow-sm:     0 4px 20px rgba(139,44,44,0.08);
    --shadow-md:     0 12px 50px rgba(139,44,44,0.25);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

.resultat-page {
    background: var(--beige);
    font-family: 'Montserrat', sans-serif;
    min-height: 100vh;
}

/* ═══ HERO CINÉMATIQUE ═══ */
.res-hero {
    position: relative;
    height: 72vh;
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
}
.res-hero-img {
    position: absolute; inset: 0;
    background-size: cover;
    background-position: center;
    animation: heroZoom 18s ease-in-out infinite alternate;
}
@keyframes heroZoom {
    from { transform: scale(1.0); }
    to   { transform: scale(1.07); }
}
.res-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
        to top,
        rgba(26,10,10,0.92) 0%,
        rgba(139,44,44,0.25) 45%,
        rgba(0,0,0,0.1) 100%
    );
}
.res-hero-content {
    position: relative; z-index: 2;
    width: 100%; max-width: 1100px;
    margin: 0 auto;
    padding: 0 60px 64px;
}
.res-hero-tag {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.22);
    backdrop-filter: blur(8px);
    padding: 6px 18px; border-radius: 30px;
    font-size: .65rem; letter-spacing: .18em;
    text-transform: uppercase; color: rgba(255,255,255,0.85);
    font-weight: 700; margin-bottom: 20px;
}
.res-hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5.5vw, 4.5rem);
    color: #fff;
    font-weight: 400;
    line-height: 1.08;
    margin-bottom: 18px;
    letter-spacing: -.02em;
}
.res-hero-title em { font-style: italic; color: var(--cream); }
.res-hero-resume {
    font-size: .9rem;
    color: rgba(255,255,255,0.72);
    max-width: 580px;
    line-height: 1.75;
    margin-bottom: 28px;
}
.res-hero-meta {
    display: flex; gap: 20px; flex-wrap: wrap;
}
.res-meta-pill {
    display: flex; align-items: center; gap: 7px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.18);
    backdrop-filter: blur(6px);
    padding: 7px 16px; border-radius: 30px;
    font-size: .75rem; color: rgba(255,255,255,0.85);
}
.res-meta-pill i { color: var(--cream); font-size: .8rem; }
.res-meta-pill strong { color: #fff; }

/* ── Vague de séparation ── */
.hero-wave {
    position: absolute; bottom: -1px;
    left: 0; right: 0;
    line-height: 0;
}
.hero-wave svg { display: block; width: 100%; }

/* ═══ BODY ═══ */
.res-body {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px 100px;
}

/* ═══ SECTION LABEL ═══ */
.section-divider {
    display: flex; align-items: center; gap: 16px;
    margin: 70px 0 44px;
}
.section-divider::before, .section-divider::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(to right, transparent, var(--bordeaux), transparent); /* ++ Ligne bordeaux */
}
.section-divider span {
    font-size: .62rem; letter-spacing: .22em;
    text-transform: uppercase; color: var(--bordeaux);
    font-weight: 700; white-space: nowrap;
    display: flex; align-items: center; gap: 8px;
}

/* ═══ JOUR CARD ═══ */
.jour-wrap { margin-bottom: 80px; }

.jour-head {
    display: flex; align-items: flex-start; gap: 28px;
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--bordeaux-lt);
}
.jour-num-big {
    font-family: 'Cinzel', serif;
    font-size: 5rem;
    color: var(--bordeaux); /* ++ Numéro géant en bordeaux */
    line-height: 0.85;
    letter-spacing: -.05em;
    flex-shrink: 0;
    margin-top: 8px;
    opacity: 0.9;
}
.jour-day-label {
    font-size: .62rem; letter-spacing: .2em;
    text-transform: uppercase; color: var(--bordeaux);
    font-weight: 700; margin-bottom: 8px;
    display: flex; align-items: center; gap: 8px;
}
.jour-day-label::after {
    content: ''; display: block;
    width: 30px; height: 2px;
    background: var(--bordeaux); 
    border-radius: 2px;
}
.jour-titre {
    font-family: 'Playfair Display', serif;
    font-size: 1.9rem; color: var(--dark);
    font-weight: 600; line-height: 1.2;
}

/* 3 moments en grille */
.moments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 20px;
}
.moment-card {
    background: var(--white);
    border: 1px solid var(--border-cream);
    border-radius: 12px;
    overflow: hidden;
    transition: transform .3s, box-shadow .3s, border-color .3s;
    box-shadow: var(--shadow-sm);
    /* Touche bordeaux */
    border-top: 3px solid transparent; 
}
.moment-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-top: 3px solid var(--bordeaux); /* ++ Liseré bordeaux au hover */
}
.moment-img {
    width: 100%; height: 195px;
    object-fit: cover; display: block;
    transition: transform .5s ease;
}
.moment-card:hover .moment-img { transform: scale(1.04); }
.moment-img-wrap { overflow: hidden; }

.moment-body { padding: 18px 18px 20px; }
.moment-time {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--bordeaux); /* ++ Fond Bordeaux */
    color: var(--white);         /* ++ Texte Blanc */
    font-size: .6rem; letter-spacing: .14em;
    text-transform: uppercase; font-weight: 700;
    padding: 4px 10px; border-radius: 20px;
    margin-bottom: 10px;
}
.moment-time i { font-size: .65rem; }
.moment-activite {
    font-family: 'Playfair Display', serif;
    font-size: 1rem; color: var(--dark);
    font-weight: 600; margin-bottom: 8px;
    line-height: 1.3;
}
.moment-desc {
    font-size: .76rem; color: var(--text-muted);
    line-height: 1.6;
}

/* Footer du jour */
.jour-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}
.jour-info {
    background: var(--white);
    border: 1px solid var(--border-cream);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex; align-items: flex-start; gap: 12px;
    border-left: 4px solid var(--bordeaux); /* Bordure rouge ++ */
}
.jour-info-icon {
    width: 32px; height: 32px;
    background: var(--bordeaux); /* ++ Icône fond rouge */
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: var(--white); font-size: .75rem;
}
.jour-info-lbl {
    font-size: .55rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--gold);
    font-weight: 700; margin-bottom: 2px;
}
.jour-info-val { font-size: .75rem; color: var(--dark); line-height: 1.3; font-weight: 600; }

/* Séparateur entre jours */
.jour-sep {
    height: 1px;
    background: linear-gradient(to right, transparent, var(--bordeaux-lt), transparent);
    margin: 50px 0;
}

/* ═══ CONSEILS ═══ */
.conseils-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
}
.conseil-card {
    background: var(--white);
    border: 1px solid var(--border-cream);
    border-left: 3px solid var(--bordeaux); /* Red touch */
    border-radius: 12px;
    padding: 18px 20px;
    display: flex; gap: 14px;
    box-shadow: var(--shadow-sm);
}
.conseil-ico {
    width: 30px; height: 30px;
    background: var(--bordeaux); /* Red touch */
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: var(--white); font-size: .8rem;
}
.conseil-txt { font-size: .8rem; color: var(--text-mid); line-height: 1.5; }

/* ═══ PÉRIODE ═══ */
.periode-card {
    background: var(--white);
    border: 1px solid var(--border-cream);
    border-radius: 14px;
    padding: 22px 28px;
    display: flex; align-items: center; gap: 20px;
    margin-top: 32px;
    box-shadow: var(--shadow-sm);
    border-left: 4px solid var(--bordeaux); /* ++ Rouge au lieu de or */
}
.periode-lbl {
    font-size: .6rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--bordeaux);
    font-weight: 700; margin-bottom: 4px;
}
.periode-val { font-size: .9rem; color: var(--dark); font-weight: 600; }

/* ═══ CTA SECTION (Beaucoup Plus Fin et Horizontal) ═══ */
.cta-section {
    margin-top: 60px;
    background: linear-gradient(135deg, var(--bordeaux-dk) 0%, var(--bordeaux) 100%);
    border-radius: 16px;
    padding: 35px 45px; /* Beaucoup plus fin */
    position: relative;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(139,44,44,0.3); /* Aura rouge */
}
.cta-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
        repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 40px);
}
.cta-inner { 
    position: relative; 
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}
.cta-text {
    flex: 1;
    text-align: left;
}
.cta-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.22);
    padding: 6px 14px; border-radius: 30px;
    font-size: .58rem; letter-spacing: .18em;
    text-transform: uppercase; color: rgba(255,255,255,0.9);
    font-weight: 700; margin-bottom: 12px;
}
.cta-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem; color: #fff;
    font-weight: 400; margin-bottom: 8px;
    line-height: 1.25;
}
.cta-title em { font-style: italic; color: var(--cream); }
.cta-sub {
    font-size: .85rem; color: rgba(255,255,255,0.75);
    max-width: 480px; margin: 0;
    line-height: 1.6;
}
.cta-buttons { 
    display: flex; 
    align-items: center; 
    gap: 14px; 
    flex-shrink: 0;
}
.btn-send {
    display: inline-flex; align-items: center; gap: 10px;
    background: #fff;
    color: var(--bordeaux);
    padding: 14px 30px;
    border-radius: 8px; border: none;
    font-family: 'Cinzel', serif;
    font-size: .85rem; font-weight: 700;
    cursor: pointer; transition: all .3s;
    letter-spacing: .1em;
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
}
.btn-send:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.3);
    background: var(--cream);
}
.btn-send i { font-size: 1rem; color: var(--bordeaux); }
.btn-redo {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    padding: 12px 20px;
    border-radius: 8px; font-family: 'Montserrat', sans-serif;
    font-size: .8rem; cursor: pointer;
    text-decoration: none; transition: all .3s;
}
.btn-redo:hover { border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.2); }

/* Toast */
.dm-toast {
    position: fixed;
    bottom: 30px; right: 30px; z-index: 9999;
    background: var(--white);
    border-left: 4px solid var(--bordeaux); /* Red touch here too */
    padding: 16px 22px;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(139,44,44,.15);
    font-family: 'Montserrat', sans-serif;
    display: flex; align-items: flex-start; gap: 12px;
    max-width: 360px;
    transform: translateY(120px); opacity: 0;
    transition: all .45s cubic-bezier(.23,1,.32,1);
}
.dm-toast.show { transform: translateY(0); opacity: 1; }
.dm-toast i { color: var(--bordeaux); font-size: 1.3rem; flex-shrink: 0; margin-top: 2px; }
.dm-toast strong { display: block; color: var(--dark); margin-bottom: 2px; }
.dm-toast span { font-size: .78rem; color: var(--text-muted); }

/* Responsive */
@media (max-width: 860px) {
    .res-hero-content { padding: 0 24px 40px; }
    .res-body { padding: 0 20px 60px; }
    .moments-grid { grid-template-columns: 1fr; }
    .jour-footer { grid-template-columns: 1fr; }
    .cta-inner { flex-direction: column; text-align: center; }
    .cta-text { text-align: center; margin-right: 0; margin-bottom: 20px; }
    .cta-buttons { flex-direction: column; width: 100%; }
    .cta-buttons > * { width: 100%; justify-content: center; }
    .jour-head { flex-direction: column; gap: 8px; }
    .jour-num-big { font-size: 3.5rem; }
}
</style>
{% endblock %}

{% block body %}
<div class="resultat-page">

    <!-- ═══ HERO ═══ -->
    <div class="res-hero">
        {% set heroImg = plan.jours[0].matin.image_url ?? 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1400&q=80' %}
        <div class="res-hero-img" style="background-image:url('{{ heroImg }}')"></div>
        <div class="res-hero-overlay"></div>

        <div class="res-hero-content">
            <div class="res-hero-tag">
                <i class="fas fa-magic"></i> Plan généré par IA · Doura Mondo
            </div>
            <h1 class="res-hero-title">
                {{ plan.destination }}<br>
                {% if plan.pays is defined and plan.pays != plan.destination %}
                    <em>{{ plan.pays }}</em>
                {% else %}
                    <em>{{ plan.theme }}</em>
                {% endif %}
            </h1>
            <p class="res-hero-resume">{{ plan.resume }}</p>
            <div class="res-hero-meta">
                <div class="res-meta-pill"><i class="fas fa-calendar-alt"></i> <strong>{{ plan.duree }} jours</strong></div>
                <div class="res-meta-pill"><i class="fas fa-users"></i> <strong>{{ plan.nb_personnes }} personne{{ plan.nb_personnes > 1 ? 's' : '' }}</strong></div>
                <div class="res-meta-pill"><i class="fas fa-wallet"></i> <strong>{{ plan.budget_total }}</strong> · {{ plan.budget_par_personne }}/pers.</div>
                <div class="res-meta-pill"><i class="fas fa-compass"></i> <strong>{{ plan.theme }}</strong></div>
                <div class="res-meta-pill"><i class="fas fa-hotel"></i> <strong>{{ plan.style_hebergement }}</strong></div>
            </div>
        </div>

        <!-- Vague -->
        <div class="hero-wave">
            <svg viewBox="0 0 1440 70" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M0,40 C360,80 1080,0 1440,40 L1440,70 L0,70 Z" fill="#F9F5ED"/>
            </svg>
        </div>
    </div>

    <!-- ═══ BODY ═══ -->
    <div class="res-body">

        <div class="section-divider"><span><i class="fas fa-route"></i> Votre Itinéraire Personnalisé</span></div>

        <!-- ═══ JOURS ═══ -->
        {% for jour in plan.jours %}
        <div class="jour-wrap">

            <div class="jour-head">
                <div class="jour-num-big">{{ '%02d'|format(jour.jour) }}</div>
                <div class="jour-head-right">
                    <div class="jour-day-label">Jour {{ jour.jour }}</div>
                    <h2 class="jour-titre">{{ jour.titre }}</h2>
                </div>
            </div>

            <!-- 3 moments -->
            <div class="moments-grid">

                <!-- Matin -->
                <div class="moment-card">
                    <div class="moment-img-wrap">
                        <img class="moment-img"
                             src="{{ jour.matin.image_url ?? 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=600&q=80' }}"
                             alt="{{ jour.matin.activite }}" loading="lazy">
                    </div>
                    <div class="moment-body">
                        <span class="moment-time"><i class="fas fa-sun"></i> Matin</span>
                        <div class="moment-activite">{{ jour.matin.activite }}</div>
                        <div class="moment-desc">{{ jour.matin.description }}</div>
                    </div>
                </div>

                <!-- Après-midi -->
                <div class="moment-card">
                    <div class="moment-img-wrap">
                        <img class="moment-img"
                             src="{{ jour.apres_midi.image_url ?? 'https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=600&q=80' }}"
                             alt="{{ jour.apres_midi.activite }}" loading="lazy">
                    </div>
                    <div class="moment-body">
                        <span class="moment-time"><i class="fas fa-cloud-sun"></i> Après-midi</span>
                        <div class="moment-activite">{{ jour.apres_midi.activite }}</div>
                        <div class="moment-desc">{{ jour.apres_midi.description }}</div>
                    </div>
                </div>

                <!-- Soir -->
                <div class="moment-card">
                    <div class="moment-img-wrap">
                        <img class="moment-img"
                             src="{{ jour.soir.image_url ?? 'https://images.unsplash.com/photo-1414609245224-aea2e95fe300?w=600&q=80' }}"
                             alt="{{ jour.soir.activite }}" loading="lazy">
                    </div>
                    <div class="moment-body">
                        <span class="moment-time"><i class="fas fa-moon"></i> Soir</span>
                        <div class="moment-activite">{{ jour.soir.activite }}</div>
                        <div class="moment-desc">{{ jour.soir.description }}</div>
                    </div>
                </div>
            </div>

            <!-- Footer jour -->
            <div class="jour-footer">
                <div class="jour-info">
                    <div class="jour-info-icon"><i class="fas fa-bed"></i></div>
                    <div>
                        <div class="jour-info-lbl">Hébergement</div>
                        <div class="jour-info-val">{{ jour.hebergement }}</div>
                    </div>
                </div>
                <div class="jour-info">
                    <div class="jour-info-icon"><i class="fas fa-euro-sign"></i></div>
                    <div>
                        <div class="jour-info-lbl">Budget du jour</div>
                        <div class="jour-info-val">{{ jour.budget_jour }}</div>
                    </div>
                </div>
                <div class="jour-info">
                    <div class="jour-info-icon"><i class="fas fa-lightbulb"></i></div>
                    <div>
                        <div class="jour-info-lbl">Conseil du jour</div>
                        <div class="jour-info-val">{{ jour.conseil }}</div>
                    </div>
                </div>
            </div>
        </div>

        {% if not loop.last %}<div class="jour-sep"></div>{% endif %}
        {% endfor %}

        <!-- Conseils généraux -->
        {% if plan.conseils_generaux is defined and plan.conseils_generaux %}
        <div class="section-divider"><span><i class="fas fa-star"></i> Conseils Pratiques</span></div>
        <div class="conseils-grid">
            {% for conseil in plan.conseils_generaux %}
            <div class="conseil-card">
                <div class="conseil-ico"><i class="fas fa-check"></i></div>
                <div class="conseil-txt">{{ conseil }}</div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Meilleure période -->
        {% if plan.meilleure_periode is defined %}
        <div class="periode-card">
            <span style="font-size:1.6rem;">🗓️</span>
            <div>
                <div class="periode-lbl">Meilleure période pour visiter</div>
                <div class="periode-val">{{ plan.meilleure_periode }}</div>
            </div>
        </div>
        {% endif %}

        <!-- CTA -->
        <div class="cta-section">
            <div class="cta-inner">
                <div class="cta-text">
                    <div class="cta-badge"><i class="fas fa-heart"></i> Votre voyage de rêve</div>
                    <h2 class="cta-title">Ce plan vous <em>fait rêver ?</em></h2>
                    <p class="cta-sub">
                        Envoyez cette proposition : nos experts vous contacteront pour affiner chaque détail.
                    </p>
                </div>
                <div class="cta-buttons">
                    <button class="btn-send" id="btnSend">
                        <i class="fas fa-paper-plane"></i>
                        Envoyer ma demande
                    </button>
                    <a href="{{ path('app_planifier') }}" class="btn-redo">
                        <i class="fas fa-redo"></i> Refaire
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

{# Formulaire caché - soumis par le bouton #}
<form id="formEnvoyer" method="POST" action="{{ path('app_planifier_envoyer') }}" style="display:none;"></form>

<!-- Overlay succès -->
<div id="successOverlay" style="
    display: none;
    position: fixed; inset: 0; z-index: 99999;
    background: rgba(26,10,10,0.85);
    backdrop-filter: blur(6px);
    align-items: center; justify-content: center;
">
    <div style="
        background: #fff;
        border-radius: 24px;
        padding: 56px 48px;
        text-align: center;
        max-width: 480px;
        width: 90%;
        box-shadow: 0 40px 80px rgba(0,0,0,0.3);
        animation: popIn .4s cubic-bezier(.23,1,.32,1) both;
    ">
        <!-- Icône animée -->
        <div style="
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #8B2C2C, #6B1F1F);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 24px;
            box-shadow: 0 8px 30px rgba(139,44,44,0.35);
        ">
            <i class="fas fa-check" style="color:#fff; font-size:2rem;"></i>
        </div>

        <div style="
            font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
            color: #9B7240; font-family: Arial, sans-serif; font-weight: 700;
            margin-bottom: 12px;
        ">Doura Mondo</div>

        <h2 style="
            font-family: 'Playfair Display', serif;
            font-size: 1.9rem; color: #1a1a2e;
            font-weight: 600; margin-bottom: 16px;
            line-height: 1.25;
        ">Demande envoyée <em style="font-style:italic; color:#8B2C2C;">avec succès !</em></h2>

        <p style="
            font-family: 'Montserrat', sans-serif;
            font-size: .9rem; color: #4a4a5a;
            line-height: 1.75; margin-bottom: 32px;
        ">
            Nos experts locaux ont bien reçu votre plan personnalisé.<br>
            Ils vous contacteront très prochainement pour finaliser<br>
            votre voyage sur mesure. ✈️
        </p>

        <!-- Barre de progression -->
        <div style="
            height: 4px; background: #EDE3D0;
            border-radius: 4px; overflow: hidden;
            margin-bottom: 16px;
        ">
            <div id="progressBar" style="
                height: 100%;
                background: linear-gradient(90deg, #8B2C2C, #C4A882);
                border-radius: 4px;
                width: 0%;
                transition: width 3s linear;
            "></div>
        </div>
        <p style="font-family:'Montserrat',sans-serif; font-size:.75rem; color:#888899;">
            Redirection vers l'accueil dans 3 secondes…
        </p>
    </div>
</div>

<style>
@keyframes popIn {
    from { transform: scale(.85); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
}
</style>

<script>
document.getElementById('btnSend')?.addEventListener('click', function() {
    this.disabled = true;
    this.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Envoi en cours…';
    this.style.opacity = '0.8';

    // Soumettre le formulaire via fetch pour garder la page visible
    fetch("{{ path('app_planifier_envoyer') }}", {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    }).then(() => {
        // Afficher l'overlay succès
        const overlay = document.getElementById('successOverlay');
        overlay.style.display = 'flex';
        // Lancer la barre de progression
        setTimeout(() => {
            document.getElementById('progressBar').style.width = '100%';
        }, 50);
        // Rediriger après 3 secondes
        setTimeout(() => {
            window.location.href = "{{ path('app_accueil') }}";
        }, 3000);
    }).catch(() => {
        this.disabled = false;
        this.innerHTML = '<i class="fas fa-paper-plane"></i> Envoyer ma demande';
        this.style.opacity = '1';
        alert('Une erreur est survenue. Veuillez réessayer.');
    });
});
</script>
{% endblock %}
