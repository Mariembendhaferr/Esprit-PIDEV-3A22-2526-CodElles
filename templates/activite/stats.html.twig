{% extends 'admin/base-admin.html.twig' %}
{% block title %}Statistiques – Doura Mondo{% endblock %}

{% block admin_content %}

<div class="page-header">
    <div>
        <h1>Statistiques des Activités</h1>
        <p>Vue d'ensemble du module Gestion des Activités</p>
    </div>
    <div class="page-header-right">
        <a href="{{ path('app_activite_index') }}" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Retour
        </a>
    </div>
</div>
<div class="gold-line"></div>

{# ── Stat Cards ── #}
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px;">

    <div style="background:linear-gradient(135deg,#8B0000,#C0392B); color:white; border-radius:14px; padding:22px; position:relative; overflow:hidden; box-shadow:0 4px 16px rgba(139,0,0,0.3);">
        <i class="fa-solid fa-map-location-dot" style="position:absolute; right:16px; top:50%; transform:translateY(-50%); font-size:44px; opacity:0.2;"></i>
        <div style="font-size:36px; font-weight:800;">{{ stats.total }}</div>
        <div style="font-size:12px; opacity:0.85; margin-top:4px; text-transform:uppercase; letter-spacing:1px;">Total Activités</div>
    </div>

    <div style="background:linear-gradient(135deg,#1B5E20,#43A047); color:white; border-radius:14px; padding:22px; position:relative; overflow:hidden; box-shadow:0 4px 16px rgba(27,94,32,0.3);">
        <i class="fa-solid fa-circle-check" style="position:absolute; right:16px; top:50%; transform:translateY(-50%); font-size:44px; opacity:0.2;"></i>
        <div style="font-size:36px; font-weight:800;">{{ stats.disponibles }}</div>
        <div style="font-size:12px; opacity:0.85; margin-top:4px; text-transform:uppercase; letter-spacing:1px;">Disponibles</div>
    </div>

    <div style="background:linear-gradient(135deg,#C9A84C,#E67E22); color:white; border-radius:14px; padding:22px; position:relative; overflow:hidden; box-shadow:0 4px 16px rgba(201,168,76,0.3);">
        <i class="fa-solid fa-coins" style="position:absolute; right:16px; top:50%; transform:translateY(-50%); font-size:44px; opacity:0.2;"></i>
        <div style="font-size:36px; font-weight:800;">{{ stats.prixMoyen|number_format(0) }}</div>
        <div style="font-size:12px; opacity:0.85; margin-top:4px; text-transform:uppercase; letter-spacing:1px;">Prix Moyen (DT)</div>
    </div>

    <div style="background:linear-gradient(135deg,#4A148C,#7B1FA2); color:white; border-radius:14px; padding:22px; position:relative; overflow:hidden; box-shadow:0 4px 16px rgba(74,20,140,0.3);">
        <i class="fa-solid fa-building" style="position:absolute; right:16px; top:50%; transform:translateY(-50%); font-size:44px; opacity:0.2;"></i>
        <div style="font-size:36px; font-weight:800;">{{ stats.totalFournisseurs }}</div>
        <div style="font-size:12px; opacity:0.85; margin-top:4px; text-transform:uppercase; letter-spacing:1px;">Fournisseurs</div>
    </div>

</div>

{# ── Charts ── #}
<div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:24px;">

    <div style="background:white; border-radius:16px; box-shadow:0 4px 24px rgba(139,0,0,0.07); overflow:hidden;">
        <div style="background:linear-gradient(135deg,#3D0000,#8B0000); padding:14px 20px; color:white; font-weight:700; font-size:14px; display:flex; align-items:center; gap:8px;">
            <i class="fa-solid fa-chart-bar"></i> Activités par Catégorie
        </div>
        <div style="padding:20px;"><canvas id="catChart" height="220"></canvas></div>
    </div>

    <div style="background:white; border-radius:16px; box-shadow:0 4px 24px rgba(139,0,0,0.07); overflow:hidden;">
        <div style="background:linear-gradient(135deg,#3D0000,#8B0000); padding:14px 20px; color:white; font-weight:700; font-size:14px; display:flex; align-items:center; gap:8px;">
            <i class="fa-solid fa-chart-pie"></i> Disponibilité
        </div>
        <div style="padding:20px; display:flex; align-items:center; justify-content:center;"><canvas id="dispoChart" height="220"></canvas></div>
    </div>

</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">

    <div style="background:white; border-radius:16px; box-shadow:0 4px 24px rgba(139,0,0,0.07); overflow:hidden;">
        <div style="background:linear-gradient(135deg,#3D0000,#8B0000); padding:14px 20px; color:white; font-weight:700; font-size:14px; display:flex; align-items:center; gap:8px;">
            <i class="fa-solid fa-chart-line"></i> Statuts d'assignation
        </div>
        <div style="padding:20px;"><canvas id="statutChart" height="220"></canvas></div>
    </div>

    {# ── Top activités les plus chères ── #}
    <div style="background:white; border-radius:16px; box-shadow:0 4px 24px rgba(139,0,0,0.07); overflow:hidden;">
        <div style="background:linear-gradient(135deg,#3D0000,#8B0000); padding:14px 20px; color:white; font-weight:700; font-size:14px; display:flex; align-items:center; gap:8px;">
            <i class="fa-solid fa-trophy"></i> Top 5 — Activités les plus chères
        </div>
        <div>
            {% for a in stats.topActivites %}
                <div style="padding:12px 20px; border-bottom:1px solid #F8F0EC; display:flex; align-items:center; justify-content:space-between;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div style="width:28px; height:28px; background:{% if loop.index == 1 %}#C9A84C{% elseif loop.index == 2 %}#9E9E9E{% elseif loop.index == 3 %}#CD7F32{% else %}#F2E8D9{% endif %}; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; color:{% if loop.index <= 3 %}white{% else %}#8B0000{% endif %};">
                            {{ loop.index }}
                        </div>
                        <div>
                            <a href="{{ path('app_activite_stats', {'id': a.id}) }}" style="font-weight:700; color:#2A1010; font-size:13px; text-decoration:none;">{{ a.nomActivite }}</a>
                            <p style="margin:2px 0 0; font-size:11px; color:#999;">{{ a.categorieActivite }}</p>
                        </div>
                    </div>
                    <span style="font-weight:800; color:#8B0000; font-size:14px;">{{ a.coutActivite }} DT</span>
                </div>
            {% endfor %}
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Catégorie bar chart
const catLabels = {{ catLabels|json_encode|raw }};
const catVals   = {{ catVals|json_encode|raw }};
new Chart(document.getElementById('catChart'), {
    type: 'bar',
    data: {
        labels: catLabels,
        datasets: [{ label: 'Activités', data: catVals,
            backgroundColor: ['#8B0000','#C0392B','#C9A84C','#E67E22','#1B5E20','#4A148C','#0D47A1','#37474F'],
            borderRadius: 8 }]
    },
    options: { responsive:true, plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true, ticks:{ stepSize:1 } } } }
});

// Disponibilité doughnut
new Chart(document.getElementById('dispoChart'), {
    type: 'doughnut',
    data: {
        labels: ['Disponibles', 'Indisponibles'],
        datasets: [{ data: [{{ stats.disponibles }}, {{ stats.total - stats.disponibles }}],
            backgroundColor: ['#43A047','#C62828'], borderWidth:0 }]
    },
    options: { responsive:true, cutout:'70%', plugins:{ legend:{ position:'bottom' } } }
});

// Statuts bar
new Chart(document.getElementById('statutChart'), {
    type: 'bar',
    data: {
        labels: ['En attente', 'Acceptées', 'Refusées'],
        datasets: [{ data: [{{ stats.enAttente }}, {{ stats.acceptees }}, {{ stats.refusees }}],
            backgroundColor: ['#FFA000','#43A047','#C62828'], borderRadius:8 }]
    },
    options: { responsive:true, plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true, ticks:{ stepSize:1 } } } }
});
</script>

{% endblock %}
