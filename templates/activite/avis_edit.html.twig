{% extends 'base.html.twig' %}

{% block title %}Modifier mon avis — {{ activite.nomActivite }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/activites-public.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<main class="activite-page activite-page--detail">
    <div class="container py-5">
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger activite-alert mb-4" role="alert">{{ message }}</div>
        {% endfor %}

        <nav class="activite-breadcrumb mb-4" aria-label="Fil d’Ariane">
            <a href="{{ path('app_activite_show', { id: activite.id }) }}" class="activite-back-link">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour à l’activité
            </a>
        </nav>

        <header class="mb-4">
            <p class="activite-detail-cat text-muted small mb-2">{{ activite.categorieActivite }}</p>
            <h1 class="activite-detail-title h3">Modifier votre avis</h1>
            <p class="text-muted small mb-0">{{ activite.nomActivite }} · {{ avis.user.prenom }} {{ avis.user.nom }}</p>
        </header>

        <div class="activite-avis-form-panel activite-avis-form-panel--standalone">
            {{ form_start(form, { attr: { class: 'activite-avis-form', novalidate: 'novalidate' } }) }}
                {{ form_errors(form) }}
                <div class="mb-3 activite-star-field">
                    {{ form_label(form.note) }}
                    <div class="activite-star-rating" id="avis-star-rating-edit" data-star-rating>
                        {% for child in form.note %}
                            {{ form_widget(child, { attr: { class: 'activite-star-input', 'data-index': loop.index0 } }) }}
                            <label for="{{ child.vars.id }}" class="activite-star-face {% if child.vars.value is empty %}activite-star-face--empty{% endif %}" title="{{ child.vars.label|e('html_attr') }}">
                                {% if child.vars.value is empty %}
                                    <span class="activite-star-no">Sans note</span>
                                {% else %}
                                    <i class="fas fa-star" aria-hidden="true" data-star-n="{{ child.vars.value }}"></i>
                                {% endif %}
                            </label>
                        {% endfor %}
                    </div>
                    <p class="activite-star-hint mb-0">Choisissez une note en étoiles ou « Sans note ».</p>
                    {{ form_errors(form.note) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.commentaire) }}
                    {{ form_widget(form.commentaire) }}
                    {{ form_errors(form.commentaire) }}
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary activite-submit">Enregistrer les modifications</button>
                    <a href="{{ path('app_activite_show', { id: activite.id }) }}" class="btn btn-outline-secondary activite-submit activite-submit--ghost">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var root = document.getElementById('avis-star-rating-edit');
            if (!root) return;
            function paint() {
                var checked = root.querySelector('input[type="radio"]:checked');
                var val = 0;
                if (checked) {
                    var v = checked.value;
                    val = v === '' ? 0 : parseInt(v, 10);
                    if (isNaN(val)) val = 0;
                }
                root.querySelectorAll('.activite-star-face i.fa-star').forEach(function (icon) {
                    var n = parseInt(icon.getAttribute('data-star-n'), 10);
                    var on = val > 0 && n <= val;
                    icon.style.opacity = on ? '1' : '0.3';
                    icon.style.color = on ? '#c4a574' : '#a89888';
                });
            }
            root.querySelectorAll('input[type="radio"]').forEach(function (inp) {
                inp.addEventListener('change', paint);
            });
            paint();
        })();
    </script>
{% endblock %}
