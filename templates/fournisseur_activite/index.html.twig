{% extends 'admin/base_admin.html.twig' %}
{% block title %}Fournisseurs – Doura Mondo{% endblock %}

{% block admin_content %}

<div class="page-header">
    <div>
        <h1>Gestion des Fournisseurs</h1>
        <p>{{ total }} fournisseurs enregistrés</p>
    </div>
    <div class="page-header-right">
        <a href="{{ path('app_fournisseur_activite_new') }}" class="btn-primary">
            <i class="fa-solid fa-plus"></i> Nouveau Fournisseur
        </a>
    </div>
</div>

<div class="gold-line"></div>

<form method="GET" action="{{ path('app_fournisseur_activite_index') }}" id="ff">
    <div class="toolbar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" value="{{ search|default('') }}" placeholder="Rechercher un fournisseur...">
            {% if search|default('') %}
                <a href="{{ path('app_fournisseur_activite_index') }}" class="search-clear"><i class="fa-solid fa-xmark"></i></a>
            {% endif %}
        </div>

        <div class="filter-wrap">
            <i class="fa-solid fa-layer-group"></i>
            <select name="specialite" class="filter-select" onchange="document.getElementById('ff').submit()">
                <option value="">Toutes spécialités</option>
                {% for s in ['Nature & Aventure','Sports Extrêmes','Culture & Histoire','Gastronomie','Art & Musées','Loisirs & Détente','Multi-activités'] %}
                    <option value="{{ s }}" {% if s == specialite|default('') %}selected{% endif %}>{{ s }}</option>
                {% endfor %}
            </select>
        </div>

        {% if search|default('') or specialite|default('') %}
            <a href="{{ path('app_fournisseur_activite_index') }}" class="btn-outline" style="padding:9px 14px; font-size:12px;">
                <i class="fa-solid fa-xmark"></i> Reset
            </a>
        {% endif %}

        <button type="submit" class="btn-primary" style="margin-left:auto;">
            <i class="fa-solid fa-filter"></i> Filtrer
        </button>
    </div>
</form>

<div class="table-card">
    <div class="table-card-header">
        <span><i class="fa-solid fa-building"></i> Liste des Fournisseurs</span>
        <small>{{ fournisseur_activites|length }} sur {{ total }} résultats</small>
    </div>
    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Adresse</th>
                <th>Spécialité</th>
                <th>Site Web</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for f in fournisseur_activites %}
            <tr>
                <td>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div style="width:34px; height:34px; background:linear-gradient(135deg,#8B0000,#C0392B); border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <i class="fa-solid fa-building" style="color:white; font-size:13px;"></i>
                        </div>
                        <span class="td-name">{{ f.nomFournisseur }}</span>
                    </div>
                </td>
                <td><i class="fa-solid fa-envelope" style="color:#C9A84C; margin-right:5px;"></i>{{ f.emailFournisseur }}</td>
                <td><i class="fa-solid fa-phone" style="color:#C9A84C; margin-right:5px;"></i>{{ f.telephoneFournisseur }}</td>
                <td>
                    {% if f.adresseFournisseur %}
                        <i class="fa-solid fa-location-dot" style="color:#8B0000; margin-right:5px;"></i>{{ f.adresseFournisseur }}
                    {% else %}—{% endif %}
                </td>
                <td>
                    {% if f.specialiteFournisseur %}
                        <span class="pill pill-spec">{{ f.specialiteFournisseur }}</span>
                    {% else %}—{% endif %}
                </td>
                <td>
                    {% if f.websiteFournisseur %}
                        <a href="{{ f.websiteFournisseur }}" target="_blank" class="link-website">
                            <i class="fa-solid fa-globe"></i> Visiter
                        </a>
                    {% else %}—{% endif %}
                </td>
                <td>
                    <div class="actions">
                        <a href="{{ path('app_fournisseur_activite_edit', {'id': f.id}) }}" class="act-btn act-edit" title="Modifier">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <form method="post" action="{{ path('app_fournisseur_activite_delete', {'id': f.id}) }}"
                              onsubmit="return confirm('Supprimer « {{ f.nomFournisseur }} » ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ f.id) }}">
                            <button type="submit" class="act-btn act-del" title="Supprimer">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">
                <div class="empty">
                    <i class="fa-solid fa-building"></i>
                    <p>Aucun fournisseur trouvé</p>
                </div>
            </td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# ── Pagination ── #}
{% if totalPages > 1 %}
<div class="pagination-wrap">
    <div class="pagination-info">
        Affichage page {{ currentPage }} sur {{ totalPages }} ({{ total }} résultats)
    </div>
    <div class="pagination">
        {% if currentPage > 1 %}
            <a href="{{ path('app_fournisseur_activite_index', {page: 1, search: search|default(''), specialite: specialite|default('')}) }}" class="paginator-btn" title="Première page">
                <i class="fa-solid fa-chevron-left"></i><i class="fa-solid fa-chevron-left"></i>
            </a>
            <a href="{{ path('app_fournisseur_activite_index', {page: currentPage - 1, search: search|default(''), specialite: specialite|default('')}) }}" class="paginator-btn" title="Page précédente">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
        {% endif %}

        {% for p in range(max(1, currentPage - 2), min(totalPages, currentPage + 2)) %}
            {% if p == currentPage %}
                <span class="paginator-btn paginator-active">{{ p }}</span>
            {% else %}
                <a href="{{ path('app_fournisseur_activite_index', {page: p, search: search|default(''), specialite: specialite|default('')}) }}" class="paginator-btn">{{ p }}</a>
            {% endif %}
        {% endfor %}

        {% if currentPage < totalPages %}
            <a href="{{ path('app_fournisseur_activite_index', {page: currentPage + 1, search: search|default(''), specialite: specialite|default('')}) }}" class="paginator-btn" title="Page suivante">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
            <a href="{{ path('app_fournisseur_activite_index', {page: totalPages, search: search|default(''), specialite: specialite|default('')}) }}" class="paginator-btn" title="Dernière page">
                <i class="fa-solid fa-chevron-right"></i><i class="fa-solid fa-chevron-right"></i>
            </a>
        {% endif %}
    </div>
</div>
{% endif %}

{% endblock %}
