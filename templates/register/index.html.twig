

{% block no_layout %}true{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --gold:      #C9A84C;
    --gold-light:#E8C97A;
    --crimson:   #7A0000;
    --deep:      #050000;
    --surface:   #0f0505;
    --text-main: #F2E6CC;
    --text-muted:rgba(242,230,204,0.45);
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }

html, body {
    min-height:100vh;
    font-family:'Outfit',sans-serif;
    background:var(--deep);
    overflow-x:hidden;
    overflow-y:auto; /* ✅ Allow vertical scrolling */
}

.sidebar{display:none !important;}
.main-content{margin:0 !important;padding:0 !important;width:100% !important;}

/* ── BACKGROUND ── */
.aurora{
    position:fixed;inset:0;z-index:0;
    background:
        radial-gradient(ellipse 70% 50% at 30% 30%,rgba(92,0,0,.28) 0%,transparent 70%),
        radial-gradient(ellipse 55% 45% at 75% 70%,rgba(201,168,76,.07) 0%,transparent 60%),
        radial-gradient(ellipse 80% 60% at 50% 50%,rgba(122,0,0,.14) 0%,transparent 65%),
        linear-gradient(160deg,#020000 0%,#090001 15%,#160004 30%,#260007 50%,#160003 70%,#090001 90%,#030000 100%);
}
.aurora-orb{position:fixed;border-radius:50%;filter:blur(85px);pointer-events:none;z-index:0;}
.aorb-1{width:480px;height:480px;background:radial-gradient(circle,rgba(122,0,0,.22),transparent 70%);top:-12%;left:-10%;animation:ao1 14s ease-in-out infinite;}
.aorb-2{width:380px;height:380px;background:radial-gradient(circle,rgba(201,168,76,.09),transparent 70%);bottom:-10%;right:-8%;animation:ao2 18s ease-in-out infinite;}
.aorb-3{width:280px;height:280px;background:radial-gradient(circle,rgba(80,0,0,.14),transparent 60%);top:42%;right:22%;animation:ao3 12s ease-in-out infinite;}
@keyframes ao1{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(55px,28px) scale(1.1)}66%{transform:translate(-28px,-38px) scale(.95)}}
@keyframes ao2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-45px,-28px) scale(1.12)}}
@keyframes ao3{0%,100%{transform:translate(0,0) scale(1);opacity:.6}50%{transform:translate(28px,-38px) scale(1.2);opacity:1}}

.mesh-layer{
    position:fixed;inset:0;z-index:0;
    background-image:linear-gradient(rgba(201,168,76,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(201,168,76,.02) 1px,transparent 1px);
    background-size:130px 130px;
    opacity:0;animation:mesh-fade 3s ease .5s forwards;
}
@keyframes mesh-fade{to{opacity:1}}

.noise-layer{
    position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.028;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size:190px;
}

.scanline{
    position:fixed;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,rgba(201,168,76,.05) 18%,rgba(201,168,76,.18) 50%,rgba(201,168,76,.05) 82%,transparent);
    animation:scan 6s linear infinite;pointer-events:none;z-index:2;
}
@keyframes scan{0%{top:-1px;opacity:0}4%{opacity:.8}96%{opacity:.2}100%{top:100vh;opacity:0}}

/* Particles */
.pfield{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden;}
.pdot{position:absolute;border-radius:50%;background:var(--gold);opacity:0;animation:pdot-rise linear infinite;}
@keyframes pdot-rise{0%{opacity:0}8%{opacity:.5}92%{opacity:.1}100%{opacity:0;transform:translateY(-115vh) translateX(18px)}}

/* Corner deco */
.cdeco{position:fixed;pointer-events:none;z-index:2;opacity:0;animation:cdeco-in 1.4s ease forwards;}
.cdeco--tl{top:18px;left:18px;animation-delay:.7s}.cdeco--tr{top:18px;right:18px;animation-delay:.9s}
.cdeco--bl{bottom:18px;left:18px;animation-delay:1.1s}.cdeco--br{bottom:18px;right:18px;animation-delay:1.3s}
.cdeco svg{display:block;}
@keyframes cdeco-in{from{opacity:0;transform:scale(.3)}to{opacity:1;transform:scale(1)}}

/* Cursor glow */
.cglow{position:fixed;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(201,168,76,.04) 0%,transparent 68%);pointer-events:none;z-index:1;transform:translate(-50%,-50%);opacity:0;transition:opacity .3s;}

/* ════════════════════════════════════
   PAGE WRAPPER
════════════════════════════════════ */
.page-wrap{
    position:relative;z-index:3;
    min-height:100vh;
    display:flex;align-items:flex-start; /* ✅ Changed from center to flex-start */
    justify-content:center;
    padding:2rem 1rem;
}

/* ════════════════════════════════════
   SPLIT CARD
════════════════════════════════════ */
.reg-card{
    display:flex;
    width:1020px;max-width:96vw;
    min-height:660px;
    border-radius:28px;overflow:hidden;
    box-shadow:0 0 0 1px rgba(201,168,76,.11),0 50px 110px rgba(0,0,0,.7),0 0 70px rgba(122,0,0,.13);
    opacity:0;animation:card-in 1s cubic-bezier(.22,1,.36,1) .2s forwards;
}
@keyframes card-in{from{opacity:0;transform:translateY(50px) scale(.95) rotateX(4deg)}to{opacity:1;transform:translateY(0) scale(1) rotateX(0)}}

/* ══ LEFT PANEL ══ */
.left{
    flex:0 0 340px;
    background:linear-gradient(150deg,#0c0202 0%,#1b0404 40%,#2a0000 70%,#380606 100%);
    padding:3rem 2.2rem;
    display:flex;flex-direction:column;justify-content:space-between;
    position:relative;overflow:hidden;color:white;
}
.left::before{
    content:'';position:absolute;inset:0;
    background-image:linear-gradient(rgba(201,168,76,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(201,168,76,.04) 1px,transparent 1px);
    background-size:55px 55px;animation:mdrift 20s linear infinite;
}
@keyframes mdrift{from{background-position:0 0,0 0}to{background-position:55px 55px,55px 55px}}
.left-orb{position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle at 36%,rgba(201,168,76,.1),rgba(122,0,0,.08) 40%,transparent 70%);top:-55px;right:-75px;animation:lorb 9s ease-in-out infinite;}
@keyframes lorb{0%,100%{transform:scale(1)}50%{transform:scale(1.08) rotate(10deg)}}
.left-ring{position:absolute;border-radius:50%;border:1px solid rgba(201,168,76,.08);animation:lring linear infinite;}
.lr-1{width:220px;height:220px;top:-50px;right:-55px;animation-duration:22s;}
.lr-2{width:330px;height:330px;top:-100px;right:-105px;animation-duration:36s;animation-direction:reverse;border-style:dashed;}
@keyframes lring{from{transform:rotate(0)}to{transform:rotate(360deg)}}

.l-brand{position:relative;z-index:1;}
.l-logo-ring{width:52px;height:52px;border-radius:50%;border:1.5px solid rgba(201,168,76,.28);display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:.8rem;background:rgba(201,168,76,.06);animation:lbob 5s ease-in-out infinite;}
@keyframes lbob{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.l-brand-name{font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold);}
.l-brand-sub{font-size:.76rem;color:var(--text-muted);letter-spacing:1px;margin-top:2px;}

.l-features{position:relative;z-index:1;display:flex;flex-direction:column;gap:.6rem;}
.l-feat{
    display:flex;align-items:center;gap:.7rem;
    padding:.62rem .9rem;
    background:rgba(255,255,255,.03);
    border:1px solid rgba(201,168,76,.09);
    border-radius:13px;
    opacity:0;transform:translateX(-20px);
    animation:lfeat-in .6s cubic-bezier(.22,1,.36,1) forwards;
    transition:background .3s,border-color .3s,transform .3s;
}
.l-feat:nth-child(1){animation-delay:1.1s}.l-feat:nth-child(2){animation-delay:1.3s}
.l-feat:nth-child(3){animation-delay:1.5s}.l-feat:nth-child(4){animation-delay:1.7s}
@keyframes lfeat-in{to{opacity:1;transform:translateX(0)}}
.l-feat:hover{background:rgba(201,168,76,.07);border-color:rgba(201,168,76,.24);transform:translateX(7px);}
.l-feat-ico{font-size:1.1rem;width:28px;height:28px;display:flex;align-items:center;justify-content:center;background:rgba(201,168,76,.08);border-radius:7px;transition:transform .3s cubic-bezier(.68,-.55,.265,1.55);}
.l-feat:hover .l-feat-ico{transform:scale(1.22) rotate(-8deg);}
.l-feat-txt{font-size:.8rem;color:rgba(255,255,255,.6);letter-spacing:.3px;}

.l-foot{position:relative;z-index:1;font-size:.66rem;color:rgba(255,255,255,.18);letter-spacing:.5px;}

/* ══ RIGHT PANEL ══ */
.right{
    flex:1;
    background:var(--surface);
    backdrop-filter:blur(18px);
    padding:2.4rem 2.8rem 2rem;
    display:flex;
    flex-direction:column;
    justify-content:flex-start; /* ✅ Changed from center to flex-start */
    position:relative;
    max-height:92vh;
    overflow-y:auto; /* ✅ Enable scrolling */
    scroll-behavior:smooth;
}
.right::before{
    content:'';position:absolute;top:0;left:0;right:0;height:2px;
    background:linear-gradient(90deg,transparent,var(--gold),rgba(122,0,0,.6),var(--gold),transparent);
    background-size:300% 100%;animation:sweep 4s linear infinite;
}
@keyframes sweep{0%{background-position:0% 0}100%{background-position:300% 0}}
.right::after{
    content:'';position:absolute;top:0;left:0;right:0;height:160px;
    background:linear-gradient(180deg,rgba(201,168,76,.025) 0%,transparent 100%);
    pointer-events:none;
}

/* Custom scrollbar for .right */
.right::-webkit-scrollbar{width:6px;}
.right::-webkit-scrollbar-track{background:rgba(0,0,0,0.2);border-radius:10px;}
.right::-webkit-scrollbar-thumb{background:rgba(201,168,76,0.3);border-radius:10px;}
.right::-webkit-scrollbar-thumb:hover{background:rgba(201,168,76,0.5);}

.r-head{text-align:center;margin-bottom:1.6rem;opacity:0;animation:fu .7s ease .5s both;}
.r-head-title{font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:700;color:var(--text-main);margin-bottom:.2rem;}
.r-head-sub{font-size:.78rem;color:rgba(201,168,76,.45);letter-spacing:1px;}

.alert-error{
    background:rgba(122,0,0,.14);border:1px solid rgba(255,80,80,.2);
    border-left:3px solid #FF5252;border-radius:10px;
    padding:.7rem 1rem;color:#FF8A80;font-size:.82rem;
    margin-bottom:1.2rem;animation:err-pop .4s cubic-bezier(.68,-.55,.265,1.55);
}
@keyframes err-pop{from{opacity:0;transform:scale(.95) translateY(-6px)}to{opacity:1;transform:scale(1) translateY(0)}}

/* Form grid */
.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:0.95rem;
    position:relative;
    z-index:1;
    padding-bottom:1rem;
}
.form-grid .full{grid-column:1 / -1;}

.fg{
    opacity:0;
    animation:fu .5s ease both;
    min-height:auto;
}
.fg:nth-child(1){animation-delay:.7s}.fg:nth-child(2){animation-delay:.8s}
.fg:nth-child(3){animation-delay:.9s}.fg:nth-child(4){animation-delay:1.0s}
.fg:nth-child(5){animation-delay:1.1s}.fg:nth-child(6){animation-delay:1.2s}
.fg:nth-child(7){animation-delay:1.3s}.fg:nth-child(8){animation-delay:1.4s}
.fg:nth-child(9){animation-delay:1.5s}.fg:nth-child(10){animation-delay:1.6s}
.fg:nth-child(11){animation-delay:1.7s}
@keyframes fu{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

.flabel{
    display:block;font-size:.65rem;font-weight:600;letter-spacing:1.8px;
    text-transform:uppercase;color:rgba(201,168,76,.5);
    margin-bottom:5px;padding-left:2px;transition:color .3s;
}
.fg:focus-within .flabel{color:rgba(201,168,76,.88);}

.finput-wrap{position:relative;}

.finput{
    width:100%;padding:.72rem .95rem;
    background:rgba(255,255,255,.04);
    border:1.5px solid rgba(201,168,76,.10);
    border-radius:12px;
    color:var(--text-main);font-size:.86rem;font-family:'Outfit',sans-serif;
    outline:none;transition:all .3s ease;
}
.finput::placeholder{color:rgba(201,168,76,.20);}
.finput:hover{background:rgba(255,255,255,.06);border-color:rgba(201,168,76,.20);}
.finput:focus{
    background:rgba(255,255,255,.07);border-color:rgba(201,168,76,.52);
    box-shadow:0 0 20px rgba(201,168,76,.09),inset 0 0 8px rgba(201,168,76,.03);
    transform:translateY(-1px);
}

.pw-toggle{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(201,168,76,.35);cursor:pointer;font-size:.9rem;padding:4px;transition:color .3s;}
.pw-toggle:hover{color:rgba(201,168,76,.7);}

.pw-bar{height:3px;border-radius:3px;margin-top:5px;background:rgba(255,255,255,.05);overflow:hidden;}
.pw-fill{height:100%;width:0;border-radius:3px;transition:width .4s,background .4s;}
.pw-fill.weak{width:33%;background:#ef4444}.pw-fill.medium{width:66%;background:#f59e0b}.pw-fill.strong{width:100%;background:#10b981}
.pw-txt{font-size:.65rem;margin-top:3px;transition:color .3s;}
.pw-txt.weak{color:#ef4444}.pw-txt.medium{color:#f59e0b}.pw-txt.strong{color:#10b981}

.field-error{font-size:.72rem;color:#FF7070;background:rgba(122,0,0,.11);border:1px solid rgba(122,0,0,.18);border-left:3px solid #FF5252;border-radius:6px;padding:5px 9px;margin-top:4px;animation:err-pop .4s cubic-bezier(.68,-.55,.265,1.55);}

/* Avatar */
.avatar-section{margin-top:.3rem;}
.avatar-section-title{font-size:.65rem;color:rgba(201,168,76,.5);font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px;}
.avatar-grid{display:flex;flex-wrap:wrap;gap:.45rem;}
.av-item{
    width:48px;height:48px;border-radius:50%;
    cursor:pointer;border:2.5px solid transparent;
    transition:all .3s cubic-bezier(.68,-.55,.265,1.55);
    background:rgba(255,255,255,.05);padding:3px;
    position:relative;overflow:visible;
}
.av-item img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;}
.av-item:hover{border-color:rgba(201,168,76,.5);transform:scale(1.16) rotate(5deg);box-shadow:0 4px 14px rgba(201,168,76,.18);}
.av-item.selected{border-color:var(--gold);transform:scale(1.10);box-shadow:0 0 18px rgba(201,168,76,.28);}
.av-item.selected::after{
    content:'✓';position:absolute;bottom:-2px;right:-2px;
    width:17px;height:17px;background:var(--gold);border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:.58rem;color:#1a0808;font-weight:800;
    animation:check-pop .4s cubic-bezier(.68,-.55,.265,1.55);
}
@keyframes check-pop{from{transform:scale(0)}to{transform:scale(1)}}

/* File upload */
.upload-area{
    position:relative;border:1.5px dashed rgba(201,168,76,.16);border-radius:12px;
    padding:.9rem;text-align:center;transition:all .3s;cursor:pointer;
    background:rgba(255,255,255,.02);
}
.upload-area:hover{border-color:rgba(201,168,76,.38);background:rgba(201,168,76,.04);}
.upload-area.dragover{border-color:rgba(201,168,76,.55);background:rgba(201,168,76,.07);transform:scale(1.01);}
.upload-icon{font-size:1.4rem;margin-bottom:.25rem;display:block;opacity:.45;}
.upload-txt{font-size:.75rem;color:rgba(201,168,76,.38);}
.upload-txt strong{color:rgba(201,168,76,.62);}
.upload-area input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;}
.file-name{font-size:.72rem;color:#10b981;margin-top:4px;}

/* ════════════════════════════════════
   TRAVEL CAPTCHA
════════════════════════════════════ */
.captcha-wrap{
    background:rgba(8,2,2,.72);
    border:1px solid rgba(201,168,76,.14);
    border-radius:14px;padding:1rem 1.1rem;
    text-align:center;position:relative;overflow:hidden;
    transition:border-color .4s,background .4s;
}
.captcha-wrap::before{
    content:'';position:absolute;top:0;left:0;right:0;height:2px;
    background:linear-gradient(90deg,transparent,rgba(201,168,76,.28),transparent);
    animation:cline 3s ease-in-out infinite;
}
@keyframes cline{0%,100%{opacity:.3}50%{opacity:.65}}
.captcha-label{font-size:.62rem;color:rgba(201,168,76,.38);font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:.4rem;}
#cap-instruction{font-size:.82rem;font-weight:700;color:var(--text-main);margin-bottom:7px;min-height:18px;transition:color .3s;}
#cap-status{font-size:.66rem;color:rgba(201,168,76,.32);margin-top:5px;min-height:14px;transition:color .3s;}
#cap-map{
    position:relative;width:100%;padding-bottom:54%;
    border-radius:10px;overflow:hidden;
    background:linear-gradient(to bottom,#060710,#0c1120,#070813);
    border:1px solid rgba(201,168,76,.09);touch-action:none;
}
#cap-map-inner{position:absolute;inset:0;}
#cap-map-inner svg{width:100%;height:100%;}
#cap-plane{
    position:absolute;width:36px;height:36px;
    font-size:22px;display:flex;align-items:center;justify-content:center;
    cursor:grab;z-index:10;transform-origin:center;
    filter:drop-shadow(0 0 8px rgba(201,168,76,0.5));touch-action:none;
}
#cap-plane:active{cursor:grabbing;}

/* Submit */
.btn-submit{
    width:100%;padding:.9rem;margin-top:1.4rem;
    background:linear-gradient(135deg,#9A1A1A 0%,#C9A84C 50%,#9A1A1A 100%);
    background-size:250% 250%;
    border:none;border-radius:14px;
    color:#0D0303;font-family:'Outfit',sans-serif;
    font-size:.9rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
    cursor:pointer;position:relative;overflow:hidden;
    box-shadow:0 8px 26px rgba(201,168,76,.20),inset 0 1px 0 rgba(255,255,255,.15);
    animation:btn-sh 5s ease infinite,fu .5s ease 2s both;
    opacity:0;transition:transform .35s cubic-bezier(.22,1,.36,1),box-shadow .35s;
}
@keyframes btn-sh{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.btn-submit::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.24),transparent);transition:left .6s;}
.btn-submit:hover::before{left:100%;}
.btn-submit:hover{transform:translateY(-3px) scale(1.015);box-shadow:0 16px 45px rgba(201,168,76,.35),0 0 38px rgba(201,168,76,.11);}
.btn-submit:active{transform:scale(.98);}

/* Footer link */
.form-foot{text-align:center;margin-top:1.1rem;opacity:0;animation:fu .5s ease 2.2s both;}
.form-foot p{font-size:.8rem;color:rgba(255,255,255,.32);}
.form-foot a{color:var(--gold);text-decoration:none;font-weight:600;position:relative;transition:color .3s;}
.form-foot a::after{content:'';position:absolute;bottom:-2px;left:0;width:0;height:1px;background:var(--gold);transition:width .3s;}
.form-foot a:hover{color:var(--gold-light);}
.form-foot a:hover::after{width:100%;}

@media(max-width:900px){
    .reg-card{flex-direction:column;}
    .left{flex:none;padding:2rem 1.5rem;}
    .l-features{flex-direction:row;flex-wrap:wrap;}
    .l-feat{flex:1;min-width:140px;}
    .right{max-height:none;padding:2rem 1.5rem;overflow-y:visible;}
    .form-grid{grid-template-columns:1fr;}
}
@media(max-width:480px){
    .l-brand-name{font-size:1.3rem;}
    .right{padding:1.5rem 1rem;}
    .av-item{width:42px;height:42px;}
    .cdeco{display:none;}
}
@media(prefers-reduced-motion:reduce){
    *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important}
    .reg-card,.fg,.btn-submit,.form-foot,.l-feat,.r-head{opacity:1 !important;transform:none !important}
}
</style>
{% endblock %}

{% block body %}
<div class="aurora"></div>
<div class="aurora-orb aorb-1"></div>
<div class="aurora-orb aorb-2"></div>
<div class="aurora-orb aorb-3"></div>
<div class="mesh-layer"></div>
<div class="noise-layer"></div>
<div class="scanline"></div>
<div class="cglow" id="cglow"></div>

<div class="pfield" id="pfield"></div>

<div class="cdeco cdeco--tl"><svg width="52" height="52" fill="none"><path d="M2 52V2H52" stroke="rgba(201,168,76,0.22)" stroke-width="1"/><circle cx="2" cy="2" r="2.5" fill="rgba(201,168,76,0.40)"/></svg></div>
<div class="cdeco cdeco--tr"><svg width="52" height="52" fill="none" style="transform:scaleX(-1)"><path d="M2 52V2H52" stroke="rgba(201,168,76,0.22)" stroke-width="1"/><circle cx="2" cy="2" r="2.5" fill="rgba(201,168,76,0.40)"/></svg></div>
<div class="cdeco cdeco--bl"><svg width="52" height="52" fill="none" style="transform:scaleY(-1)"><path d="M2 52V2H52" stroke="rgba(201,168,76,0.12)" stroke-width="1"/></svg></div>
<div class="cdeco cdeco--br"><svg width="52" height="52" fill="none" style="transform:scale(-1,-1)"><path d="M2 52V2H52" stroke="rgba(201,168,76,0.12)" stroke-width="1"/></svg></div>

<div class="page-wrap">
    <div class="reg-card">

        <!-- ══ LEFT ══ -->
        <div class="left">
            <div class="left-orb"></div>
            <div class="left-ring lr-1"></div>
            <div class="left-ring lr-2"></div>

            <div class="l-brand">
                <div class="l-logo-ring">🌍</div>
                <div class="l-brand-name">Doura Mondo</div>
                <div class="l-brand-sub">Rejoignez l'aventure</div>
            </div>

            <div class="l-features">
                <div class="l-feat"><div class="l-feat-ico">🗺️</div><div class="l-feat-txt">Destinations exclusives</div></div>
                <div class="l-feat"><div class="l-feat-ico">👥</div><div class="l-feat-txt">Communauté active</div></div>
                <div class="l-feat"><div class="l-feat-ico">⭐</div><div class="l-feat-txt">Avis & recommandations</div></div>
                <div class="l-feat"><div class="l-feat-ico">🔒</div><div class="l-feat-txt">100% sécurisé</div></div>
            </div>

            <div class="l-foot">© 2025 Doura Mondo · Tous droits réservés</div>
        </div>

        <!-- ══ RIGHT (FORM) ══ -->
        <div class="right">
            <div class="r-head">
                <div class="r-head-title">Créer un compte</div>
                <div class="r-head-sub">Remplissez vos informations</div>
            </div>

            {% if errors.general is defined %}
                <div class="alert-error">⚠️ {{ errors.general }}</div>
            {% endif %}

            <form method="POST" action="{{ path('register') }}" enctype="multipart/form-data" novalidate>
                <div class="form-grid">

                    <!-- Nom -->
                    <div class="fg">
                        <label class="flabel">Nom</label>
                        <input type="text" name="nom" class="finput" value="{{ old.nom ?? '' }}" placeholder="Votre nom" autocomplete="family-name">
                        {% if errors.nom is defined %}<div class="field-error">{{ errors.nom }}</div>{% endif %}
                    </div>

                    <!-- Prénom -->
                    <div class="fg">
                        <label class="flabel">Prénom</label>
                        <input type="text" name="prenom" class="finput" value="{{ old.prenom ?? '' }}" placeholder="Votre prénom" autocomplete="given-name">
                        {% if errors.prenom is defined %}<div class="field-error">{{ errors.prenom }}</div>{% endif %}
                    </div>

                    <!-- Username -->
                    <div class="fg full">
                        <label class="flabel">Nom d'utilisateur</label>
                        <input type="text" name="username" class="finput" value="{{ old.username ?? '' }}" placeholder="@username" autocomplete="username">
                        {% if errors.username is defined %}<div class="field-error">{{ errors.username }}</div>{% endif %}
                    </div>

                    <!-- Email -->
                    <div class="fg full">
                        <label class="flabel">Email</label>
                        <input type="email" name="email" class="finput" value="{{ old.email ?? '' }}" placeholder="votre@email.com" autocomplete="email">
                        {% if errors.email is defined %}<div class="field-error">{{ errors.email }}</div>{% endif %}
                    </div>

                    <!-- Téléphone -->
                    <div class="fg full">
                        <label class="flabel">Téléphone</label>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="color:rgba(201,168,76,.38);font-size:.84rem;font-weight:600;white-space:nowrap;">+216</span>
                            <input type="tel" name="telephone" class="finput" value="{{ old.phone ?? '' }}" placeholder="XX XXX XXX" maxlength="8" autocomplete="tel-local">
                        </div>
                        {% if errors.telephone is defined %}<div class="field-error">{{ errors.telephone }}</div>{% endif %}
                    </div>

                    <!-- Mot de passe -->
                    <div class="fg full">
                        <label class="flabel">Mot de passe</label>
                        <div class="finput-wrap">
                            <input type="password" name="password" id="pwInput" class="finput" placeholder="Minimum 6 caractères" autocomplete="new-password" style="padding-right:2.6rem;">
                            <button type="button" class="pw-toggle" onclick="togglePw()">👁</button>
                        </div>
                        <div class="pw-bar"><div class="pw-fill" id="pwFill"></div></div>
                        <div class="pw-txt" id="pwTxt"></div>
                        {% if errors.password is defined %}<div class="field-error">{{ errors.password }}</div>{% endif %}
                    </div>

                    <!-- Avatar -->
                    <div class="fg full avatar-section">
                        <div class="avatar-section-title">🎭 Choisir un avatar</div>
                        <div class="avatar-grid">
                            {% for seed in avatars %}
                                <div class="av-item" data-avatar="{{ seed }}" onclick="selectAvatar('{{ seed }}',this)">
                                    <img src="https://api.dicebear.com/7.x/adventurer/svg?seed={{ seed }}&backgroundColor=b6e3f4,c0aede,ffd5dc,ffdfbf"
                                         alt="{{ seed }}" loading="lazy"
                                         onerror="this.src='https://api.dicebear.com/7.x/initials/svg?seed={{ seed }}'">
                                </div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="selected_avatar" id="selectedAvatar">
                    </div>

                    <!-- Photo upload -->
                    <div class="fg full">
                        <label class="flabel">Ou uploader une photo</label>
                        <div class="upload-area" id="uploadArea">
                            <span class="upload-icon">📷</span>
                            <div class="upload-txt"><strong>Cliquez</strong> ou glissez une image</div>
                            <input type="file" name="photo" accept="image/*" id="photoInput">
                        </div>
                        <div class="file-name" id="fileName" style="display:none;"></div>
                    </div>

                    <!-- Travel Captcha -->
                    <div class="fg full">
                        <div class="captcha-wrap" id="captcha-wrap">
                            <div class="captcha-label">🛡️ Vérification de sécurité</div>
                            <div id="cap-instruction">Chargement…</div>
                            <div id="cap-map">
                                <div id="cap-map-inner">
                                    <svg id="cap-svg" viewBox="0 0 400 216" xmlns="http://www.w3.org/2000/svg"></svg>
                                </div>
                                <div id="cap-plane">✈</div>
                            </div>
                            <div id="cap-status">Glissez l'avion vers la destination</div>
                            <input type="hidden" name="captcha_drag_verified" id="cap-flag" value="0">
                            {% if errors.captcha is defined %}
                                <div class="field-error" style="margin-top:7px;">{{ errors.captcha }}</div>
                            {% endif %}
                        </div>
                    </div>

                </div>

                <button type="submit" class="btn-submit">✨ Créer mon compte</button>
            </form>

            <div class="form-foot">
                <p>Déjà membre ? <a href="{{ path('login') }}">Se connecter</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
/* ════════════════════════════════════
   PARTICLES
════════════════════════════════════ */
(function(){
    const f=document.getElementById('pfield');
    for(let i=0;i<16;i++){
        const d=document.createElement('div');
        d.className='pdot';
        const sz=.5+Math.random()*2.2;
        d.style.cssText=`left:${4+Math.random()*92}%;bottom:-4%;width:${sz}px;height:${sz}px;animation-duration:${9+Math.random()*11}s;animation-delay:${Math.random()*12}s;`;
        f.appendChild(d);
    }
})();

/* ════════════════════════════════════
   TRAVEL DRAG CAPTCHA
════════════════════════════════════ */
(function(){
    const W=400,H=216,HIT=32,HALF=18;
    const CITIES=[
        {name:'Paris',icon:'🗼',x:.48,y:.26},{name:'Tokyo',icon:'⛩',x:.84,y:.34},
        {name:'New York',icon:'🗽',x:.20,y:.30},{name:'Dubai',icon:'🕌',x:.63,y:.44},
        {name:'London',icon:'🎡',x:.44,y:.22},{name:'Sydney',icon:'🦘',x:.87,y:.76},
        {name:'Rio',icon:'🎭',x:.28,y:.70},{name:'Le Caire',icon:'🏛',x:.56,y:.40},
        {name:'Mumbai',icon:'🐘',x:.69,y:.48},{name:'Pékin',icon:'🏯',x:.79,y:.31},
    ];
    const mapEl=document.getElementById('cap-map'),svgEl=document.getElementById('cap-svg');
    const plane=document.getElementById('cap-plane'),instrEl=document.getElementById('cap-instruction');
    const statEl=document.getElementById('cap-status'),flag=document.getElementById('cap-flag');
    const wrap=document.getElementById('captcha-wrap');
    let target,origin,targetX,targetY,startX,startY;
    let dragging=false,verified=false;
    let pressClientX,pressClientY,pressLeft,pressTop;
    let ringAnim=null,rotAnim=null;

    function ns(tag,a){const e=document.createElementNS('http://www.w3.org/2000/svg',tag);for(const[k,v]of Object.entries(a))e.setAttribute(k,v);return e;}
    function easeOut(t){return 1-(1-t)*(1-t);}
    function getRatio(){return mapEl.getBoundingClientRect().width/W;}

    function positionPlane(sx,sy){const r=getRatio();plane.style.left=(sx*r-HALF)+'px';plane.style.top=(sy*r-HALF)+'px';}

    function clearDyn(){svgEl.querySelectorAll('[data-dyn]').forEach(e=>e.remove());clearInterval(ringAnim);clearInterval(rotAnim);ringAnim=rotAnim=null;}

    function drawGrid(){
        for(let i=1;i<7;i++){const x=i*(W/7);svgEl.appendChild(ns('line',{x1:x,y1:0,x2:x,y2:H,stroke:'rgba(201,168,76,0.04)','stroke-width':'0.5'}));}
        for(let i=1;i<5;i++){const y=i*(H/5);svgEl.appendChild(ns('line',{x1:0,y1:y,x2:W,y2:y,stroke:'rgba(201,168,76,0.04)','stroke-width':'0.5'}));}
        svgEl.appendChild(ns('line',{x1:0,y1:H*.48,x2:W,y2:H*.48,stroke:'rgba(201,168,76,0.07)','stroke-width':'0.8','stroke-dasharray':'6 4'}));
    }

    function newChallenge(){
        verified=false;flag.value='0';clearDyn();
        const s=[...CITIES].sort(()=>Math.random()-.5);
        target=s[0];origin=s[1];
        targetX=target.x*W;targetY=target.y*H;
        startX=origin.x*W;startY=origin.y*H;
        instrEl.textContent='✈  Volez vers '+target.name+'  '+target.icon;
        instrEl.style.color='var(--text-main)';
        statEl.textContent="Glissez l'avion vers la destination";
        statEl.style.color='rgba(201,168,76,0.32)';
        wrap.style.borderColor='rgba(201,168,76,0.14)';
        wrap.style.background='rgba(8,2,2,0.72)';

        CITIES.forEach(c=>{
            const cx=c.x*W,cy=c.y*H,isTgt=c===target,isOrg=c===origin;
            svgEl.appendChild(ns('circle',{cx,cy,r:isTgt?'3.5':'1.8',fill:isTgt?'rgba(201,168,76,0.9)':isOrg?'rgba(165,16,32,0.7)':'rgba(201,168,76,0.22)','data-dyn':'1'}));
            const lbl=ns('text',{x:cx+5,y:cy+4,'font-size':isTgt?'10':'8',fill:isTgt?'#C9A84C':isOrg?'rgba(165,16,32,0.6)':'rgba(201,168,76,0.20)','font-weight':isTgt?'bold':'normal','data-dyn':'1'});
            lbl.textContent=isTgt?c.icon+' '+c.name:c.name;svgEl.appendChild(lbl);
        });

        svgEl.appendChild(ns('circle',{cx:targetX,cy:targetY,r:26,fill:'rgba(201,168,76,0.06)','data-dyn':'1'}));
        const ring=ns('circle',{cx:targetX,cy:targetY,r:18,fill:'none',stroke:'rgba(201,168,76,0.45)','stroke-width':'1.5','stroke-dasharray':'5 3','data-dyn':'1'});
        svgEl.appendChild(ring);svgEl._ring=ring;

        let sc=0.85,sd=0.004;
        ringAnim=setInterval(()=>{sc+=sd;if(sc>=1.35||sc<=0.85)sd*=-1;ring.setAttribute('transform',`translate(${targetX},${targetY}) scale(${sc.toFixed(3)}) translate(${-targetX},${-targetY})`);},16);
        let rot=0;
        rotAnim=setInterval(()=>{rot=(rot+0.5)%360;ring.setAttribute('transform',`translate(${targetX},${targetY}) rotate(${rot}) translate(${-targetX},${-targetY})`);},14);

        const pin=ns('text',{x:startX-7,y:startY-6,'font-size':'12','data-dyn':'1'});pin.textContent='📍';svgEl.appendChild(pin);
        positionPlane(startX,startY);plane.style.transform='rotate(0deg) scale(1)';
    }

    plane.addEventListener('pointerdown',e=>{
        if(verified)return;dragging=true;
        pressClientX=e.clientX;pressClientY=e.clientY;
        pressLeft=parseFloat(plane.style.left)||0;pressTop=parseFloat(plane.style.top)||0;
        plane.setPointerCapture(e.pointerId);plane.style.transform='scale(1.25)';e.preventDefault();
    });

    plane.addEventListener('pointermove',e=>{
        if(!dragging||verified)return;
        const r=mapEl.getBoundingClientRect(),ratio=r.width/W;
        const dx=e.clientX-pressClientX,dy=e.clientY-pressClientY;
        const newL=Math.max(-HALF,Math.min(r.width-HALF,pressLeft+dx));
        const newT=Math.max(-HALF,Math.min(r.height-HALF,pressTop+dy));
        plane.style.left=newL+'px';plane.style.top=newT+'px';
        const cx=(newL+HALF)/ratio,cy=(newT+HALF)/ratio;
        const angle=Math.atan2(cy-startY,cx-startX)*180/Math.PI;
        plane.style.transform=`scale(1.25) rotate(${angle}deg)`;
        const ring=svgEl._ring;
        if(ring){const dist=Math.hypot(cx-targetX,cy-targetY);if(dist<65){const t=1-dist/65;ring.setAttribute('stroke',`rgba(201,168,76,${(0.45+t*0.55).toFixed(2)})`);ring.setAttribute('stroke-width',(1.5+t*1.5).toFixed(1));}else{ring.setAttribute('stroke','rgba(201,168,76,0.45)');ring.setAttribute('stroke-width','1.5');}}
        addTrail(cx,cy);e.preventDefault();
    });

    plane.addEventListener('pointerup',()=>{if(!dragging)return;dragging=false;plane.style.transform=plane.style.transform.replace('scale(1.25)','scale(1)');checkLanding();});

    const trailPool=[];
    function addTrail(sx,sy){
        const d=ns('circle',{cx:sx,cy:sy,r:'1.5',fill:'rgba(201,168,76,0.32)','data-dyn':'1','pointer-events':'none'});
        svgEl.appendChild(d);trailPool.push(d);
        if(trailPool.length>40){const o=trailPool.shift();if(o.parentNode)o.parentNode.removeChild(o);}
        let op=1;const fade=setInterval(()=>{op-=.03;if(op<=0){clearInterval(fade);if(d.parentNode)d.parentNode.removeChild(d);}else{d.setAttribute('fill',`rgba(201,168,76,${op.toFixed(2)})`)}},30);
    }

    function checkLanding(){
        const ratio=getRatio();
        const cx=(parseFloat(plane.style.left)+HALF)/ratio;
        const cy=(parseFloat(plane.style.top)+HALF)/ratio;
        if(Math.hypot(cx-targetX,cy-targetY)<HIT)onSuccess(parseFloat(plane.style.left),parseFloat(plane.style.top));
        else onMiss();
    }

    function onMiss(){
        statEl.textContent='✘  Destination manquée — réessayez';statEl.style.color='#FF7070';
        const ratio=getRatio(),tl=startX*ratio-HALF,tt=startY*ratio-HALF;
        const sl=parseFloat(plane.style.left),st=parseFloat(plane.style.top);
        let p=0;const a=setInterval(()=>{p+=.04;if(p>=1){clearInterval(a);plane.style.left=tl+'px';plane.style.top=tt+'px';plane.style.transform='rotate(0deg) scale(1)';}else{plane.style.left=(sl+(tl-sl)*easeOut(p))+'px';plane.style.top=(st+(tt-st)*easeOut(p))+'px';}},16);
        setTimeout(()=>{statEl.textContent="Glissez l'avion vers la destination";statEl.style.color='rgba(201,168,76,0.32)';},2200);
    }

    function onSuccess(finalL,finalT){
        verified=true;flag.value='1';clearInterval(ringAnim);clearInterval(rotAnim);
        instrEl.textContent='✅  Vérifié avec succès !';instrEl.style.color='#66BB6A';
        statEl.textContent='🛬  Atterrissage confirmé';statEl.style.color='#66BB6A';
        wrap.style.borderColor='rgba(102,187,106,0.45)';wrap.style.background='rgba(6,22,6,0.82)';
        const ring=svgEl._ring;if(ring){ring.setAttribute('stroke','rgba(102,187,106,0.8)');ring.setAttribute('fill','rgba(102,187,106,0.10)');}
        const ratio=getRatio(),tl=targetX*ratio-HALF,tt=targetY*ratio-HALF;
        let p=0;const snap=setInterval(()=>{p+=.1;if(p>=1){clearInterval(snap);plane.style.left=tl+'px';plane.style.top=tt+'px';}else{plane.style.left=(finalL+(tl-finalL)*easeOut(p))+'px';plane.style.top=(finalT+(tt-finalT)*easeOut(p))+'px';}},16);
        burst();
    }

    function burst(){
        const cols=['rgba(102,187,106,0.85)','rgba(201,168,76,0.80)','rgba(165,214,167,0.75)'];
        for(let i=0;i<16;i++){
            const ang=Math.random()*360,dist=25+Math.random()*55;
            const ex=Math.cos(ang*Math.PI/180)*dist,ey=Math.sin(ang*Math.PI/180)*dist;
            const p=ns('circle',{cx:targetX,cy:targetY,r:(1.2+Math.random()*2.2).toFixed(1),fill:cols[Math.floor(Math.random()*3)],'data-dyn':'1','pointer-events':'none'});
            svgEl.appendChild(p);let t=0;
            setTimeout(()=>{const a=setInterval(()=>{t+=.025;if(t>=1){clearInterval(a);if(p.parentNode)p.parentNode.removeChild(p);}else{p.setAttribute('cx',targetX+ex*easeOut(t));p.setAttribute('cy',targetY+ey*easeOut(t));p.setAttribute('opacity',(1-t).toFixed(2));}},16);},Math.random()*80);
        }
    }

    drawGrid();newChallenge();
    addEventListener('resize',()=>{if(!verified)positionPlane(startX,startY);});
})();

/* ════════════════════════════════════
   AVATAR SELECTION
════════════════════════════════════ */
function selectAvatar(name,el){
    document.querySelectorAll('.av-item').forEach(a=>a.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('selectedAvatar').value=name;
    el.style.transform='scale(1.28)';
    setTimeout(()=>{el.style.transform='scale(1.10)';},200);
}

/* ════════════════════════════════════
   PASSWORD
════════════════════════════════════ */
function togglePw(){
    const pw=document.getElementById('pwInput');
    const btn=pw.parentElement.querySelector('.pw-toggle');
    pw.type=pw.type==='password'?'text':'password';
    btn.textContent=pw.type==='password'?'👁':'🙈';
}
document.getElementById('pwInput').addEventListener('input',function(){
    const v=this.value;let s=0;
    if(v.length>=6)s++;if(v.length>=10)s++;if(/[A-Z]/.test(v))s++;if(/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;
    const f=document.getElementById('pwFill'),t=document.getElementById('pwTxt');
    f.className='pw-fill';t.className='pw-txt';
    if(!v.length){t.textContent='';return;}
    if(s<=2){f.classList.add('weak');t.classList.add('weak');t.textContent='🔴 Faible';}
    else if(s<=3){f.classList.add('medium');t.classList.add('medium');t.textContent='🟡 Moyen';}
    else{f.classList.add('strong');t.classList.add('strong');t.textContent='🟢 Fort';}
});

/* ════════════════════════════════════
   FILE UPLOAD
════════════════════════════════════ */
(function(){
    const inp=document.getElementById('photoInput');
    const area=document.getElementById('uploadArea');
    const fname=document.getElementById('fileName');
    if(!inp)return;
    inp.addEventListener('change',function(){
        if(!this.files.length)return;
        fname.textContent='📎 '+this.files[0].name;fname.style.display='block';
        area.style.borderColor='rgba(16,185,129,.4)';area.style.background='rgba(16,185,129,.04)';
    });
    ['dragenter','dragover'].forEach(e=>area.addEventListener(e,ev=>{ev.preventDefault();area.classList.add('dragover');}));
    ['dragleave','drop'].forEach(e=>area.addEventListener(e,ev=>{ev.preventDefault();area.classList.remove('dragover');}));
    area.addEventListener('drop',e=>{if(e.dataTransfer.files.length){fname.textContent='📎 '+e.dataTransfer.files[0].name;fname.style.display='block';}});
})();

/* ════════════════════════════════════
   CURSOR GLOW
════════════════════════════════════ */
(function(){
    const g=document.getElementById('cglow');
    if(!matchMedia('(pointer:fine)').matches)return;
    addEventListener('mousemove',e=>{g.style.left=e.clientX+'px';g.style.top=e.clientY+'px';g.style.opacity='1';});
    addEventListener('mouseleave',()=>g.style.opacity='0');
})();

/* ════════════════════════════════════
   SHAKE ON ERRORS
════════════════════════════════════ */
{% if errors is defined and errors|length > 0 %}
(function(){
    const s=document.createElement('style');
    s.textContent=`@keyframes cshake{0%,100%{transform:translateX(0)}12%{transform:translateX(-10px)}25%{transform:translateX(10px)}37%{transform:translateX(-7px)}50%{transform:translateX(7px)}62%{transform:translateX(-4px)}75%{transform:translateX(4px)}}.cshake{animation:cshake .5s ease !important;}`;
    document.head.appendChild(s);
    const c=document.querySelector('.reg-card');
    if(c){c.classList.add('cshake');setTimeout(()=>c.classList.remove('cshake'),550);}
})();
{% endif %}
</script>
{% endblock %}