{% extends 'base.html.twig' %}

{% block title %}Confirmation – Doura Mondo{% endblock %}

{% block body %}

<!-- Hero Banner -->
<div style="background: linear-gradient(135deg, #6B1E1E 0%, #8B2C2C 50%, #6B1E1E 100%); padding: 35px 20px; text-align: center; color: white;">
    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; margin: 0; letter-spacing: 2px;">✨ Réservation confirmée ✨</h2>
    <p style="font-family: 'Montserrat', sans-serif; font-size: 12px; letter-spacing: 3px; margin: 8px 0 0; opacity: 0.85; text-transform: uppercase;">Votre voyage est officiellement réservé</p>
</div>

<!-- Contenu principal -->
<div style="background: linear-gradient(rgba(254,246,232,0.75), rgba(250,240,220,0.80)), url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1600') center/cover no-repeat; padding: 60px 20px; min-height: 70vh;">
    <div class="container">
        <div style="max-width: 960px; margin: 0 auto;">

            <!-- Message de succès animé -->
            <div style="text-align: center; margin-bottom: 30px;">
                <div style="display: inline-block; background: rgba(107,30,30,0.9); border-radius: 60px; padding: 8px 24px; margin-bottom: 20px;">
                    <span style="font-family: 'Montserrat', sans-serif; font-size: 11px; letter-spacing: 2px; color: #E8DDC9; text-transform: uppercase;">✓ Transaction réussie</span>
                </div>
            </div>

            <!-- Carte principale -->
            <div style="background: rgba(255,255,255,0.95); border-radius: 24px; overflow: hidden; border: 1px solid rgba(212,184,150,0.4); box-shadow: 0 20px 40px rgba(0,0,0,0.08);">

                <!-- En-tête avec icône -->
                <div style="background: linear-gradient(135deg, #6B1E1E, #8B2C2C); padding: 30px; text-align: center;">
                    <div style="width: 80px; height: 80px; background: rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; border: 2px solid rgba(255,255,255,0.3);">
                        <i class="bi bi-check-lg" style="font-size: 45px; color: white;"></i>
                    </div>
                    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; margin: 0 0 8px; color: white; letter-spacing: 1px;">Merci, {{ client.prenom }} {{ client.nom }} !</h2>
                    <p style="font-family: 'Montserrat', sans-serif; font-size: 13px; color: rgba(255,255,255,0.85); margin: 0;">Votre réservation a été confirmée avec succès</p>
                </div>

                <!-- Corps de la confirmation -->
                <div style="padding: 40px;">

                    <!-- Message personnalisé -->
                    <div style="background: #FDF8F0; border-left: 4px solid #8B2C2C; padding: 18px 24px; border-radius: 12px; margin-bottom: 30px;">
                        <p style="font-family: 'Montserrat', sans-serif; font-size: 13px; color: #5a3a2a; margin: 0; line-height: 1.6;">
                            <i class="bi bi-envelope-paper" style="margin-right: 10px; color: #8B2C2C;"></i>
                            Un email de confirmation a été envoyé à <strong>{{ client.email }}</strong>. 
                            Vous pouvez présenter cet email lors de votre départ.
                        </p>
                    </div>

                    <div class="row">
                        <!-- Détails du voyage -->
                        <div class="col-md-6">
                            <div style="margin-bottom: 30px;">
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #F0E8D8;">
                                    <div style="width: 40px; height: 40px; background: #8B2C2C; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-suitcase-lg" style="color: white; font-size: 18px;"></i>
                                    </div>
                                    <h3 style="font-family: 'Playfair Display', serif; color: #6B1E1E; font-size: 1.2rem; margin: 0;">Détails du voyage</h3>
                                </div>

                                <div style="padding-left: 10px;">
                                    <div style="margin-bottom: 16px;">
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Destination</span>
                                        <span style="font-family: 'Playfair Display', serif; font-size: 1.2rem; color: #2c2c2c;">{{ destination }}</span>
                                    </div>

                                    <div style="margin-bottom: 16px;">
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Référence réservation</span>
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 600; color: #8B2C2C;">#{{ reservation.id }}</span>
                                    </div>

                                    <div style="margin-bottom: 16px;">
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Période</span>
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 14px; color: #3f2c24;">
                                            Du <strong>{{ reservation.dateDepart|date('d/m/Y') }}</strong> au <strong>{{ reservation.dateRetour|date('d/m/Y') }}</strong>
                                        </span>
                                    </div>

                                    <div style="margin-bottom: 16px;">
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Nombre de voyageurs</span>
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 14px; color: #3f2c24;">
                                            <i class="bi bi-people" style="margin-right: 5px;"></i> {{ reservation.nombrePersonnes }} personne(s)
                                        </span>
                                    </div>

                                    <div>
                                        <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Statut</span>
                                        {% if reservation.statut == 'payé' %}
                                            <span style="display: inline-block; background: #28a745; color: white; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                                                <i class="bi bi-check-circle"></i> Payé
                                            </span>
                                        {% else %}
                                            <span style="display: inline-block; background: #ffc107; color: #2c2c2c; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                                                <i class="bi bi-clock"></i> En attente de paiement
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Paiement -->
                        <div class="col-md-6">
                            <div style="margin-bottom: 30px;">
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #F0E8D8;">
                                    <div style="width: 40px; height: 40px; background: #8B2C2C; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-credit-card" style="color: white; font-size: 18px;"></i>
                                    </div>
                                    <h3 style="font-family: 'Playfair Display', serif; color: #6B1E1E; font-size: 1.2rem; margin: 0;">Paiement</h3>
                                </div>

                                {% if paiement %}
                                    <div style="padding-left: 10px;">
                                        <div style="background: linear-gradient(135deg, #6B1E1E, #8B2C2C); border-radius: 16px; padding: 25px; text-align: center; margin-bottom: 20px;">
                                            <div style="font-family: 'Montserrat', sans-serif; font-size: 10px; letter-spacing: 2px; color: rgba(255,255,255,0.7); text-transform: uppercase; margin-bottom: 10px;">Montant total réglé</div>
                                            <div style="font-family: 'Playfair Display', serif; font-size: 2.2rem; color: white; font-weight: 600;">
                                                {{ reservation.montantTotal|number_format(2, ',', ' ') }} €
                                            </div>
                                        </div>

                                        <div style="margin-bottom: 12px;">
                                            <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Mode de paiement</span>
                                            <span style="font-family: 'Montserrat', sans-serif; font-size: 14px; color: #3f2c24;">
                                                <i class="bi bi-credit-card-2-front" style="margin-right: 5px;"></i> {{ paiement.modePaiement }}
                                            </span>
                                        </div>

                                        <div style="margin-bottom: 12px;">
                                            <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Référence transaction</span>
                                            <span style="font-family: 'Montserrat', sans-serif; font-size: 12px; color: #8B2C2C; font-family: monospace;">{{ paiement.referencePaiement }}</span>
                                        </div>

                                        <div>
                                            <span style="font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #9B7240; text-transform: uppercase; display: block; margin-bottom: 5px;">Date du paiement</span>
                                            <span style="font-family: 'Montserrat', sans-serif; font-size: 13px; color: #3f2c24;">
                                                {{ paiement.datePaiement|date('d/m/Y à H:i') }}
                                            </span>
                                        </div>
                                    </div>
                                {% else %}
                                    <div style="text-align: center; padding: 40px 20px; background: #FDF8F0; border-radius: 16px;">
                                        <i class="bi bi-hourglass-split" style="font-size: 48px; color: #D4B896;"></i>
                                        <p style="font-family: 'Montserrat', sans-serif; font-size: 13px; color: #9B7240; margin-top: 15px;">
                                            En attente de paiement<br>
                                            <a href="{{ path('app_payment', {'id': reservation.id}) }}" style="color: #8B2C2C; text-decoration: none; font-weight: 600;">Procéder au paiement →</a>
                                        </p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Informations client -->
                    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #F0E8D8;">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
                            <div style="width: 36px; height: 36px; background: #9B7240; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-person" style="color: white; font-size: 16px;"></i>
                            </div>
                            <h4 style="font-family: 'Playfair Display', serif; color: #6B1E1E; font-size: 1rem; margin: 0;">Informations du voyageur</h4>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <p style="margin-bottom: 8px;"><span style="font-family: 'Montserrat', sans-serif; font-size: 11px; color: #9B7240;">Nom complet</span><br>
                                <strong style="font-family: 'Montserrat', sans-serif; font-size: 14px; color: #2c2c2c;">{{ client.prenom }} {{ client.nom }}</strong></p>
                            </div>
                            <div class="col-md-4">
                                <p style="margin-bottom: 8px;"><span style="font-family: 'Montserrat', sans-serif; font-size: 11px; color: #9B7240;">Email</span><br>
                                <strong style="font-family: 'Montserrat', sans-serif; font-size: 14px; color: #2c2c2c;">{{ client.email }}</strong></p>
                            </div>
                            <div class="col-md-4">
                                <p style="margin-bottom: 8px;"><span style="font-family: 'Montserrat', sans-serif; font-size: 11px; color: #9B7240;">Téléphone</span><br>
                                <strong style="font-family: 'Montserrat', sans-serif; font-size: 14px; color: #2c2c2c;">{{ client.telephone }}</strong></p>
                            </div>
                        </div>
                    </div>

                    <!-- Boutons d'action -->
                    <div style="display: flex; gap: 15px; justify-content: center; margin-top: 40px; padding-top: 30px; border-top: 1px solid #F0E8D8;">
                        <a href="{{ path('app_reservation') }}" style="background: linear-gradient(135deg, #8B2C2C, #6B1E1E); border: none; padding: 14px 32px; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; border-radius: 50px; color: white; text-decoration: none; display: inline-block; transition: 0.3s;">
                            <i class="bi bi-plus-circle"></i> Nouvelle réservation
                        </a>
                        <button onclick="window.print();" style="background: transparent; border: 2px solid #D4B896; padding: 12px 28px; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 1px; border-radius: 50px; color: #6B1E1E; cursor: pointer; transition: 0.3s;">
                            <i class="bi bi-printer"></i> Imprimer
                        </button>
                    </div>

                    <!-- Note de bas -->
                    <div style="text-align: center; margin-top: 30px;">
                        <p style="font-family: 'Montserrat', sans-serif; font-size: 11px; color: #9B7240; margin: 0;">
                            <i class="bi bi-envelope"></i> Un email récapitulatif vous a été envoyé. Conservez-le précieusement.
                        </p>
                    </div>
                </div>

                <!-- Pied de carte -->
                <div style="background: #FDF8F0; padding: 20px 40px; text-align: center; border-top: 1px solid #F0E8D8;">
                    <div style="display: flex; justify-content: center; gap: 20px; margin-bottom: 15px;">
                        <img src="https://cdn-icons-png.flaticon.com/512/349/349221.png" alt="Visa" style="height: 30px; opacity: 0.6;">
                        <img src="https://cdn-icons-png.flaticon.com/512/349/349228.png" alt="Mastercard" style="height: 30px; opacity: 0.6;">
                        <img src="https://cdn-icons-png.flaticon.com/512/174/174861.png" alt="PayPal" style="height: 30px; opacity: 0.6;">
                    </div>
                    <p style="font-family: 'Montserrat', sans-serif; font-size: 10px; color: #9B7240; margin: 0;">
                        Merci de votre confiance – Doura Mondo • Voyages d'Exception depuis 2025
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}