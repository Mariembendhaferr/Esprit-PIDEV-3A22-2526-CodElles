{% extends 'admin/base-admin.html.twig' %}

{% block title %}Dashboard{% endblock %}

{# ── Ajoute la classe page-dashboard sur <body> ──────────── #}
{# Option A : si base-admin expose un block body_class        #}
{% block body_class %}page-dashboard{% endblock %}

{# Option B : si base-admin expose un block body_attr         #}
{# {% block body_attr %}class="page-dashboard"{% endblock %}  #}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
    /* ── OVERRIDE main-content ─────────────────────────────── */
   
    /* UNIQUEMENT sur la page dashboard — sans risque global     */
    main.main-content {
        background: transparent !important;
        background-color: transparent !important;
        box-shadow: none !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
    }

    /* ── RESET & BASE ───────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    .dash-wrapper {
        padding: 2rem 2.5rem;
        font-family: 'Montserrat', sans-serif;
        background: #f9f4f4;
        min-height: 100vh;
    }

    /* ── PAGE HEADER ────────────────────────────────────────── */
    .dash-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
        border-bottom: 1px solid rgba(139,0,0,0.12);
    }
    .dash-header-left { display: flex; flex-direction: column; gap: 0.1rem; }
    .dash-brand-row   { display: flex; align-items: baseline; gap: 0.6rem; }
    .dash-brand-doura {
        font-family: 'Great Vibes', cursive;
        font-size: 3rem;
        font-weight: 400;
        color: #8B0000;
        line-height: 1;
        letter-spacing: 0.02em;
    }
    .dash-brand-mondo {
        font-family: 'Great Vibes', cursive;
        font-size: 2.6rem;
        font-weight: 400;
        letter-spacing: 0.02em;
        color: #8B0000;
        line-height: 1;
    }
    .dash-brand-sep {
        width: 55px; height: 1px;
        background: linear-gradient(90deg, #8B0000, transparent);
        margin: 0.25rem 0;
    }
    .dash-header-left p {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 0.82rem;
        color: #aaa;
        margin: 0;
        letter-spacing: 0.06em;
    }
    .dash-date {
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #bbb;
        font-weight: 500;
    }

    /* ── SECTION DIVIDER ────────────────────────────────────── */
    .section-divider {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin: 1.8rem 0 1rem;
    }
    .section-divider-label {
        font-family: 'Cinzel', serif;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #8B0000;
        white-space: nowrap;
    }
    .section-divider-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(139,0,0,0.2), transparent);
    }

    /* ── KPI CARDS ──────────────────────────────────────────── */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .kpi-card {
        background: #fff;
        border: none;
        border-radius: 14px;
        padding: 1.2rem 1.4rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(139,0,0,0.13), 0 1px 4px rgba(139,0,0,0.07);
        transition: box-shadow 0.2s, transform 0.2s;
    }
    .kpi-card:hover { box-shadow: 0 10px 32px rgba(139,0,0,0.22), 0 2px 8px rgba(139,0,0,0.10); transform: translateY(-2px); }
    .kpi-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #8B0000, #c0392b);
    }
    .kpi-label {
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #aaa;
        margin-bottom: 0.3rem;
    }
    .kpi-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }
    .kpi-badge-inline {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 0.6rem;
        font-weight: 600;
        color: #8B0000;
        letter-spacing: 0.04em;
    }
    .kpi-bottom-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .kpi-value {
        font-family: 'Cinzel', serif;
        font-size: 1.7rem;
        font-weight: 500;
        color: #1a1a1a;
        line-height: 1;
    }
    .kpi-sparkline { flex-shrink: 0; opacity: 0.85; }

    /* ── CHART CARDS ────────────────────────────────────────── */
    .chart-card {
        background: #fff;
        border: none;
        border-radius: 14px;
        padding: 1.4rem 1.6rem;
        box-shadow: 0 4px 18px rgba(139,0,0,0.11), 0 1px 4px rgba(139,0,0,0.06);
    }
    .chart-card-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #8B0000;
        margin-bottom: 1rem;
    }
    .chart-card-title span {
        font-style: italic;
        font-weight: 400;
        font-size: 0.65rem;
        color: #c0a0a0;
        margin-left: 6px;
    }

    /* ── GRIDS ──────────────────────────────────────────────── */
    .charts-row { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .charts-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .charts-row-half { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .charts-row-wide { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1rem; margin-bottom: 1rem; }

    /* ── WORLD MAP ──────────────────────────────────────────── */
    .map-container { display: flex; gap: 0; align-items: stretch; height: 420px; }
    .map-country-list {
        width: 172px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        gap: 0;
        padding-right: 1rem;
        border-right: 1px solid rgba(139,0,0,0.10);
        margin-right: 1rem;
        overflow-y: auto;
    }
    .map-country-item {
        display: flex;
        align-items: center;
        gap: 9px;
        cursor: pointer;
        padding: 5px 7px;
        border-radius: 7px;
        transition: background 0.15s;
        position: relative;
    }
    .map-country-item:hover, .map-country-item.active { background: rgba(139,0,0,0.06); }
    .map-country-rank {
        font-family: 'Cinzel', serif;
        font-size: 0.58rem;
        font-weight: 700;
        color: #fff;
        background: #8B0000;
        width: 18px; height: 18px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        letter-spacing: 0;
    }
    .map-country-info { flex: 1; min-width: 0; }
    .map-country-name {
        font-size: 0.7rem;
        font-weight: 600;
        color: #2a1a1a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
    }
    .map-country-bar-wrap {
        height: 3px;
        background: rgba(139,0,0,0.10);
        border-radius: 2px;
        margin-top: 3px;
        overflow: hidden;
    }
    .map-country-bar { height: 100%; border-radius: 2px; background: linear-gradient(90deg, #8B0000, #c0392b); transition: width 0.6s ease; }
    .map-country-pct { font-family: 'Cinzel', serif; font-size: 0.68rem; font-weight: 700; color: #8B0000; flex-shrink: 0; }
    #worldMapSvg { flex: 1; height: 100%; min-width: 0; border-radius: 10px; overflow: hidden; }

    /* ── MAP WHITE BG (original) ────────────────────────────── */
    #worldMapSvg, #worldMapSvg svg,
    #worldMapSvg > *, .map-container, .map-country-list {
        background: #ffffff !important;
        background-color: #ffffff !important;
    }
    .map-country-name { color: #444 !important; }
    .map-country-pct  { color: #8B0000 !important; }

    /* ── MAP BUBBLE indicateur ──────────────────────────────── */
    .map-bubble {
        fill: #8B0000;
        stroke: #fff;
        stroke-width: 1.5;
        cursor: pointer;
        transition: fill 0.2s;
    }
    .map-bubble:hover { fill: #c0392b; }
    .map-bubble-label {
        fill: #fff;
        font-family: 'Montserrat', sans-serif;
        font-size: 9px;
        font-weight: 700;
        text-anchor: middle;
        dominant-baseline: central;
        pointer-events: none;
    }

    /* ── MAP TOOLTIP ────────────────────────────────────────── */
    .map-tooltip {
        position: fixed;
        background: #fff;
        color: #2a1a1a;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.7rem;
        font-family: 'Montserrat', sans-serif;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s;
        z-index: 9999;
        white-space: nowrap;
        box-shadow: 0 6px 24px rgba(139,0,0,0.18);
        border: 1px solid rgba(139,0,0,0.12);
        min-width: 140px;
    }
    .map-tooltip.visible { opacity: 1; }
    .map-tooltip-flag { font-size: 1.1rem; margin-bottom: 4px; display: block; }
    .map-tooltip-country { font-weight: 700; font-size: 0.78rem; margin-bottom: 2px; color: #2a1a1a; }
    .map-tooltip-count { font-family: 'Cinzel', serif; font-size: 1rem; font-weight: 700; color: #8B0000; }
    .map-tooltip-pct { font-size: 0.65rem; color: #888; margin-top: 1px; }

    /* ── DURÉE AVG BOX ──────────────────────────────────────── */
    .avg-stat-box {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; height: 100%; text-align: center; padding: 1rem 0;
    }
    .avg-big {
        font-family: 'Cinzel', serif; font-size: 4.5rem; font-weight: 500;
        color: #1a1a1a; line-height: 1;
    }
    .avg-big .avg-unit {
        font-size: 1.2rem; color: #c0392b; font-family: 'Montserrat', sans-serif;
        font-weight: 600; letter-spacing: 0.08em; vertical-align: super; margin-left: 4px;
    }
    .avg-label {
        font-family: 'Cormorant Garamond', serif; font-style: italic;
        font-size: 1.1rem; color: #999; margin-top: 0.5rem; letter-spacing: 0.04em;
    }
    .avg-divider {
        width: 40px; height: 2px;
        background: linear-gradient(90deg, #c0392b, #e74c3c);
        border-radius: 2px; margin: 0.8rem auto;
    }
    .avg-sub-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 1.2rem; width: 100%; }
    .avg-sub-card {
        background: #fafafa; border: 1px solid rgba(0,0,0,0.06);
        border-radius: 10px; padding: 0.7rem 0.9rem; text-align: left;
    }
    .avg-sub-label {
        font-size: 0.6rem; font-weight: 600; letter-spacing: 0.1em;
        text-transform: uppercase; color: #bbb; margin-bottom: 3px;
    }
    .avg-sub-val { font-family: 'Cinzel', serif; font-size: 1.1rem; color: #1a1a1a; }

    /* ── MINI KPI STRIP ─────────────────────────────────────── */
    .mini-kpi-strip { display: grid; grid-template-columns: repeat(3,1fr); gap: 0.5rem; margin-bottom: 1rem; }
    .mini-kpi {
        background: #fdf5f5; border-radius: 8px; padding: 0.6rem 0.8rem;
        border-left: 3px solid #8B0000;
    }
    .mini-kpi-label {
        font-size: 0.58rem; font-weight: 600; letter-spacing: 0.1em;
        text-transform: uppercase; color: #bbb; margin-bottom: 2px;
    }
    .mini-kpi-val { font-family: 'Cinzel', serif; font-size: 1.05rem; color: #8B0000; }
    .mini-kpi-val span { font-size: 0.65rem; font-family: 'Montserrat', sans-serif; margin-left: 2px; }

    /* ── ACTIVITE KPI GRID ──────────────────────────────────── */
    .act-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; margin-bottom: 1rem; }
    .act-kpi {
        background: #fff;
        border: none;
        border-radius: 12px;
        padding: 1rem 1.1rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(139,0,0,0.11), 0 1px 4px rgba(139,0,0,0.06);
    }
    .act-kpi::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #8B0000, #e88080);
    }
    .act-kpi-label { font-size: 0.58rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #bbb; margin-bottom: 4px; }
    .act-kpi-val { font-family: 'Cinzel', serif; font-size: 1.5rem; color: #1a1a1a; line-height: 1; }
    .act-kpi-sub { font-size: 0.62rem; color: #c0a0a0; margin-top: 3px; }

    /* ── RESERVATION KPI ────────────────────────────────────── */
    .res-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; margin-bottom: 1rem; }
    .res-kpi {
        background: #fff;
        border: none;
        border-radius: 12px;
        padding: 1rem 1.1rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(139,0,0,0.11), 0 1px 4px rgba(139,0,0,0.06);
    }
    .res-kpi::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 3px; height: 100%;
        background: linear-gradient(180deg, #8B0000, #e88080);
    }
    .res-kpi-label { font-size: 0.58rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #bbb; margin-bottom: 4px; }
    .res-kpi-val { font-family: 'Cinzel', serif; font-size: 1.5rem; color: #1a1a1a; line-height: 1; }
    .res-kpi-sub { font-size: 0.62rem; color: #c0a0a0; margin-top: 3px; }

    /* ── LEGEND PILLS ───────────────────────────────────────── */
    .chart-legend { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
    .chart-legend-item { display: flex; align-items: center; gap: 5px; font-size: 0.65rem; color: #888; }
    .chart-legend-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
</style>
{% endblock %}

{% block admin_content %}
<div class="dash-wrapper">

    {# ── PAGE HEADER ─────────────────────────────────────────── #}
    <div class="dash-header">
        <div class="dash-header-left">
            <div class="dash-brand-row">
                <span class="dash-brand-doura">Envie d'explorer</span>
                <span class="dash-brand-mondo">vos nouveautés ?</span>
            </div>
            <div class="dash-brand-sep"></div>
            <p>Tableau de bord &mdash; Voyages d'Exception</p>
        </div>
        <div class="dash-date">{{ "now"|date("d/m/Y") }}</div>
    </div>

    {# ══════════════════════════════════════════════════════════ #}
    {# SECTION 1 — VOYAGES                                        #}
    {# ══════════════════════════════════════════════════════════ #}
    <div class="section-divider">
        <span class="section-divider-label">Voyages</span>
        <div class="section-divider-line"></div>
    </div>

    {# KPI VOYAGES #}
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-top-row">
                <div class="kpi-label">Total Voyages</div>
                <div class="kpi-badge-inline">▲ 18.4% vs PY</div>
            </div>
            <div class="kpi-bottom-row">
                <div class="kpi-value">{{ stats.totalVoyages }}</div>
                <svg class="kpi-sparkline" width="80" height="36" viewBox="0 0 80 36">
                    <polyline points="0,28 13,22 26,30 39,14 52,18 65,8 80,4" fill="none" stroke="#8B0000" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top-row">
                <div class="kpi-label">Destinations</div>
                <div class="kpi-badge-inline">▲ 12.1% vs PY</div>
            </div>
            <div class="kpi-bottom-row">
                <div class="kpi-value">{{ stats.totalDestinations }}</div>
                <svg class="kpi-sparkline" width="80" height="36" viewBox="0 0 80 36">
                    <polyline points="0,32 13,20 26,26 39,30 52,16 65,22 80,10" fill="none" stroke="#8B0000" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top-row">
                <div class="kpi-label">Continents</div>
                <div class="kpi-badge-inline">▲ 5.0% vs PY</div>
            </div>
            <div class="kpi-bottom-row">
                <div class="kpi-value">{{ stats.totalContinents }}</div>
                <svg class="kpi-sparkline" width="80" height="36" viewBox="0 0 80 36">
                    <polyline points="0,24 13,28 26,18 39,22 52,12 65,16 80,6" fill="none" stroke="#8B0000" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top-row">
                <div class="kpi-label">Places Totales</div>
                <div class="kpi-badge-inline">▲ 9.3% vs PY</div>
            </div>
            <div class="kpi-bottom-row">
                <div class="kpi-value">{{ stats.totalPersonnes }}</div>
                <svg class="kpi-sparkline" width="80" height="36" viewBox="0 0 80 36">
                    <polyline points="0,30 13,26 26,32 39,20 52,24 65,14 80,8" fill="none" stroke="#8B0000" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
            </div>
        </div>
    </div>

    {# MAP + DURÉE #}
    <div class="charts-row">
        <div class="chart-card">
            <div class="chart-card-title">Voyages par Destination <span>| pourcentage mondial</span></div>
            <div class="map-container">
                <div class="map-country-list" id="countryList"></div>
                <div id="worldMapSvg"></div>
            </div>
            <div class="map-tooltip" id="mapTooltip">
                <span class="map-tooltip-flag" id="tooltipFlag"></span>
                <div class="map-tooltip-country" id="tooltipCountry"></div>
                <div class="map-tooltip-count" id="tooltipCount"></div>
                <div class="map-tooltip-pct" id="tooltipPct"></div>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-card-title">Durée Moyenne par Destination <span>| jours</span></div>
            <div class="mini-kpi-strip">
                <div class="mini-kpi">
                    <div class="mini-kpi-label">Moyenne</div>
                    <div class="mini-kpi-val">{{ stats.avgDuree }}<span>j</span></div>
                </div>
                <div class="mini-kpi">
                    <div class="mini-kpi-label">Min</div>
                    <div class="mini-kpi-val">{{ stats.minDuree }}<span>j</span></div>
                </div>
                <div class="mini-kpi">
                    <div class="mini-kpi-label">Max</div>
                    <div class="mini-kpi-val">{{ stats.maxDuree }}<span>j</span></div>
                </div>
            </div>
            <div style="position:relative; width:100%; height:185px;">
                <canvas id="dureeChart" role="img" aria-label="Durée moyenne par destination.">Durée moy. : {{ stats.avgDuree }}j</canvas>
            </div>
        </div>
    </div>

    {# ══════════════════════════════════════════════════════════ #}
    {# SECTION 2 — ACTIVITÉS                                      #}
    {# ══════════════════════════════════════════════════════════ #}
    <div class="section-divider">
        <span class="section-divider-label">Activités</span>
        <div class="section-divider-line"></div>
    </div>

    {# KPI ACTIVITÉS supprimés #}

    {# ROW 1 ACTIVITÉS : Radar catégories + Coût Moyen #}
    <div class="charts-row-half">
        <div class="chart-card">
            <div class="chart-card-title">Répartition par Catégorie <span>| radar</span></div>
            <div style="position:relative; height:240px;">
                <canvas id="radarChart" role="img" aria-label="Répartition activités par catégorie."></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-card-title">Coût Moyen par Catégorie <span>| barres horizontales</span></div>
            <div style="position:relative; height:240px;">
                <canvas id="coutHorizChart" role="img" aria-label="Coût moyen par catégorie."></canvas>
            </div>
        </div>
    </div>

    {# ROW 2 ACTIVITÉS : Scatter coût/durée + Statuts donut #}
    <div class="charts-row-wide">
        <div class="chart-card">
            <div class="chart-card-title">Coût vs Durée <span>| par catégorie</span></div>
            <div style="position:relative; height:240px;">
                <canvas id="scatterChart" role="img" aria-label="Nuage de points coût vs durée."></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-card-title">Statuts des Activités <span>| donut</span></div>
            <div style="position:relative; height:240px;">
                <canvas id="statutDonut" role="img" aria-label="Répartition des statuts."></canvas>
            </div>
        </div>
    </div>

    {# ROW 3 supprimé #}

    {# ══════════════════════════════════════════════════════════ #}
    {# SECTION 3 — RÉSERVATIONS                                   #}
    {# ══════════════════════════════════════════════════════════ #}
    <div class="section-divider">
        <span class="section-divider-label">Réservations</span>
        <div class="section-divider-line"></div>
    </div>

