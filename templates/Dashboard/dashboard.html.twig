<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
/* ══════════════════════════════════════════════════════════════
   HELPERS
══════════════════════════════════════════════════════════════ */
const RED_PALETTE = ['#5a0000','#6e0000','#8B0000','#a82020','#c84040','#d86060','#e28080','#eda0a0'];
const chartDefaults = {
    font: { family: 'Montserrat', size: 10 },
    color: '#bbb'
};
Chart.defaults.font.family = 'Montserrat';
Chart.defaults.font.size   = 10;
Chart.defaults.color       = '#aaa';

/* ══════════════════════════════════════════════════════════════
   1. WORLD MAP
══════════════════════════════════════════════════════════════ */
(function () {
    const voyageData = {{ stats.voyagesByDestination | json_encode | raw }};
    const destinationToId = {
        "Maroc":"504","Marrakech":"504","Turquie":"792","Istanbul":"792",
        "Indonésie":"360","Bali":"360","Grèce":"300","Santorini":"300","Athènes":"300",
        "Japon":"392","Kyoto":"392","Tokyo":"392","France":"250","Paris":"250",
        "Italie":"380","Rome":"380","Allemagne":"276","Espagne":"724","Tunisie":"788",
        "Égypte":"818","Thaïlande":"764","Singapour":"702","Jordanie":"400",
        "Émirats":"784","Algérie":"012","Portugal":"620","Pays-Bas":"528",
        "Belgique":"056","Suisse":"756","Autriche":"040","Croatie":"191",
        "Maldives":"462","Kenya":"404","Tanzanie":"834","Afrique du Sud":"710",
        "Mexique":"484","Pérou":"604","Brésil":"076","États-Unis":"840",
        "Canada":"124","Australie":"036","Nouvelle-Zélande":"554"
    };

    /* centroïdes approximatifs [lon, lat] par id pays */
    const centroids = {
        "504":[-5.0,31.8],"792":[35.2,39.0],"360":[117.0,-2.0],"300":[22.0,39.0],
        "392":[138.0,36.5],"250":[2.5,46.5],"380":[12.5,42.5],"276":[10.4,51.2],
        "724":[-3.7,40.4],"788":[9.1,34.0],"818":[30.0,26.5],"764":[100.5,15.5],
        "702":[103.8,1.35],"400":[36.2,31.2],"784":[54.0,24.0],"012":[2.6,28.0],
        "620":[-8.2,39.5],"528":[5.3,52.1],"056":[4.5,50.5],"756":[8.2,46.8],
        "040":[14.5,47.5],"191":[15.2,45.1],"462":[73.5,3.2],"404":[37.9,-1.0],
        "834":[34.9,-6.4],"710":[25.0,-29.0],"484":[-102.5,23.6],"604":[-76.0,-9.0],
        "076":[-53.0,-10.0],"840":[-98.5,38.5],"124":[-96.8,56.0],"036":[133.5,-25.5],
        "554":[172.5,-41.5]
    };

    const countById = {}, labelById = {};
    for (const [dest, count] of Object.entries(voyageData)) {
        const id = destinationToId[dest];
        if (id) { countById[id] = (countById[id] || 0) + count; labelById[id] = dest; }
    }
    const total  = Object.values(countById).reduce((a, b) => a + b, 0) || 1;
    const maxCount = Math.max(...Object.values(countById), 1);
    const sorted = Object.entries(countById).sort((a, b) => b[1] - a[1]).slice(0, 8);

    /* ── Liste pays (version améliorée) ── */
    const listEl = document.getElementById('countryList');
    sorted.forEach(([id, count], i) => {
        const pct = Math.round((count / total) * 100);
        const el  = document.createElement('div');
        el.className = 'map-country-item';
        el.dataset.id = id;
        el.innerHTML = `
            <div class="map-country-rank">${i + 1}</div>
            <div class="map-country-info">
                <div class="map-country-name">${labelById[id]}</div>
                <div class="map-country-bar-wrap">
                    <div class="map-country-bar" style="width:${pct}%"></div>
                </div>
            </div>
            <span class="map-country-pct">${pct}%</span>`;
        listEl.appendChild(el);
    });

    /* ── Choroplèthe + bulles ── */
    const container = document.getElementById('worldMapSvg');
    const w = container.clientWidth || 600;
    const h = container.clientHeight || 420;

    const svg = d3.select('#worldMapSvg').append('svg')
        .attr('viewBox', `0 0 ${w} ${h}`)
        .attr('width', '100%').attr('height', '100%');

    const projection = d3.geoNaturalEarth1()
        .scale(w / 5.0).translate([w / 2, h / 2]);
    const path = d3.geoPath(projection);

    const tooltip    = document.getElementById('mapTooltip');
    const ttFlag     = document.getElementById('tooltipFlag');
    const ttCountry  = document.getElementById('tooltipCountry');
    const ttCount    = document.getElementById('tooltipCount');
    const ttPct      = document.getElementById('tooltipPct');

    /* intensité choroplèthe rouge original */
    const choropleth = d3.scaleThreshold()
        .domain([1, 2, 5, 10])
        .range(['#d4a0a0','#b83030','#8B0000','#6e0000','#4a0000']);

    d3.json('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json').then(world => {

        /* fond blanc original */
        svg.append('rect').attr('width', w).attr('height', h).attr('fill', '#ffffff');

        /* pays — couleurs originales */
        svg.selectAll('path')
            .data(topojson.feature(world, world.objects.countries).features)
            .join('path')
            .attr('d', path)
            .attr('fill', d => {
                const count = countById[String(d.id)] || 0;
                return count === 0 ? '#e8c4c4' : choropleth(count);
            })
            .attr('stroke', '#fff')
            .attr('stroke-width', 0.5)
            .on('mousemove', function(event, d) {
                const id    = String(d.id);
                const count = countById[id] || 0;
                if (!count) { tooltip.classList.remove('visible'); return; }
                ttFlag.textContent    = '';
                ttCountry.textContent = labelById[id] || '—';
                ttCount.textContent   = count + ' voyage' + (count > 1 ? 's' : '');
                ttPct.textContent     = Math.round((count / total) * 100) + '% du total';
                tooltip.style.left = (event.clientX + 16) + 'px';
                tooltip.style.top  = (event.clientY - 48) + 'px';
                tooltip.classList.add('visible');
                document.querySelectorAll('.map-country-item').forEach(el =>
                    el.classList.toggle('active', el.dataset.id === id));
            })
            .on('mouseleave', () => {
                tooltip.classList.remove('visible');
                document.querySelectorAll('.map-country-item').forEach(el => el.classList.remove('active'));
            });

        /* petits cercles indicateurs fixes */
        const bubbleGroup = svg.append('g');
        sorted.forEach(([id, count]) => {
            const c = centroids[id];
            if (!c) return;
            const [px, py] = projection(c);
            if (!px || !py || isNaN(px) || isNaN(py)) return;
            const r = 13;
            const g = bubbleGroup.append('g')
                .style('cursor', 'pointer')
                .on('mousemove', function(event) {
                    ttFlag.textContent    = '';
                    ttCountry.textContent = labelById[id] || '—';
                    ttCount.textContent   = count + ' voyage' + (count > 1 ? 's' : '');
                    ttPct.textContent     = Math.round((count / total) * 100) + '% du total';
                    tooltip.style.left = (event.clientX + 16) + 'px';
                    tooltip.style.top  = (event.clientY - 48) + 'px';
                    tooltip.classList.add('visible');
                    document.querySelectorAll('.map-country-item').forEach(el =>
                        el.classList.toggle('active', el.dataset.id === id));
                })
                .on('mouseleave', () => {
                    tooltip.classList.remove('visible');
                    document.querySelectorAll('.map-country-item').forEach(el => el.classList.remove('active'));
                });

            g.append('circle')
                .attr('cx', px).attr('cy', py).attr('r', r)
                .attr('class', 'map-bubble');

            g.append('text')
                .attr('x', px).attr('y', py)
                .attr('class', 'map-bubble-label')
                .text(count);
        });
    });
})();

/* ══════════════════════════════════════════════════════════════
   2. DURÉE PAR DESTINATION — ligne
