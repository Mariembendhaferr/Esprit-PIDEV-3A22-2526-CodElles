{% extends 'base.html.twig' %}

{% block title %}Paiement de la réservation{% endblock %}

{% block body %}

<!-- Hero Banner -->
<div style="background: linear-gradient(135deg, #6B1E1E 0%, #8B2C2C 50%, #6B1E1E 100%); padding: 35px 20px; text-align: center; color: white;">
    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; margin: 0; letter-spacing: 2px;">💳 Paiement de votre voyage</h2>
    <p style="font-family: 'Montserrat', sans-serif; font-size: 12px; letter-spacing: 3px; margin: 8px 0 0; opacity: 0.85; text-transform: uppercase;">Finalisez votre réservation en toute sécurité</p>
</div>

<!-- Contenu -->
<div style="background: linear-gradient(rgba(254,246,232,0.75), rgba(250,240,220,0.80)), url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1600') center/cover no-repeat; padding: 40px 20px; min-height: 60vh;">
    <div class="container">
        <div style="max-width: 960px; margin: 0 auto; background: rgba(255,255,255,0.15); border-radius: 16px; overflow: hidden; border: 1px solid rgba(212,184,150,0.4); backdrop-filter: blur(4px);">

            {% for message in app.flashes('error') %}
                <div style="background: rgba(253,240,240,0.9); border-left: 4px solid #8B2C2C; padding: 12px 24px; font-family: 'Montserrat', sans-serif; font-size: 13px; color: #8B2C2C;">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('info') %}
                <div style="background: rgba(240,248,253,0.9); border-left: 4px solid #9B7240; padding: 12px 24px; font-family: 'Montserrat', sans-serif; font-size: 13px; color: #9B7240;">{{ message }}</div>
            {% endfor %}

            {{ form_start(form) }}

                <div class="row g-0">

                    <!-- ===== Colonne gauche : Récapitulatif ===== -->
                    <div class="col-md-6" style="padding: 30px; border-right: 1px solid rgba(240,232,216,0.5); background: transparent;">

                        <div style="display:flex; align-items:center; gap:10px; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 2px solid rgba(240,232,216,0.6);">
                            <div style="width:36px; height:36px; background:#8B2C2C; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <i class="bi bi-journal-text" style="color:white; font-size:16px;"></i>
                            </div>
                            <h3 style="font-family:'Playfair Display',serif; color:#6B1E1E; font-size:1.05rem; margin:0;">Récapitulatif</h3>
                        </div>

                        <div style="background: rgba(255,255,255,0.7); border-radius: 10px; padding: 20px; border: 1px solid rgba(212,184,150,0.5);">

                            <div style="display:flex; align-items:center; gap:8px; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(212,184,150,0.3);">
                                <i class="fa fa-map-marker-alt" style="color:#8B2C2C; width:16px;"></i>
                                <span style="font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9B7240;">Destination</span>
                            </div>
                            <p style="font-family:'Playfair Display',serif; font-size:1.1rem; color:#3f2c24; margin:0 0 16px 24px; font-style:italic;">{{ reservation.voyage.destination }}</p>

                            <div style="display:flex; align-items:center; gap:8px; margin-bottom: 10px;">
                                <i class="fa fa-calendar-alt" style="color:#8B2C2C; width:16px; flex-shrink:0;"></i>
                                <span style="font-family:'Montserrat',sans-serif; font-size:11px; color:#3f2c24;">
                                    Du <strong>{{ reservation.dateDepart|date('d/m/Y') }}</strong> au <strong>{{ reservation.dateRetour|date('d/m/Y') }}</strong>
                                </span>
                            </div>

                            <div style="display:flex; align-items:center; gap:8px; margin-bottom: 10px;">
                                <i class="fa fa-users" style="color:#8B2C2C; width:16px; flex-shrink:0;"></i>
                                <span style="font-family:'Montserrat',sans-serif; font-size:11px; color:#3f2c24;">
                                    <strong>{{ reservation.nombrePersonnes }}</strong> personne(s)
                                </span>
                            </div>

                            <div style="background: linear-gradient(135deg, #6B1E1E, #8B2C2C); border-radius: 8px; padding: 16px; margin-top: 16px; text-align: center;">
                                <div style="font-family:'Montserrat',sans-serif; font-size:9px; letter-spacing:2px; text-transform:uppercase; color:rgba(232,221,201,0.8); margin-bottom:4px;">Montant total</div>
                                <div style="font-family:'Playfair Display',serif; font-size:1.8rem; color:#E8DDC9; font-weight:600;">
                                    {{ reservation.montantTotal|number_format(2, ',', ' ') }} €
                                </div>
                            </div>

                            <div style="display:flex; align-items:center; justify-content:center; gap:6px; margin-top:12px;">
                                <i class="fa fa-lock" style="color:#9B7240; font-size:11px;"></i>
                                <span style="font-family:'Montserrat',sans-serif; font-size:10px; color:#9B7240; letter-spacing:0.5px;">Paiement 100% sécurisé</span>
                            </div>
                        </div>
                    </div>

                    <!-- ===== Colonne droite : Paiement ===== -->
                    <div class="col-md-6" style="padding: 30px; background: transparent;">

                        <div style="display:flex; align-items:center; gap:10px; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 2px solid rgba(240,232,216,0.6);">
                            <div style="width:36px; height:36px; background:#8B2C2C; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <i class="bi bi-credit-card" style="color:white; font-size:16px;"></i>
                            </div>
                            <h3 style="font-family:'Playfair Display',serif; color:#6B1E1E; font-size:1.05rem; margin:0;">Mode de paiement</h3>
                        </div>

                        <!-- Radio buttons : Carte Bancaire / PayPal -->
                        <div style="margin-bottom: 20px;">
                            <label style="font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9B7240; display:block; margin-bottom:10px;">Choisissez votre mode</label>
                            {{ form_widget(form.modePaiement) }}
                            {{ form_errors(form.modePaiement) }}
                        </div>

                        <!-- Champs carte : cachés par défaut, affichés par JS -->
                        <div id="card-fields" style="display:none; background:rgba(255,255,255,0.6); border-radius:10px; padding:18px; border:1px solid rgba(212,184,150,0.5); margin-bottom:16px;">

                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid rgba(212,184,150,0.3);">
                                <i class="bi bi-credit-card-2-front" style="color:#8B2C2C; font-size:16px;"></i>
                                <span style="font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9B7240;">Informations de carte</span>
                            </div>

                            <div style="margin-bottom:12px;">
                                <label style="font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9B7240; display:block; margin-bottom:6px;">Numéro de carte</label>
                                {{ form_widget(form.numeroCarte, {
                                    'attr': {
                                        'class': 'form-control',
                                        'style': 'border:1px solid rgba(232,221,208,0.8); border-radius:6px; padding:10px 14px; font-family:Montserrat,sans-serif; font-size:13px; color:#3f2c24; background:rgba(253,250,245,0.9); width:100%;',
                                        'placeholder': '1234 5678 9012 3456'
                                    }
                                }) }}
                                {{ form_errors(form.numeroCarte) }}
                            </div>

                            <div style="margin-bottom:12px;">
                                <label style="font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9B7240; display:block; margin-bottom:6px;">Nom du titulaire</label>
                                {{ form_widget(form.nomTitulaire, {
                                    'attr': {
                                        'class': 'form-control',
                                        'style': 'border:1px solid rgba(232,221,208,0.8); border-radius:6px; padding:10px 14px; font-family:Montserrat,sans-serif; font-size:13px; color:#3f2c24; background:rgba(253,250,245,0.9); width:100%;',
                                        'placeholder': 'NOM Prénom'
                                    }
                                }) }}
                                {{ form_errors(form.nomTitulaire) }}
                            </div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <label style="font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9B7240; display:block; margin-bottom:6px;">Expiration</label>
                                    {{ form_widget(form.expiration, {
                                        'attr': {
                                            'class': 'form-control',
                                            'style': 'border:1px solid rgba(232,221,208,0.8); border-radius:6px; padding:10px 14px; font-family:Montserrat,sans-serif; font-size:13px; color:#3f2c24; background:rgba(253,250,245,0.9); width:100%;',
                                            'placeholder': 'MM/AA'
                                        }
                                    }) }}
                                    {{ form_errors(form.expiration) }}
                                </div>
                                <div class="col-6">
                                    <label style="font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9B7240; display:block; margin-bottom:6px;">CVV</label>
                                    {{ form_widget(form.cvv, {
                                        'attr': {
                                            'class': 'form-control',
                                            'style': 'border:1px solid rgba(232,221,208,0.8); border-radius:6px; padding:10px 14px; font-family:Montserrat,sans-serif; font-size:13px; color:#3f2c24; background:rgba(253,250,245,0.9); width:100%;',
                                            'placeholder': '***'
                                        }
                                    }) }}
                                    {{ form_errors(form.cvv) }}
                                </div>
                            </div>

                        </div>

                        <!-- Bouton payer + annuler -->
                        <div style="margin-top: 24px;">
                            <button type="submit" style="width:100%; background: linear-gradient(135deg, #8B2C2C, #6B1E1E); border: none; padding: 14px 40px; font-family:'Montserrat',sans-serif; font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; border-radius:6px; color:white; cursor:pointer; box-shadow: 0 4px 15px rgba(139,44,44,0.4); margin-bottom:10px;">
                                💳 Payer {{ reservation.montantTotal|number_format(2, ',', ' ') }} €
                            </button>
                            <a href="{{ path('app_confirmation', {'id': reservation.id}) }}" style="display:block; text-align:center; font-family:'Montserrat',sans-serif; font-size:11px; color:rgba(63,44,36,0.6); text-decoration:none; padding:8px; letter-spacing:1px;">
                                ← Annuler et revenir
                            </a>
                        </div>

                    </div>
                </div>

                {{ form_rest(form) }}

            {{ form_end(form) }}

        </div>
    </div>
</div>

<!-- Script JavaScript placé APRÈS le formulaire pour garantir l'exécution -->
<script>
    (function() {
        console.log('Script de paiement chargé');
        
        // Fonction pour afficher/masquer les champs carte
        function toggleCardFields() {
            var cardFields = document.getElementById('card-fields');
            if (!cardFields) {
                console.log('card-fields non trouvé');
                return;
            }
            
            // Chercher le radio "Carte Bancaire" qui est coché
            var carteRadio = document.querySelector('input[value="Carte Bancaire"]:checked');
            
            if (carteRadio) {
                cardFields.style.display = 'block';
                console.log('✅ Champs carte affichés');
            } else {
                cardFields.style.display = 'none';
                console.log('❌ Champs carte masqués');
            }
        }
        
        // Attendre que le DOM soit complètement chargé
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                initPaymentForm();
            });
        } else {
            initPaymentForm();
        }
        
        function initPaymentForm() {
            console.log('Initialisation du formulaire de paiement');
            
            // Exécuter la fonction une première fois
            toggleCardFields();
            
            // Ajouter les écouteurs d'événements sur tous les radios
            var radios = document.querySelectorAll('input[type="radio"]');
            console.log('Radios trouvés:', radios.length);
            
            for (var i = 0; i < radios.length; i++) {
                radios[i].addEventListener('change', toggleCardFields);
                console.log('Écouteur ajouté sur:', radios[i].value);
            }
        }
    })();
</script>

{% endblock %}