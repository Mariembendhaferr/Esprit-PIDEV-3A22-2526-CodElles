{# templates/travel/innovation_demo.html.twig #}
{% extends 'base_client.html.twig' %}
{% block title %}🌍 Smart Travel Features{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">🚀 Innovative Travel Features</h1>
    
    {# 🌱 Carbon Footprint Card #}
    <div class="card mb-4 border-success">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">🌱 Eco-Travel Score</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>Flight: TUN → CDG (Economy)</h6>
                    {% if flight %}
                        <div class="display-4 text-success">{{ flight.co2_kg }} <small class="fs-6">kg CO₂</small></div>
                        <p class="text-muted">{{ flight.comparison }}</p>
                        <div class="alert alert-info">
                            🌳 Offset with <strong>{{ flight.trees_to_offset }} trees</strong><br>
                            💡 {{ flight.eco_tip }}
                        </div>
                    {% else %}
                        <p class="text-warning">⚠️ API unavailable - showing demo data</p>
                    {% endif %}
                </div>
                <div class="col-md-6 text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/3069/3069180.png" 
                         alt="Earth" class="img-fluid" style="max-height: 150px;">
                </div>
            </div>
        </div>
    </div>

    {# 🎭 Local Events Card #}
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🎭 What's Happening in Tunis?</h5>
        </div>
        <div class="card-body">
            <div class="row">
                {% for event in events %}
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <img src="{{ event.image }}" class="card-img-top" alt="{{ event.name }}" style="height: 120px; object-fit: cover;">
                        <div class="card-body">
                            <h6 class="card-title">{{ event.name }}</h6>
                            <p class="card-text small">
                                📅 {{ event.date }}<br>
                                📍 {{ event.venue }}<br>
                                🎭 {{ event.type }}
                            </p>
                            <a href="{{ event.url }}" class="btn btn-sm btn-outline-primary" target="_blank">Details</a>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="col-12">
                    <p class="text-muted">No events found for these dates.</p>
                </div>
                {% endfor %}
            </div>
            {% if demo_mode %}
                <small class="text-muted">💡 Showing demo data - connect Ticketmaster API for real events!</small>
            {% endif %}
        </div>
    </div>

    {# 🗣️ Phrase Translator Card #}
    <div class="card mb-4 border-info">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">🗣️ Travel Phrasebook (EN → FR)</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>English</th>
                            <th>French</th>
                            <th>Listen</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for en, fr in phrases %}
                        <tr>
                            <td><strong>{{ en }}</strong></td>
                            <td>{{ fr }}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" 
                                        onclick="speak('{{ fr }}')">
                                    🔊
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {# Live translator demo #}
            <hr>
            <h6>Try it yourself:</h6>
            <div class="input-group mb-3">
                <input type="text" id="translate-input" class="form-control" placeholder="Type in English...">
                <button class="btn btn-info" onclick="translateText()">Translate</button>
            </div>
            <div id="translate-result" class="alert alert-light d-none"></div>
        </div>
    </div>
</div>

<script>
// Simple text-to-speech for phrases
function speak(text) {
    if ('speechSynthesis' in window) {
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        window.speechSynthesis.speak(utterance);
    }
}

// Live translation demo
async function translateText() {
    const input = document.getElementById('translate-input').value;
    const resultDiv = document.getElementById('translate-result');
    
    if (!input) return;
    
    resultDiv.classList.remove('d-none');
    resultDiv.innerHTML = '🔄 Translating...';
    
    try {
        const response = await fetch('{{ path('app_translate_api') }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: new URLSearchParams({text: input, to: 'fr'})
        });
        const data = await response.json();
        resultDiv.innerHTML = `<strong>🇫🇷 ${data.translated}</strong>`;
    } catch (e) {
        resultDiv.innerHTML = '❌ Translation service unavailable';
    }
}
</script>
{% endblock %}