{# templates/base_admin.html.twig - Version avec block body #}
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doura Mondo - {% block title %}Administration{% endblock %}</title>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Great+Vibes&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --bordeaux: #5C0000;
            --bordeaux-light: #7A0000;
            --bordeaux-dark: #3A0000;
            --bordeaux-mid: #8B0000;
            --beige-bg: #F4F1EA;
            --beige-light: #FDFCF9;
            --gold: #C5A880;
            --gold-light: #D4BC9A;
            --text-dark: #2C2C2C;
            --text-gray: #6C6C6C;
            --white: #FFFFFF;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--beige-bg);
            color: var(--text-dark);
            height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: 250px;
            background-color: var(--bordeaux);
            color: var(--white);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            padding-top: 40px;
            border-top-right-radius: 40px;
            border-bottom-right-radius: 40px;
            position: relative;
            z-index: 10;
        }

        .brand-logo {
            text-align: center;
            margin-bottom: 40px;
            padding: 0 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-img-wrapper {
            width: 110px;
            height: auto;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-img { max-width: 100%; height: auto; display: block; }

        .brand-logo h1 {
            font-family: 'Great Vibes', cursive;
            font-size: 32px;
            font-weight: 400;
            color: var(--beige-bg);
            margin: 0;
            line-height: 1.1;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        .brand-logo p {
            font-family: 'Montserrat', sans-serif;
            font-size: 11px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--gold);
            margin-top: 5px;
            font-weight: 500;
        }

        .nav-menu {
            list-style: none;
            padding-left: 15px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            position: relative;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 16px 20px;
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-family: 'Cinzel', serif;
            font-size: 15px;
            font-weight: 600;
            border-top-left-radius: 30px;
            border-bottom-left-radius: 30px;
            transition: color 0.3s ease;
            position: relative;
            letter-spacing: 2px;
            z-index: 2;
        }

        .nav-link i { width: 32px; font-size: 20px; margin-right: 12px; text-align: center; }

        .nav-link:hover { color: var(--white); background-color: rgba(255,255,255,0.05); }

        .nav-link.active { color: var(--bordeaux); font-weight: 700; background-color: transparent !important; }
        .nav-link.active i { color: #5C0000; }

        .nav-indicator {
            position: absolute;
            left: 15px;
            right: 0;
            background-color: #F4F1EA;
            border-top-left-radius: 30px;
            border-bottom-left-radius: 30px;
            transition: top 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55), height 0.4s ease;
            z-index: 0;
            pointer-events: none;
        }

        .nav-indicator::before {
            content: '';
            position: absolute;
            top: -31px; right: -1px;
            width: 32px; height: 32px;
            background: radial-gradient(circle at 1px 1px, transparent 30px, var(--beige-bg) 30.5px);
            pointer-events: none;
        }

        .nav-indicator::after {
            content: '';
            position: absolute;
            bottom: -31px; right: -1px;
            width: 32px; height: 32px;
            background: radial-gradient(circle at 1px 31px, transparent 30px, var(--beige-bg) 30.5px);
            pointer-events: none;
        }

        /* ===== MAIN CONTENT ===== */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding: 30px;
        }
        
        /* Scrollbar personnalisée */
        .main-content::-webkit-scrollbar {
            width: 6px;
        }
        .main-content::-webkit-scrollbar-track {
            background: rgba(92,0,0,0.05);
            border-radius: 10px;
        }
        .main-content::-webkit-scrollbar-thumb {
            background: rgba(92,0,0,0.2);
            border-radius: 10px;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand-logo">
            <div class="logo-img-wrapper">
                <img src="{{ asset('img/logo.png') }}" alt="Doura Mondo Logo" class="brand-img">
            </div>
            <h1>Doura Mondo</h1>
            <p>VOYAGES D'EXCEPTION</p>
        </div>

        <nav class="nav-menu">
            <div class="nav-indicator"></div>

            <a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                <i class="fa-regular fa-window-maximize"></i>
                <span>Dashboard</span>
            </a>
            <a href="{{ path('admin_users') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_user' ? 'active' : '' }}">
                <i class="fa-regular fa-user"></i>
                <span>Utilisateurs</span>
            </a>
            <a href="#" class="nav-link">
                <i class="fa-solid fa-plane-up"></i>
                <span>Voyages</span>
            </a>
            <a href="#" class="nav-link">
                <i class="fa-regular fa-compass"></i>
                <span>Activités</span>
            </a>
            <a href="#" class="nav-link">
                <i class="fa-regular fa-calendar"></i>
                <span>Réservations</span>
            </a>
            <a href="#" class="nav-link">
                <i class="fa-regular fa-envelope"></i>
                <span>Réclamations</span>
            </a>
            <a href="{{ path('logout') }}" class="nav-link">
                <i class="fa-solid fa-sign-out-alt"></i>
                <span>Déconnexion</span>
            </a>
        </nav>
    </aside>

    <!-- ZONE PRINCIPALE -->
    <main class="main-content">
        {% block body %}{% endblock %}
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const navLinks = document.querySelectorAll('.nav-link');
            const indicator = document.querySelector('.nav-indicator');

            function moveIndicator(link) {
                const top = link.offsetTop;
                const height = link.offsetHeight;
                indicator.style.top = top + 'px';
                indicator.style.height = height + 'px';
            }

            const activeLink = document.querySelector('.nav-link.active');
            if (activeLink) setTimeout(() => moveIndicator(activeLink), 50);

            navLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    if (!this.getAttribute('href') || this.getAttribute('href') === '#') {
                        e.preventDefault();
                    }
                    navLinks.forEach(l => l.classList.remove('active'));
                    this.classList.add('active');
                    moveIndicator(this);
                });
            });
        });
    </script>

    {% block javascripts %}{% endblock %}
</body>

</html>