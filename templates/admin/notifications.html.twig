{# templates/admin/notifications.html.twig #}
{% extends "admin/base-admin.html.twig" %}

{% block title %}Notifications — Communauté{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600;700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════════════════════
   DOURA MONDO — NOTIFICATIONS ADMIN — LUXURY v7 (ESPACE RÉDUIT)
═══════════════════════════════════════════════════════════════ */
:root {
    --bd:      #5C0000;
    --bd-l:    #7A0000;
    --bd-dk:   #3A0000;
    --gold:    #C5A880;
    --gold-l:  #D4BC9A;
    --gold-dk: #A8895E;
    --beige:   #F4F1EA;
    --beige-l: #FDFCF9;
    --white:   #ffffff;
    --muted:   #8a8a9a;
    --border:  rgba(197,168,128,0.28);
    --shadow:  0 8px 40px rgba(92,0,0,0.10);
    --shadow-lg: 0 20px 50px rgba(92,0,0,0.20);
}
* { box-sizing: border-box; margin: 0; padding: 0; }

.notif-page {
    padding: 40px 48px 80px;
    background: var(--beige);
    min-height: 100vh;
    font-family: 'Jost', sans-serif;
}

/* ════════════════════ HEADER CENTRALISÉ (ESPACE RÉDUIT) ════════════════════ */
.notif-header {
    text-align: center;
    margin-bottom: 32px;
}
.notif-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-dk);
    font-weight: 600;
    margin-bottom: 12px;
}
.notif-eyebrow::before,
.notif-eyebrow::after {
    content: '';
    display: inline-block;
    width: 40px;
    height: 1px;
    background: var(--gold-dk);
    vertical-align: middle;
    margin: 0 12px;
}
.notif-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.8rem;
    color: var(--bd);
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 8px;
}
.notif-title-ornament {
    display: inline-block;
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--bd), var(--gold), var(--bd), transparent);
    border-radius: 2px;
}

/* ════════════════════ GALERIE PLEINE LARGEUR (ZOOMÉE) ════════════════════ */
.gallery-section {
    margin-bottom: 48px;
    width: 100%;
}
.gallery-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
}
.gallery-section-title {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dk);
    font-weight: 600;
}
.gallery-card-count {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    background: linear-gradient(135deg, var(--bd-dk), var(--bd));
    color: var(--gold-l);
    padding: 5px 16px;
    border-radius: 30px;
    font-weight: 600;
    letter-spacing: 0.08em;
}

.gallery-wrap {
    position: relative;
    width: 100%;
    background: transparent;
    padding: 20px 70px;
    border-radius: 28px;
}

.gallery-stage {
    position: relative;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.gallery-polaroid {
    position: absolute;
    background: #fff;
    padding: 10px 10px 28px;
    cursor: pointer;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s;
    will-change: transform;
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.4), 0 5px 15px rgba(0, 0, 0, 0.25);
    border-radius: 6px;
}
.gallery-polaroid img {
    width: 220px;
    height: 165px;
    object-fit: cover;
    display: block;
    border-radius: 3px;
}
.polaroid-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    text-align: center;
    color: var(--bd);
    font-weight: 600;
    padding-top: 10px;
    font-style: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 220px;
}
.gallery-status-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    background: rgba(0,0,0,0.65);
}
.badge-approved { background: #22a845; color: #fff; }
.badge-pending { background: #f59e0b; color: #fff; }
.badge-rejected { background: #ef4444; color: #fff; }

.gallery-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--bd);
    border: none;
    color: var(--gold-l);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.2rem;
    z-index: 40;
    box-shadow: 0 6px 20px rgba(92, 0, 0, 0.35);
    transition: all 0.2s ease;
}
.gallery-nav-btn:hover {
    background: var(--bd-dk);
    color: var(--gold);
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 8px 25px rgba(92, 0, 0, 0.45);
}
.gallery-nav-prev { left: 10px; }
.gallery-nav-next { right: 10px; }

.gallery-footer {
    text-align: center;
    margin-top: 20px;
}
.gallery-caption-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--bd);
    letter-spacing: 0.06em;
}
.gallery-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 12px;
}
.gallery-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border);
    transition: all 0.3s;
}
.gallery-dot.active {
    background: var(--bd);
    transform: scale(1.3);
}
.gallery-empty {
    text-align: center;
    padding: 80px 20px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-style: italic;
    color: var(--muted);
    background: var(--white);
    border-radius: 28px;
    border: 1px solid var(--border);
}

/* ════════════════════ FLUX NOTIFICATIONS (AVEC OMBRE RENFORCÉE) ════════════════════ */
.activity-section {
    margin-bottom: 48px;
}
.section-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
}
.section-head-label {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bd);
    font-weight: 600;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 12px;
}
.section-head-label i { color: var(--gold-dk); }
.section-head-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--border), transparent);
}

.notif-feed-card {
    background: var(--white);
    border-radius: 24px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transition: box-shadow 0.3s ease;
}
.notif-feed-card:hover {
    box-shadow: 0 25px 55px rgba(92,0,0,0.25);
}
.notif-feed-header {
    padding: 18px 24px 14px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(to right, var(--beige-l), var(--white));
}
.notif-feed-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--bd-dk);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
}
.notif-feed-title i { color: var(--gold-dk); font-size: 0.9rem; }
.notif-feed-badge {
    background: var(--bd);
    color: var(--gold-l);
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 30px;
    letter-spacing: 0.08em;
}
.notif-feed-scroll {
    height: 360px;
    overflow-y: auto;
    padding: 18px 22px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    align-content: start;
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
}
.notif-feed-scroll::-webkit-scrollbar { width: 5px; }
.notif-feed-scroll::-webkit-scrollbar-track { background: transparent; }
.notif-feed-scroll::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 5px; }

.notif-mini {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--beige-l);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
}
.notif-mini::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--bd), var(--gold));
}
.notif-mini:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(92,0,0,0.12);
}
.notif-mini-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    background: linear-gradient(135deg, rgba(197,168,128,0.18), rgba(197,168,128,0.04));
    border: 1.5px solid var(--border);
}
.notif-mini-icon.icon-heart { color: #e05a7a; }
.notif-mini-icon.icon-share { color: var(--bd); }
.notif-mini-icon.icon-star { color: var(--gold-dk); }
.notif-mini-icon.icon-photo { color: #6a8eb0; }
.notif-mini-body {
    flex: 1;
    min-width: 0;
}
.notif-mini-text {
    font-size: 0.8rem;
    color: var(--bd-dk);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 4px;
}
.notif-mini-text strong {
    color: var(--bd);
    font-weight: 600;
}
.notif-mini-time {
    font-size: 0.65rem;
    color: var(--muted);
    font-style: italic;
    font-family: 'Cormorant Garamond', serif;
}
.notif-mini-thumb {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1.5px solid var(--border);
}
.notif-status {
    font-size: 0.58rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-block;
    margin-left: 6px;
}
.status-pending {
    background: rgba(245,158,11,0.12);
    color: #b45309;
    border: 1px solid rgba(245,158,11,0.25);
}
.status-approved {
    background: rgba(34,168,69,0.10);
    color: #166534;
    border: 1px solid rgba(34,168,69,0.25);
}
.status-rejected {
    background: rgba(239,68,68,0.10);
    color: #991b1b;
    border: 1px solid rgba(239,68,68,0.25);
}
.notif-feed-empty {
    grid-column: 1 / -1;
    padding: 50px 24px;
    text-align: center;
    color: var(--muted);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-style: italic;
}
.notif-feed-empty i {
    font-size: 2rem;
    display: block;
    margin-bottom: 12px;
    opacity: 0.3;
    color: var(--gold);
}

/* ════════════════════ TOP 3 DESTINATIONS (EN BAS) ════════════════════ */
.top-section {
    margin-top: 20px;
}
.top-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
}
.top-header-label {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bd);
    font-weight: 600;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 12px;
}
.top-header-label i { color: var(--gold-dk); }
.top-header-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--border), transparent);
}

.podium-card {
    background: var(--white);
    border-radius: 24px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
}
.podium-card-header {
    padding: 18px 24px 14px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(to right, var(--beige-l), var(--white));
}
.podium-card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--bd-dk);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
}
.podium-card-title i {
    color: var(--gold-dk);
    font-size: 0.9rem;
}
.podium-count-badge {
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    background: var(--beige);
    border: 1px solid var(--border);
    color: var(--bd-dk);
    padding: 3px 12px;
    border-radius: 30px;
}
.podium-body {
    padding: 25px 20px 20px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 30px;
}
.podium-place {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    max-width: 130px;
}
.medal-hex {
    position: relative;
    width: 85px;
    height: 85px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    transition: transform 0.3s;
}
.medal-hex:hover { transform: translateY(-5px); }
.medal-hex-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
}
.medal-hex-inner i { font-size: 1.8rem; }
.medal-hex-rank {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0.8;
}
.medal-ribbon {
    position: absolute;
    top: -8px;
    display: flex;
    gap: 5px;
    justify-content: center;
}
.medal-ribbon-line {
    width: 6px;
    height: 13px;
    border-radius: 3px;
    opacity: 0.85;
}
/* Gold */
.podium-1 .medal-hex {
    background: linear-gradient(145deg, #f7e08a, #d4a017, #b8860b);
    box-shadow: 0 6px 25px rgba(212,160,23,.5);
}
.podium-1 .medal-hex-inner i,
.podium-1 .medal-hex-rank { color: #5c3900; }
/* Silver */
.podium-2 .medal-hex {
    background: linear-gradient(145deg, #e8e8f0, #b0b8cc, #8a96aa);
    box-shadow: 0 6px 25px rgba(160,168,192,.45);
}
.podium-2 .medal-hex-inner i,
.podium-2 .medal-hex-rank { color: #3a4050; }
/* Bronze */
.podium-3 .medal-hex {
    background: linear-gradient(145deg, #f0c09a, #c87941, #a05c28);
    box-shadow: 0 6px 25px rgba(180,100,40,.4);
}
.podium-3 .medal-hex-inner i,
.podium-3 .medal-hex-rank { color: #5c2800; }
.podium-dest-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--bd-dk);
    font-weight: 600;
    text-align: center;
    margin-bottom: 5px;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.podium-dest-count {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 500;
}
.podium-1 { order: 2; }
.podium-2 { order: 1; margin-bottom: 15px; }
.podium-3 { order: 3; margin-bottom: 28px; }
.podium-view-all {
    text-align: center;
    padding: 14px;
    border-top: 1px solid var(--border);
}
.podium-view-all a {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--bd);
    text-decoration: none;
    font-weight: 600;
    opacity: 0.65;
    transition: opacity 0.2s;
}
.podium-view-all a:hover { opacity: 1; }
.podium-empty {
    padding: 50px 20px;
    text-align: center;
    color: var(--muted);
    font-style: italic;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
}
.podium-empty i {
    font-size: 2rem;
    display: block;
    margin-bottom: 12px;
    opacity: 0.3;
    color: var(--gold);
}

/* Responsive */
@media (max-width: 1100px) {
    .notif-feed-scroll { grid-template-columns: repeat(2, 1fr); }
    .gallery-polaroid img { width: 180px; height: 135px; }
    .polaroid-label { width: 180px; }
    .gallery-stage { height: 330px; }
}
@media (max-width: 800px) {
    .notif-page { padding: 28px 20px 50px; }
    .notif-title { font-size: 2.5rem; }
    .gallery-wrap { padding: 20px 50px; }
    .gallery-polaroid img { width: 150px; height: 112px; }
    .polaroid-label { width: 150px; font-size: 0.8rem; }
    .gallery-stage { height: 290px; }
    .notif-feed-scroll { grid-template-columns: 1fr; height: 420px; }
    .podium-body { gap: 15px; }
    .medal-hex { width: 65px; height: 65px; }
    .medal-hex-inner i { font-size: 1.4rem; }
}
@media (max-width: 600px) {
    .gallery-nav-btn { width: 38px; height: 38px; font-size: 0.9rem; }
    .gallery-nav-prev { left: 5px; }
    .gallery-nav-next { right: 5px; }
    .gallery-polaroid img { width: 130px; height: 98px; }
    .polaroid-label { width: 130px; font-size: 0.7rem; }
    .gallery-stage { height: 260px; }
    .podium-body { flex-direction: column; align-items: center; gap: 20px; }
    .podium-place { max-width: 150px; width: 100%; }
    .podium-1, .podium-2, .podium-3 { order: unset; margin-bottom: 0; }
}
</style>
{% endblock %}

{% block content %}
<div class="notif-page">

    {# ════════════════════ HEADER CENTRALISÉ (SANS STATS) ════════════════════ #}
    <div class="notif-header">
        <div class="notif-eyebrow">Partages & découvertes</div>
        <h1 class="notif-title">Découvrez vos Flux des Partages</h1>
        <div class="notif-title-ornament"></div>
    </div>

    {# ════════════════════ GALERIE PHOTOS PLEINE LARGEUR ════════════════════ #}
    <div class="gallery-section">
        <div class="gallery-section-header">
            <div class="gallery-section-title">
                <i class="fa-solid fa-camera-retro"></i> Photos partagées par la communauté
            </div>
            <span class="gallery-card-count">{{ approvedPosts|length }} approuvées</span>
        </div>

        {% if allPosts is empty %}
            <div class="gallery-empty">
                <i class="fa-regular fa-image" style="font-size:2.8rem;opacity:.3;display:block;margin-bottom:12px;"></i>
                Aucune photo partagée pour le moment.
            </div>
        {% else %}
            <div class="gallery-wrap">
                <div class="gallery-stage" id="galleryStage">
                    <button class="gallery-nav-btn gallery-nav-prev" onclick="galleryScroll(-1)">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>

                    {% for post in allPosts|slice(0,9) %}
                    <div class="gallery-polaroid" data-idx="{{ loop.index0 }}" data-dest="{{ post.destination }}">
                        <img src="{{ asset(post.imageUrl) }}" alt="{{ post.destination }}" loading="lazy">
                        <div class="gallery-status-badge {% if post.moderationStatus=='approved' %}badge-approved{% elseif post.moderationStatus=='pending' %}badge-pending{% else %}badge-rejected{% endif %}">
                            {% if post.moderationStatus=='approved' %}<i class="fa-solid fa-check"></i>
                            {% elseif post.moderationStatus=='pending' %}<i class="fa-solid fa-clock"></i>
                            {% else %}<i class="fa-solid fa-xmark"></i>{% endif %}
                        </div>
                        <div class="polaroid-label">{{ post.destination }}</div>
                    </div>
                    {% endfor %}

                    <button class="gallery-nav-btn gallery-nav-next" onclick="galleryScroll(1)">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>

                <div class="gallery-footer">
                    <div class="gallery-caption-text" id="galCaption"></div>
                    <div class="gallery-dots" id="galDots"></div>
                </div>
            </div>
        {% endif %}
    </div>

    {# ════════════════════ FLUX NOTIFICATIONS ════════════════════ #}
    <div class="activity-section">
        <div class="section-head">
            <div class="section-head-label"><i class="fa-solid fa-bell"></i> Activité de la communauté</div>
            <div class="section-head-line"></div>
        </div>

        <div class="notif-feed-card">
            <div class="notif-feed-header">
                <div class="notif-feed-title"><i class="fa-solid fa-rss"></i> Nouvelles expériences partagées</div>
                {% if allPosts|length > 0 %}
                <span class="notif-feed-badge">{{ allPosts|length }} activités</span>
                {% endif %}
            </div>
            <div class="notif-feed-scroll">
                {% if allPosts is empty %}
                    <div class="notif-feed-empty"><i class="fa-regular fa-bell-slash"></i>Aucune activité récente.</div>
                {% else %}
                    {% for post in allPosts|slice(0,30) %}
                    {% set itype = loop.index % 4 %}
                    <div class="notif-mini">
                        <div class="notif-mini-icon icon-{% if itype==0 %}heart{% elseif itype==1 %}share{% elseif itype==2 %}star{% else %}photo{% endif %}">
                            {% if itype==0 %}<i class="fa-solid fa-heart"></i>
                            {% elseif itype==1 %}<i class="fa-solid fa-paper-plane"></i>
                            {% elseif itype==2 %}<i class="fa-solid fa-star"></i>
                            {% else %}<i class="fa-solid fa-camera"></i>{% endif %}
                        </div>
                        <img class="notif-mini-thumb" src="{{ asset(post.imageUrl) }}" alt="{{ post.destination }}">
                        <div class="notif-mini-body">
                            <div class="notif-mini-text">
                                Un nouvel utilisateur a partagé son expérience à <strong>{{ post.destination }}</strong>
                                <span class="notif-status status-{{ post.moderationStatus }}">
                                    {{ post.moderationStatus=='approved' ? 'Approuvée' : (post.moderationStatus=='pending' ? 'En attente' : 'Rejetée') }}
                                </span>
                            </div>
                            <div class="notif-mini-time">
                                <i class="fa-regular fa-clock" style="font-size:0.55rem;"></i>
                                {{ post.submittedAt|date('d/m/Y') }} · {{ post.submittedAt|date('H:i') }}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    {# ════════════════════ TOP 3 DESTINATIONS ════════════════════ #}
    <div class="top-section">
        <div class="top-header">
            <div class="top-header-label"><i class="fa-solid fa-trophy"></i> Top destinations</div>
            <div class="top-header-line"></div>
        </div>

        <div class="podium-card">
            <div class="podium-card-header">
                <div class="podium-card-title"><i class="fa-solid fa-medal"></i> Classement des destinations préférées</div>
                {% if topDestinations is not empty %}
                <span class="podium-count-badge">{{ topDestinations|length }} destinations</span>
                {% endif %}
            </div>
            {% if topDestinations is empty %}
                <div class="podium-empty">
                    <i class="fa-solid fa-trophy"></i>
                    Pas encore de données.
                </div>
            {% else %}
                <div class="podium-body">
                    {% set medalIcons = ['fa-crown','fa-medal','fa-award'] %}
                    {% set ordered = [1,0,2] %}
                    {% for idx in ordered %}
                        {% if topDestinations[idx] is defined %}
                        {% set dest = topDestinations[idx] %}
                        {% set rank = idx + 1 %}
                        <div class="podium-place podium-{{ rank }}">
                            <div class="medal-hex">
                                <div class="medal-ribbon">
                                    <div class="medal-ribbon-line"></div>
                                    <div class="medal-ribbon-line"></div>
                                    <div class="medal-ribbon-line"></div>
                                </div>
                                <div class="medal-hex-inner">
                                    <i class="fa-solid {{ medalIcons[idx] }}"></i>
                                    <span class="medal-hex-rank">#{{ rank }}</span>
                                </div>
                            </div>
                            <div class="podium-dest-name" title="{{ dest.destination }}">{{ dest.destination }}</div>
                            <div class="podium-dest-count">{{ dest.cnt }} photo{{ dest.cnt > 1 ? 's' : '' }}</div>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="podium-view-all"><a href="#">VOIR TOUT LE CLASSEMENT ›</a></div>
            {% endif %}
        </div>
    </div>

</div>

<script>
/* ── Galerie Polaroïds ── */
(function(){
    document.addEventListener('DOMContentLoaded',function(){
        const stage=document.getElementById('galleryStage');
        if(!stage)return;
        const cards=Array.from(stage.querySelectorAll('.gallery-polaroid'));
        const total=cards.length;if(!total)return;
        const P=[
            {tx:-360,rot:-14,sc:.64,z:1},{tx:-245,rot:-8,sc:.73,z:2},{tx:-130,rot:-4,sc:.85,z:3},
            {tx:0,rot:0,sc:1,z:5},
            {tx:130,rot:4,sc:.85,z:3},{tx:245,rot:8,sc:.73,z:2},{tx:360,rot:14,sc:.64,z:1}
        ];
        let center=Math.min(3,Math.floor(total/2));
        const dotsEl=document.getElementById('galDots');
        const capEl=document.getElementById('galCaption');
        function buildDots(){
            if(!dotsEl)return;dotsEl.innerHTML='';
            cards.forEach((_,i)=>{const d=document.createElement('div');d.className='gallery-dot'+(i===center?' active':'');dotsEl.appendChild(d);});
        }
        function render(){
            if(dotsEl)dotsEl.querySelectorAll('.gallery-dot').forEach((d,i)=>d.classList.toggle('active',i===center));
            if(capEl)capEl.textContent=cards[center].dataset.dest||'';
            cards.forEach((card,idx)=>{
                const off=idx-center;
                if(Math.abs(off)>3){card.style.opacity='0';card.style.pointerEvents='none';return;}
                const pos=P[off+3];
                card.style.opacity='1';card.style.pointerEvents='auto';
                card.style.transform=`translateX(${pos.tx}px) rotate(${pos.rot}deg) scale(${pos.sc})`;
                card.style.zIndex=String(pos.z);
                if(off===0){
                    card.onmouseenter=()=>{card.style.transform='translateX(0) rotate(0deg) scale(1.08) translateY(-15px)';card.style.zIndex='20';};
                    card.onmouseleave=()=>{card.style.transform='translateX(0) rotate(0deg) scale(1)';card.style.zIndex='5';};
                } else { card.onmouseenter=null;card.onmouseleave=null; }
            });
        }
        window.galleryScroll=function(dir){center=Math.max(0,Math.min(total-1,center+dir));render();};
        buildDots();render();
    });
})();
</script>
{% endblock %}