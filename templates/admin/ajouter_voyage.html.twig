function onContinentChange(val) {
    const badge = document.getElementById('preview-continent-badge');
    if (badge) badge.innerHTML = `<i class="fa-solid fa-globe"></i> ${val || 'Destination'}`;

    let destInput = document.getElementById('destination');
    if (!destInput) destInput = document.querySelector('[name*="destination"]');
    if (destInput && destInput.value.trim()) {
        validerPays(destInput.value.trim());
    }

    const errCont = document.getElementById('err-continent');
    if (errCont && val) errCont.textContent = '';

    if (leafletMap && document.getElementById('map-overlay').classList.contains('actif')) {
        appliquerStyleContinent(val);
        appliquerZoomContinent(val);
        
        const hint = document.getElementById('map-continent-hint');
        if (hint && val) {
            hint.innerHTML = `<i class="fa-solid fa-check-circle"></i> ✅ Continent sélectionné : <strong>${val}</strong> — Cliquez sur un pays pour le sélectionner.`;
            hint.style.color = '#2e7d32';
            hint.style.background = 'rgba(46,125,50,0.1)';
        }
    }
}

function validerPays(pays) {
    const contChoisi = getCurrentContinent();
    const contDuPays = PAYS_CONTINENT[pays];
    const errEl = document.getElementById('err-destination');
    let destInput = document.getElementById('destination');
    if (!destInput) destInput = document.querySelector('[name*="destination"]');

    if (!contChoisi) {
        if (errEl) { errEl.className = 'field-error'; errEl.textContent = '⚠ Sélectionnez d\'abord un continent'; }
        return false;
    }

    if (!contDuPays) {
        if (errEl) { errEl.className = 'field-error'; errEl.textContent = `⚠ "${pays}" non reconnu dans notre base`; }
        if (destInput) destInput.classList.remove('input-error');
        return true;
    }

    if (contChoisi !== contDuPays) {
        if (errEl) {
            errEl.className = 'field-error';
            errEl.textContent = `❌ ${pays} est en ${contDuPays}, pas en ${contChoisi}`;
        }
        if (destInput) destInput.classList.add('input-error');
        return false;
    }

    if (errEl) { errEl.className = 'field-error field-ok'; errEl.textContent = `✓ ${pays} — ${contDuPays}`; }
    if (destInput) destInput.classList.remove('input-error');
    return true;
}

