function validateTitreEnDirect(input) {
    const errSpan = document.getElementById('err-titre');
    const valeur = input.value;
    const longueur = valeur.length;
    
    // Met à jour l'aperçu
    updateTitle(valeur);
    
    // Cas 1 : Champ vide
    if (longueur === 0) {
        if (errSpan) {
            errSpan.textContent = '';
            errSpan.className = 'field-error';
        }
        input.classList.remove('input-error');
        return false;
    }
    
    // Cas 2 : Vérifier les caractères autorisés (lettres, espaces, tirets, apostrophes)
    const regexCaracteres = /^[a-zA-ZÀ-ÿ\s\-\']+$/;
    if (!regexCaracteres.test(valeur)) {
        if (errSpan) {
            errSpan.textContent = '⚠ Le titre doit contenir uniquement des lettres, espaces, tirets ou apostrophes';
            errSpan.className = 'field-error';
        }
        input.classList.add('input-error');
        return false;
    }
    
    // Cas 3 : Vérifier la longueur minimale de 25 caractères
    if (longueur < 25) {
        if (errSpan) {
            errSpan.textContent = `⚠ Le titre doit contenir au moins 25 caractères (actuellement : ${longueur}/25)`;
            errSpan.className = 'field-error';
        }
        input.classList.add('input-error');
        return false;
    }
    
    // Cas 4 : ✅ Tout est valide
    if (errSpan) {
        errSpan.textContent = `✓ ${longueur}/25 caractères - Titre valide`;
        errSpan.className = 'field-error field-ok';
    }
    input.classList.remove('input-error');
    return true;
}

function validatePositif(input, errId) {
    const err = document.getElementById(errId);
    const val = parseFloat(input.value);
    if (isNaN(val) || val < 1) {
        if (err) err.textContent = '⚠ Valeur doit être > 0';
        return false;
    }
    if (err) err.textContent = '';
    return true;
}

function validateImageUrl(input) {
    const err = document.getElementById('err-image');
    if (!input.value.trim()) { if (err) err.textContent = ''; return true; }
    if (!/\.(jpg|jpeg|png)$/i.test(input.value)) {
        if (err) err.textContent = '⚠ Doit se terminer par .jpg, .jpeg ou .png';
        return false;
    }
    if (err) err.textContent = '';
    return true;
}

