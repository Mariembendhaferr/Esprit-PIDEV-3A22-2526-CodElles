    }
    
    const continent = continentSelect ? continentSelect.value : '';
    console.log('Continent récupéré :', continent); // Debug
    
    // 🔥 Récupérer la destination
    let destInput = document.getElementById('destination');
    if (!destInput) destInput = document.querySelector('[name*="destination"]');
    const dest = destInput ? destInput.value.trim() : '';
    
    const errCont = document.getElementById('err-continent');
    
    // 🔥 Vérifier le continent - accepter "Europe", "Afrique", etc.
    // Ne pas rejeter si c'est une valeur valide
    const continentsValides = ['Europe', 'Afrique', 'Asie', 'Amériques', 'Océanie'];
    const continentValide = continentsValides.includes(continent);
    
    if (!continent || !continentValide) {
        if (errCont) errCont.textContent = '⚠ Choisissez un continent';
        valid = false;
        console.log('Continent invalide :', continent);
    } else {
        if (errCont) errCont.textContent = '';
        console.log('Continent valide :', continent);
    }
    
    // Vérifier la destination
    if (!dest) {
        const errDest = document.getElementById('err-destination');
        if (errDest) errDest.textContent = '⚠ Entrez une destination';
        valid = false;
        console.log('Destination vide');
    } else {
        // Valider que le pays correspond au continent
        const contDuPays = PAYS_CONTINENT[dest];
        if (continent && contDuPays && contDuPays !== continent) {
            const errDest = document.getElementById('err-destination');
            if (errDest) errDest.textContent = `❌ ${dest} est en ${contDuPays}, pas en ${continent}`;
            valid = false;
            console.log('Continent du pays ne correspond pas');
        } else {
            const errDest = document.getElementById('err-destination');
            if (errDest) errDest.textContent = '';
        }
    }
    
    console.log('Validation finale :', valid);
    
    // Afficher un message si le formulaire est invalide
    if (!valid) {
        const firstError = document.querySelector('.input-error, .field-error:not(:empty)');
        if (firstError) {
            firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return false;
    }
    // ✅ Valide → modal puis soumission
    const overlay = document.getElementById('success-overlay');
    overlay.style.display = 'flex';
    setTimeout(() => {
        document.getElementById('success-bar').style.width = '100%';
    }, 50);
    setTimeout(() => {
        document.getElementById('voyage-form').submit();
    }, 2100);

    return false;
    
    return true;
}

// ═══════════════════════════════════════════════════════════════════
// PREVIEW
// ═══════════════════════════════════════════════════════════════════
function updateTitle(val) {
    const el = document.getElementById('preview-title');
    if (el) el.textContent = val || 'Le Titre...';
}

function updateStat(id, val) {
    const el = document.getElementById(id);
    if (!el) return;
    if (val) { el.textContent = val; el.classList.remove('empty'); }
    else { el.textContent = '—'; el.classList.add('empty'); }
}

function updateBgFromUrl(url) {
    const bg = document.getElementById('preview-bg');
    if (bg && url && /\.(jpg|jpeg|png)$/i.test(url)) {
        bg.style.backgroundImage = `url('${url}')`;
    }
}

function handleUpload(input) {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        const bg = document.getElementById('preview-bg');
        if (bg) bg.style.backgroundImage = `url('${e.target.result}')`;
    };
    reader.readAsDataURL(file);
}

// ═══════════════════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
    let destInput = document.getElementById('destination');
    if (!destInput) destInput = document.querySelector('[name*="destination"]');
    if (destInput) {
        destInput.addEventListener('blur', () => fermerAutocomplete());
    }
    
    // Initialiser le badge preview avec le continent par défaut
    const initialCont = getCurrentContinent();
    if (initialCont) {
        const badge = document.getElementById('preview-continent-badge');
        if (badge) badge.innerHTML = `<i class="fa-solid fa-globe"></i> ${initialCont}`;
    }
});

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') fermerMap();
});

console.log("✅ Doura Mondo — Carte + Autocomplete initialisés");
</script>
