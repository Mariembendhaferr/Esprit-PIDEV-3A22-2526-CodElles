// FONCTION POUR RÉCUPÉRER LE CONTINENT (ROBUSTE)
// ═══════════════════════════════════════════════════════════════════
function getCurrentContinent() {
    // Essayer plusieurs façons de récupérer le champ continent
    let continentField = document.getElementById('continent');
    
    if (!continentField || !continentField.value) {
        continentField = document.querySelector('[name="voyage[continent]"]');
    }
    
    if (!continentField || !continentField.value) {
        continentField = document.querySelector('select[name*="continent"]');
    }
    
    if (!continentField || !continentField.value) {
        continentField = document.querySelector('#continent-select');
    }
    
    const value = continentField ? continentField.value : '';
    console.log('🌍 Continent récupéré :', value);
    
    // Ignorer le placeholder
    if (value && value !== '' && value !== 'Choisir...') {
        return value;
    }
    
    return '';
}

// ═══════════════════════════════════════════════════════════════════
// AUTOCOMPLETE — filtrage local
// ═══════════════════════════════════════════════════════════════════
const PAYS_LISTE = Object.keys(PAYS_CONTINENT).sort();
let acActiveIndex = -1;

function onDestinationInput(query) {
    const list  = document.getElementById('autocomplete-list');
    const contChoisi = getCurrentContinent();

    if (!query || query.length < 1) {
        fermerAutocomplete();
        return;
    }

    const normalized = query.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    const filtered = PAYS_LISTE.filter(p => {
        const pNorm = p.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        return pNorm.startsWith(normalized);
    }).slice(0, 8);

    const filtered2 = filtered.length > 0 ? filtered : PAYS_LISTE.filter(p => {
        const pNorm = p.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        return pNorm.includes(normalized);
    }).slice(0, 8);

    if (filtered2.length === 0) { fermerAutocomplete(); return; }

    list.innerHTML = '';
    acActiveIndex = -1;

    filtered2.forEach(pays => {
        const cont = PAYS_CONTINENT[pays] || '';
        const incompatible = contChoisi && cont && cont !== contChoisi;
        const li = document.createElement('li');
        if (incompatible) li.classList.add('incompatible');

        li.innerHTML = `<span>${pays}</span><span class="continent-badge">${cont}</span>`;
        li.title = incompatible ? `${pays} est en ${cont}, pas en ${contChoisi}` : `Sélectionner ${pays}`;

        li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            if (incompatible) {
                const errEl = document.getElementById('err-destination');
                if (errEl) errEl.textContent = `❌ ${pays} appartient à ${cont}, pas à ${contChoisi}`;
                return;
            }
            selectionnerPays(pays);
        });

        list.appendChild(li);
    });

    list.style.display = 'block';
}

function navigerSuggestions(e) {
    const list  = document.getElementById('autocomplete-list');
    const items = list ? list.querySelectorAll('li:not(.incompatible)') : [];
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
        e.preventDefault();
        acActiveIndex = Math.min(acActiveIndex + 1, items.length - 1);
    } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        acActiveIndex = Math.max(acActiveIndex - 1, 0);
    } else if (e.key === 'Enter' && acActiveIndex >= 0) {
        e.preventDefault();
        items[acActiveIndex].dispatchEvent(new MouseEvent('mousedown'));
        return;
    } else if (e.key === 'Escape') {
        fermerAutocomplete();
        return;
    } else {
        return;
    }

    items.forEach((item, i) => {
        item.classList.toggle('active', i === acActiveIndex);
        if (i === acActiveIndex) item.scrollIntoView({ block: 'nearest' });
    });
}

let acSelecting = false; // flag pour bloquer le blur pendant une sélection

function fermerAutocomplete() {
    setTimeout(() => {
        if (acSelecting) return; // ne pas fermer si une sélection est en cours
        const list = document.getElementById('autocomplete-list');
        if (list) list.style.display = 'none';
        acActiveIndex = -1;
    }, 150);
}

function selectionnerPays(pays) {
    acSelecting = true; // bloquer le blur

    let destField = document.getElementById('destination');
    if (!destField) destField = document.querySelector('[name*="destination"]');
    if (destField) {
        destField.value = pays;
    }

    // Fermer immédiatement la liste AVANT de dispatcher l'event input
    const list = document.getElementById('autocomplete-list');
    if (list) list.style.display = 'none';
    acActiveIndex = -1;

    // Mettre à jour l'aperçu
    const previewDest = document.getElementById('preview-dest');
    if (previewDest) previewDest.textContent = pays;

    // Valider le pays
    validerPays(pays);

    acSelecting = false; // libérer le flag
}

