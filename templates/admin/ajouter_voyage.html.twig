function stylePays(feature, contActif) {
    const nomEN = feature.properties?.NAME || feature.properties?.ADMIN || feature.properties?.name || '';
    const nomFR = EN_TO_FR[nomEN] || nomEN;
    const contPays = PAYS_CONTINENT[nomFR] || '';
    const actif = !contActif || contPays === contActif;

    return actif
        ? { fillColor: '#8B0000', fillOpacity: 0.55, color: '#C5A880', weight: 1.2 }
        : { fillColor: '#d4c9b8', fillOpacity: 0.35, color: '#b0a898', weight: 0.5 };
}

function appliquerStyleContinent(cont) {
    if (!geoLayer) return;
    geoLayer.eachLayer(layer => {
        if (layer.feature) {
            layer.setStyle(stylePays(layer.feature, cont));
        }
    });
}

function appliquerZoomContinent(cont) {
    if (!leafletMap) return;
    if (cont && CONTINENT_VIEW[cont]) {
        const v = CONTINENT_VIEW[cont];
        leafletMap.setView(v.center, v.zoom, { animate: true, duration: 0.8 });
    } else {
        leafletMap.setView([20, 0], 2, { animate: true });
    }
}

function fermerMap() {
    const overlay = document.getElementById('map-overlay');
    if (overlay) overlay.classList.remove('actif');
    document.body.style.overflow = '';
}

