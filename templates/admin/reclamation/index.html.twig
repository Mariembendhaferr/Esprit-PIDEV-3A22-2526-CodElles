{% extends 'admin/layout.html.twig' %}

{% block title %}Réclamations{% endblock %}
{% block admin_heading %}Réclamations{% endblock %}

{% block admin_body %}
<div class="admin-crud-head">
    <p class="admin-crud-title mb-0">Suivi des réclamations et demandes clients</p>
    <div class="admin-crud-head-actions">
        <button type="button" class="admin-btn-primary" data-bs-toggle="modal" data-bs-target="#modalHistoriqueReclamation" id="btn-historique-reclamation">
            <i class="fas fa-history" aria-hidden="true"></i> Historique
        </button>
        <a href="{{ path('app_admin_reclamations_new') }}" class="admin-btn-primary"><i class="fas fa-plus"></i> Nouvelle réclamation</a>
    </div>
</div>

<div class="modal fade admin-historique-root" id="modalHistoriqueReclamation" tabindex="-1" aria-labelledby="modalHistoriqueReclamationLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable admin-modal-dialog admin-modal-dialog--historique">
        <div class="modal-content admin-modal-card">
            <div class="modal-header admin-modal-card__header">
                <div class="admin-modal-card__title-row">
                    <span class="admin-modal-card__icon" aria-hidden="true"><i class="fas fa-history"></i></span>
                    <div>
                        <h2 class="admin-modal-card__heading" id="modalHistoriqueReclamationLabel">Historique des ajouts</h2>
                        <p class="admin-modal-card__subheading">Demandeur, titre, réponses administration</p>
                    </div>
                </div>
                <button type="button" class="admin-modal-card__close" data-bs-dismiss="modal" aria-label="Fermer">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-body admin-modal-card__body">
                <p class="admin-modal-card__notice"><i class="fas fa-info-circle" aria-hidden="true"></i> Entrées correspondant aux <strong>filtres actuels</strong> de la liste.</p>
                <div class="admin-historique-table-shell">
                    <div class="table-responsive">
                        <table class="admin-historique-table">
                            <thead>
                                <tr>
                                    <th scope="col">Prénom</th>
                                    <th scope="col">Nom</th>
                                    <th scope="col">Date d’ajout</th>
                                    <th scope="col">Titre</th>
                                    <th scope="col">Réponses</th>
                                </tr>
                            </thead>
                            <tbody id="modal-historique-reclamation-tbody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer admin-modal-card__footer admin-modal-card__footer--split">
                <a href="{{ path('app_admin_reclamations_historique_pdf') }}"
                   class="admin-btn-secondary admin-modal-card__footer-btn"
                   id="btn-historique-pdf-export"
                   data-pdf-base="{{ path('app_admin_reclamations_historique_pdf') }}">
                    <i class="fas fa-file-pdf" aria-hidden="true"></i> Exporter en PDF
                </a>
                <button type="button" class="admin-btn-primary admin-modal-card__footer-btn" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade admin-repondre-root" id="modalRepondreReclamation" tabindex="-1" aria-labelledby="modalRepondreReclamationLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable admin-modal-dialog admin-modal-dialog--reply">
        <div class="modal-content admin-modal-card admin-modal-card--reply">
            <div class="modal-header admin-modal-card__header">
                <div class="admin-modal-card__title-row">
                    <span class="admin-modal-card__icon admin-modal-card__icon--reply" aria-hidden="true"><i class="fas fa-reply"></i></span>
                    <div>
                        <h2 class="admin-modal-card__heading" id="modalRepondreReclamationLabel">Répondre au demandeur</h2>
                        <p class="admin-modal-card__subheading" id="repondre-modal-titre-display"></p>
                    </div>
                </div>
                <button type="button" class="admin-modal-card__close" data-bs-dismiss="modal" aria-label="Fermer">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <form id="form-repondre-reclamation" method="post" action="">
                <div class="modal-body admin-modal-card__body">
                    <p class="admin-modal-card__notice"><i class="fas fa-envelope" aria-hidden="true"></i> Un e-mail personnalisé sera envoyé au demandeur. Le statut passera à <strong>Traité</strong> et la réponse sera enregistrée dans la base.</p>
                    <label class="admin-modal-card__field-label" for="repondre-contenu">Votre réponse</label>
                    <textarea id="repondre-contenu" name="contenu" class="form-control admin-modal-card__textarea" rows="8" required minlength="10" maxlength="10000" placeholder="Message au voyageur (minimum 10 caractères)…"></textarea>
                    <input type="hidden" name="_token" id="repondre-form-token" value="">
                </div>
                <div class="modal-footer admin-modal-card__footer admin-modal-card__footer--split">
                    <button type="button" class="admin-btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="admin-btn-primary"><i class="fas fa-paper-plane"></i> Envoyer et clôturer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form method="get" id="admin-reclamation-filters" class="admin-filter-bar" action="{{ path('app_admin_reclamations') }}">
    <div class="admin-filter-bar-inner">
        <div class="admin-filter-field admin-filter-field--grow">
            <label class="admin-filter-label" for="filter-q-rec">Recherche</label>
            <input type="search" name="q" id="filter-q-rec" class="form-control admin-filter-input" value="{{ filter_q }}" placeholder="Titre, description, nom…" autocomplete="off">
        </div>
        <div class="admin-filter-field">
            <label class="admin-filter-label" for="filter-statut-rec">Statut</label>
            <select name="statut" id="filter-statut-rec" class="form-select admin-filter-select">
                <option value="">Tous</option>
                <option value="En attente" {{ filter_statut == 'En attente' ? 'selected' }}>En attente</option>
                <option value="En cours" {{ filter_statut == 'En cours' ? 'selected' }}>En cours</option>
                <option value="Traité" {{ filter_statut == 'Traité' ? 'selected' }}>Traité</option>
            </select>
        </div>
        <div class="admin-filter-field">
            <label class="admin-filter-label" for="filter-prio-rec">Priorité</label>
            <select name="priorite" id="filter-prio-rec" class="form-select admin-filter-select">
                <option value="">Toutes</option>
                <option value="Faible" {{ filter_priorite == 'Faible' ? 'selected' }}>Faible</option>
                <option value="Moyenne" {{ filter_priorite == 'Moyenne' ? 'selected' }}>Moyenne</option>
                <option value="Élevée" {{ filter_priorite == 'Élevée' ? 'selected' }}>Élevée</option>
            </select>
        </div>
        <div class="admin-filter-field admin-filter-field--action">
            <span class="admin-filter-label admin-filter-label--spacer" aria-hidden="true">&nbsp;</span>
            <a href="{{ path('app_admin_reclamations') }}" class="admin-filter-reset">Réinitialiser</a>
        </div>
    </div>
    <p class="admin-filter-hint mb-0"><i class="fas fa-info-circle"></i> La recherche et les filtres s’appliquent automatiquement (liste mise à jour sans recharger la page).</p>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Demandeur</th>
                <th>Titre</th>
                <th>Statut</th>
                <th>Priorité</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="admin-reclamation-tbody">
            {% include 'admin/reclamation/_table_rows.html.twig' %}
        </tbody>
    </table>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var form = document.getElementById('admin-reclamation-filters');
    var modalEl = document.getElementById('modalHistoriqueReclamation');
    if (modalEl) {
        modalEl.addEventListener('show.bs.modal', function () {
            var out = document.getElementById('modal-historique-reclamation-tbody');
            var rows = document.querySelectorAll('#admin-reclamation-tbody tr[data-historique-row]');
            var pdfBtn = document.getElementById('btn-historique-pdf-export');
            if (pdfBtn && form) {
                var fd = new FormData(form);
                var params = new URLSearchParams();
                fd.forEach(function (v, k) { if (v !== '') params.set(k, v); });
                var base = pdfBtn.getAttribute('data-pdf-base') || '';
                pdfBtn.href = base + (params.toString() ? '?' + params.toString() : '');
            }
            if (!out) return;
            if (!rows.length) {
                out.innerHTML = '<tr><td colspan="5" class="admin-historique-table-empty">Aucune réclamation ne correspond à la liste actuelle.</td></tr>';
                return;
            }
            var html = '';
            rows.forEach(function (tr) {
                var p = tr.getAttribute('data-auteur-prenom') || '';
                var n = tr.getAttribute('data-auteur-nom') || '';
                var d = tr.getAttribute('data-date-ajout') || '—';
                var titre = tr.getAttribute('data-titre') || '';
                var b64 = tr.getAttribute('data-reponses-b64') || '';
                html += '<tr>' +
                    '<td>' + escapeHtml(p) + '</td>' +
                    '<td>' + escapeHtml(n) + '</td>' +
                    '<td>' + escapeHtml(d) + '</td>' +
                    '<td>' + escapeHtml(titre) + '</td>' +
                    '<td class="admin-historique-cell--responses">' + formatHistoriqueReponses(b64) + '</td>' +
                    '</tr>';
            });
            out.innerHTML = html;
        });
    }
    function decodeReponsesB64(b64) {
        if (!b64) return [];
        try {
            var s = atob(b64);
            var data = JSON.parse(s);
            return Array.isArray(data) ? data : [];
        } catch (e) {
            return [];
        }
    }
    function formatHistoriqueReponses(b64) {
        var reps = decodeReponsesB64(b64);
        if (!reps.length) {
            return '<span class="admin-historique-no-response">—</span>';
        }
        return reps.map(function (item) {
            var meta = '<strong>' + escapeHtml(item.date || '') + '</strong> · ' + escapeHtml(item.admin || '');
            var body = formatContenuMultiline(item.contenu || '');
            return '<div class="admin-historique-reponse"><p class="admin-historique-reponse-meta">' + meta + '</p>' +
                '<div class="admin-historique-reponse-body">' + body + '</div></div>';
        }).join('');
    }
    function formatContenuMultiline(text) {
        return escapeHtml(text).replace(/\n/g, '<br>');
    }
    function escapeHtml(s) {
        var div = document.createElement('div');
        div.textContent = s;
        return div.innerHTML;
    }

    (function bindRepondreModal() {
        var repondreModal = document.getElementById('modalRepondreReclamation');
        var formRepondre = document.getElementById('form-repondre-reclamation');
        var titreDisplay = document.getElementById('repondre-modal-titre-display');
        var tokenInput = document.getElementById('repondre-form-token');
        var contenuTa = document.getElementById('repondre-contenu');
        var tbodyRec = document.getElementById('admin-reclamation-tbody');
        if (!repondreModal || !formRepondre || !titreDisplay || !tokenInput || !contenuTa) return;
        var lastRepondreBtn = null;
        if (tbodyRec) {
            tbodyRec.addEventListener('click', function (e) {
                var b = e.target.closest('.js-open-repondre-modal');
                if (b) lastRepondreBtn = b;
            });
        }
        repondreModal.addEventListener('show.bs.modal', function (event) {
            var btn = null;
            if (event.relatedTarget && event.relatedTarget.closest) {
                btn = event.relatedTarget.closest('.js-open-repondre-modal');
            }
            if (!btn) btn = lastRepondreBtn;
            if (!btn) return;
            formRepondre.setAttribute('action', btn.getAttribute('data-repondre-url') || '');
            titreDisplay.textContent = btn.getAttribute('data-repondre-titre') || '';
            tokenInput.value = btn.getAttribute('data-repondre-token') || '';
            contenuTa.value = '';
        });
    })();

    var tbody = document.getElementById('admin-reclamation-tbody');
    if (!form || !tbody) return;

    function debounce(fn, ms) {
        var t;
        return function () {
            clearTimeout(t);
            var args = arguments;
            t = setTimeout(function () { fn.apply(null, args); }, ms);
        };
    }

    function syncUrl() {
        var fd = new FormData(form);
        var params = new URLSearchParams();
        fd.forEach(function (v, k) { if (v !== '') params.set(k, v); });
        var qs = params.toString();
        history.replaceState(null, '', qs ? '?' + qs : window.location.pathname);
    }

    function fetchRows() {
        var fd = new FormData(form);
        var params = new URLSearchParams();
        fd.forEach(function (v, k) { if (v !== '') params.set(k, v); });
        params.set('partial', '1');
        fetch(form.getAttribute('action') + '?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                tbody.innerHTML = html;
                syncUrl();
            })
            .catch(function () {});
    }

    var debouncedFetch = debounce(fetchRows, 320);
    form.querySelectorAll('input[name="q"]').forEach(function (el) {
        el.addEventListener('input', debouncedFetch);
    });
    form.querySelectorAll('select').forEach(function (el) {
        el.addEventListener('change', fetchRows);
    });
})();
</script>
{% endblock %}
