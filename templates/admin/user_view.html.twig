{% extends 'base_admin.html.twig' %}
{% import 'macros.html.twig' as m %}
{% block title %}Profil de {{ user.prenom }}{% endblock %}

{% block body %}
<div class="topbar">
    <h1>👤 {{ user.prenom }} {{ user.nom }}</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_user_edit', {id: user.idUser}) }}" class="btn btn-primary">✏️ Modifier</a>
        <a href="{{ path('admin_users') }}" class="btn btn-outline-secondary">← Retour</a>
    </div>
</div>

<div class="row g-3" style="max-width:800px;">
    <div class="col-md-4">
        <div class="card p-3 text-center">
            {{ m.photo(user.photoProfil, user.prenom, user.nom, 80) }}
            <h5 class="fw-bold">{{ user.prenom }} {{ user.nom }}</h5>
            <p class="text-muted">@{{ user.username }}</p>
            <span class="badge" style="background:{{ user.role == 'admin' ? '#5C0000' : '#C9A84C' }};color:white;">
                {{ user.role == 'admin' ? '👑 Admin' : '✈️ Voyageur' }}
            </span>
            {% if user.averageRating > 0 %}
                <div class="mt-2">
                    {% for i in 1..5 %}{{ i <= user.averageRating|round ? '⭐' : '☆' }}{% endfor %}
                    <div style="color:#C9A84C;font-weight:700;">
                        {{ user.averageRating|number_format(1) }} ({{ user.totalRatings }} avis)
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-3">
            <h6 class="fw-bold mb-3">ℹ️ Informations</h6>
            <table class="table table-sm">
                <tr><td class="text-muted">Email</td><td>{{ user.email }}</td></tr>
                <tr><td class="text-muted">Téléphone</td><td>{{ user.telephone ?? '-' }}</td></tr>
                <tr><td class="text-muted">Statut</td>
                    <td>
                        <span style="color:{{ user.statut == 'actif' ? '#28a745' : '#dc3545' }};font-weight:600;">
                            {{ user.statut == 'actif' ? '✓ Actif' : '✗ Inactif' }}
                        </span>
                    </td>
                </tr>
                <tr><td class="text-muted">Inscrit le</td>
                    <td>{{ user.dateInscription ? user.dateInscription|ago : '-' }}</td>
                </tr>
                <tr><td class="text-muted">Dernière connexion</td>
                    <td>{{ user.derniereConnexion ? user.derniereConnexion|ago : 'Jamais' }}</td>
                </tr>
            </table>
            <div class="mt-3 d-flex gap-2">
                <a href="{{ path('rate_user', {id: user.idUser}) }}"
                   class="btn btn-outline-warning btn-sm">⭐ Évaluer</a>
                <a href="{{ path('qr_profile') }}"
                   class="btn btn-outline-dark btn-sm">📱 QR Code</a>
                <form method="POST"
                      action="{{ path('admin_user_delete', {id: user.idUser}) }}"
                      onsubmit="return confirm('Supprimer {{ user.prenom }} ?')">
                    <button type="submit" class="btn btn-outline-danger btn-sm">🗑️ Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}