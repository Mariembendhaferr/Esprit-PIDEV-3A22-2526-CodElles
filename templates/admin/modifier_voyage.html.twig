// Vues par continent
const CONTINENT_VIEW = {
    "Europe":    { center: [51.0,  10.0], zoom: 4 },
    "Afrique":   { center: [ 5.0,  20.0], zoom: 3 },
    "Asie":      { center: [35.0,  90.0], zoom: 3 },
    "Amériques": { center: [10.0, -80.0], zoom: 3 },
    "Océanie":   { center:[-22.0, 140.0], zoom: 4 }
