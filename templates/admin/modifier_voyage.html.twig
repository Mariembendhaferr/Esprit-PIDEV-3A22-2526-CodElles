// ═══════════════════════════════════════════════════════════════════
// RÉCUPÉRER LE CONTINENT
// ═══════════════════════════════════════════════════════════════════
function getCurrentContinent() {
    let continentField = document.getElementById('continent');
    if (!continentField || !continentField.value)
        continentField = document.querySelector('[name="voyage[continent]"]');
    if (!continentField || !continentField.value)
        continentField = document.querySelector('select[name*="continent"]');
    if (!continentField || !continentField.value)
        continentField = document.querySelector('#continent-select');
    const value = continentField ? continentField.value : '';
    if (value && value !== '' && value !== 'Choisir...') return value;
    return '';
}

// ═══════════════════════════════════════════════════════════════════
// AUTOCOMPLETE
// ═══════════════════════════════════════════════════════════════════
const PAYS_LISTE = Object.keys(PAYS_CONTINENT).sort();
let acActiveIndex = -1;

function onDestinationInput(query) {
    const list = document.getElementById('autocomplete-list');
    const contChoisi = getCurrentContinent();
    if (!query || query.length < 1) { fermerAutocomplete(); return; }
    const normalized = query.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    let filtered = PAYS_LISTE.filter(p => {
        const pNorm = p.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        return pNorm.startsWith(normalized);
    }).slice(0, 8);
    if (filtered.length === 0) {
        filtered = PAYS_LISTE.filter(p => {
            const pNorm = p.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
            return pNorm.includes(normalized);
        }).slice(0, 8);
    }
    if (filtered.length === 0) { fermerAutocomplete(); return; }
    list.innerHTML = '';
    acActiveIndex = -1;
    filtered.forEach(pays => {
        const cont = PAYS_CONTINENT[pays] || '';
        const incompatible = contChoisi && cont && cont !== contChoisi;
        const li = document.createElement('li');
        if (incompatible) li.classList.add('incompatible');
        li.innerHTML = `<span>${pays}</span><span class="continent-badge">${cont}</span>`;
        li.title = incompatible ? `${pays} est en ${cont}, pas en ${contChoisi}` : `Sélectionner ${pays}`;
        li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            if (incompatible) {
                const errEl = document.getElementById('err-destination');
                if (errEl) errEl.textContent = `❌ ${pays} appartient à ${cont}, pas à ${contChoisi}`;
                return;
            }
            selectionnerPays(pays);
        });
        list.appendChild(li);
    });
    list.style.display = 'block';
}

function navigerSuggestions(e) {
    const list  = document.getElementById('autocomplete-list');
    const items = list ? list.querySelectorAll('li:not(.incompatible)') : [];
    if (!items.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); acActiveIndex = Math.min(acActiveIndex + 1, items.length - 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); acActiveIndex = Math.max(acActiveIndex - 1, 0); }
    else if (e.key === 'Enter' && acActiveIndex >= 0) { e.preventDefault(); items[acActiveIndex].dispatchEvent(new MouseEvent('mousedown')); return; }
    else if (e.key === 'Escape') { fermerAutocomplete(); return; }
    else return;
    items.forEach((item, i) => {
        item.classList.toggle('active', i === acActiveIndex);
        if (i === acActiveIndex) item.scrollIntoView({ block: 'nearest' });
    });
}

function fermerAutocomplete() {
    setTimeout(() => {
        const list = document.getElementById('autocomplete-list');
        if (list) list.style.display = 'none';
        acActiveIndex = -1;
    }, 150);
}

function selectionnerPays(pays) {
    const destField = document.getElementById('destination');
    if (destField) {
        destField.value = pays;
        destField.dispatchEvent(new Event('input', { bubbles: true }));
    }
    const previewDest = document.getElementById('preview-dest');
    if (previewDest) previewDest.textContent = pays;
    fermerAutocomplete();
    validerPays(pays);
}

// ═══════════════════════════════════════════════════════════════════
// VALIDATION CONTINENT / PAYS
// ═══════════════════════════════════════════════════════════════════
function onContinentChange(val) {
    const badge = document.getElementById('preview-continent-badge');
    if (badge) badge.innerHTML = `<i class="fa-solid fa-globe"></i> ${val || 'Destination'}`;
    const destInput = document.getElementById('destination');
    if (destInput && destInput.value.trim()) validerPays(destInput.value.trim());
    const errCont = document.getElementById('err-continent');
    if (errCont && val) errCont.textContent = '';
    if (leafletMap && document.getElementById('map-overlay').classList.contains('actif')) {
        appliquerStyleContinent(val);
        appliquerZoomContinent(val);
        const hint = document.getElementById('map-continent-hint');
        if (hint && val) {
            hint.innerHTML = `<i class="fa-solid fa-check-circle"></i> ✅ Continent sélectionné : <strong>${val}</strong> — Cliquez sur un pays pour le sélectionner.`;
            hint.style.color = '#2e7d32';
            hint.style.background = 'rgba(46,125,50,0.1)';
        }
    }
}

function validerPays(pays) {
    const contChoisi = getCurrentContinent();
    const contDuPays = PAYS_CONTINENT[pays];
    const errEl = document.getElementById('err-destination');
    const destInput = document.getElementById('destination');
    if (!contChoisi) {
        if (errEl) { errEl.className = 'field-error'; errEl.textContent = '⚠ Sélectionnez d\'abord un continent'; }
        return false;
    }
    if (!contDuPays) {
        if (errEl) { errEl.className = 'field-error'; errEl.textContent = `⚠ "${pays}" non reconnu dans notre base`; }
        if (destInput) destInput.classList.remove('input-error');
        return true;
    }
    if (contChoisi !== contDuPays) {
        if (errEl) { errEl.className = 'field-error'; errEl.textContent = `❌ ${pays} est en ${contDuPays}, pas en ${contChoisi}`; }
        if (destInput) destInput.classList.add('input-error');
        return false;
    }
    if (errEl) { errEl.className = 'field-error field-ok'; errEl.textContent = `✓ ${pays} — ${contDuPays}`; }
    if (destInput) destInput.classList.remove('input-error');
    return true;
}

// ═══════════════════════════════════════════════════════════════════
// CARTE LEAFLET
// ═══════════════════════════════════════════════════════════════════
let leafletMap = null;
let geoLayer = null;
let geoJsonCache = null;

function ouvrirMap() {
    const overlay = document.getElementById('map-overlay');
    if (!overlay) return;
    const cont = getCurrentContinent();
    const hint = document.getElementById('map-continent-hint');
    if (hint) {
        if (cont) {
            hint.innerHTML = `<i class="fa-solid fa-check-circle"></i> ✅ Continent sélectionné : <strong>${cont}</strong> — Cliquez sur un pays pour le sélectionner.`;
            hint.style.color = '#2e7d32';
            hint.style.background = 'rgba(46,125,50,0.1)';
        } else {
            hint.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ⚠️ Veuillez d\'abord sélectionner un continent dans le formulaire';
            hint.style.color = '#7A0000';
            hint.style.background = 'rgba(122,0,0,0.1)';
        }
    }
    overlay.classList.add('actif');
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
        if (leafletMap) {
            appliquerStyleContinent(cont);
            appliquerZoomContinent(cont);
            leafletMap.invalidateSize();
        } else {
            initCarteLeaflet(cont);
        }
    }, 80);
}

function initCarteLeaflet(contInitial) {
    const mapDiv = document.getElementById('leaflet-map');
    const loader = document.getElementById('map-loader');
    if (loader) loader.style.display = 'flex';
    if (mapDiv) mapDiv.style.display = 'none';
    leafletMap = L.map('leaflet-map', { zoomControl: true, attributionControl: false, minZoom: 2, maxZoom: 8, worldCopyJump: true });
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png', { attribution: '© OpenStreetMap © CARTO' }).addTo(leafletMap);
    const GEOJSON_URL_1 = 'https://raw.githubusercontent.com/holtzy/D3-graph-gallery/master/DATA/world.geojson';
    const GEOJSON_URL_2 = 'https://cdn.jsdelivr.net/gh/holtzy/D3-graph-gallery@master/DATA/world.geojson';
    const fetchGeoJSON = () =>
        fetch(GEOJSON_URL_1).then(r => { if (!r.ok) throw new Error('src1'); return r.json(); })
        .catch(() => fetch(GEOJSON_URL_2).then(r => { if (!r.ok) throw new Error('src2'); return r.json(); }));
    const source = geoJsonCache ? Promise.resolve(geoJsonCache) : fetchGeoJSON();
    let cont = contInitial || getCurrentContinent();
    source.then(data => {
        geoJsonCache = data;
        geoLayer = L.geoJSON(data, {
            style: feature => stylePays(feature, cont),
            onEachFeature: (feature, layer) => {
                const nomEN = feature.properties?.NAME || feature.properties?.ADMIN || feature.properties?.name || '';
                const nomFR = EN_TO_FR[nomEN] || nomEN;
                const contPays = PAYS_CONTINENT[nomFR] || '';
                layer.bindTooltip(nomFR, { sticky: true, direction: 'top', offset: [0, -4], className: 'country-tooltip', opacity: 1 });
                layer.on('mouseover', function() {
                    const cCont = getCurrentContinent();
                    if (cCont && contPays && contPays !== cCont) return;
                    this.setStyle({ fillColor: '#C5A880', fillOpacity: 0.85, color: '#5C0000', weight: 2.5 });
                    this.bringToFront();
                });
                layer.on('mouseout', function() {
                    this.setStyle(stylePays(feature, getCurrentContinent()));
                });
                layer.on('click', function(e) {
                    if (e && e.originalEvent) e.originalEvent.stopPropagation();
                    const continentFormulaire = getCurrentContinent();
                    const hint = document.getElementById('map-continent-hint');
                    if (!continentFormulaire) {
                        if (hint) { hint.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ❗ Sélectionnez d\'abord un continent'; hint.style.color = '#7A0000'; }
                        return;
                    }
                    if (contPays && contPays !== continentFormulaire) {
                        if (hint) { hint.innerHTML = `<i class="fa-solid fa-xmark"></i> ❌ <strong>${nomFR}</strong> est en <em>${contPays}</em>, pas en <em>${continentFormulaire}</em>`; hint.style.color = '#7A0000'; }
                        return;
                    }
                    let destField = document.getElementById('destination');
                    if (!destField) destField = document.querySelector('[name="voyage[destination]"]');
                    if (destField) {
                        destField.value = nomFR;
                        destField.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                    acActiveIndex = -1;
                    const previewDest = document.getElementById('preview-dest');
                    if (previewDest) previewDest.textContent = nomFR;
                    validerPays(nomFR);
                    if (hint) { hint.innerHTML = `<i class="fa-solid fa-check-circle"></i> ✅ <strong>${nomFR}</strong> sélectionné !`; hint.style.color = '#2e7d32'; }
                    setTimeout(() => { fermerMap(); }, 400);
                });
            }
        }).addTo(leafletMap);
        if (loader) loader.style.display = 'none';
        if (mapDiv) mapDiv.style.display = 'block';
        leafletMap.invalidateSize();
        appliquerZoomContinent(cont);
    }).catch(err => {
        console.error('Erreur GeoJSON :', err);
        if (loader) loader.innerHTML = `<i class="fa-solid fa-triangle-exclamation" style="color:var(--bordeaux);font-size:2rem;"></i><span style="color:var(--bordeaux)">Erreur de chargement.</span>`;
    });
}

function stylePays(feature, contActif) {
    const nomEN = feature.properties?.NAME || feature.properties?.ADMIN || feature.properties?.name || '';
    const nomFR = EN_TO_FR[nomEN] || nomEN;
    const contPays = PAYS_CONTINENT[nomFR] || '';
    const actif = !contActif || contPays === contActif;
    return actif
        ? { fillColor: '#8B0000', fillOpacity: 0.55, color: '#C5A880', weight: 1.2 }
        : { fillColor: '#d4c9b8', fillOpacity: 0.35, color: '#b0a898', weight: 0.5 };
}

function appliquerStyleContinent(cont) {
    if (!geoLayer) return;
    geoLayer.eachLayer(layer => { if (layer.feature) layer.setStyle(stylePays(layer.feature, cont)); });
}

function appliquerZoomContinent(cont) {
    if (!leafletMap) return;
    if (cont && CONTINENT_VIEW[cont]) {
        const v = CONTINENT_VIEW[cont];
        leafletMap.setView(v.center, v.zoom, { animate: true, duration: 0.8 });
    } else {
        leafletMap.setView([20, 0], 2, { animate: true });
    }
}

function fermerMap() {
    const overlay = document.getElementById('map-overlay');
    if (overlay) overlay.classList.remove('actif');
    document.body.style.overflow = '';
}

// ═══════════════════════════════════════════════════════════════════
// VALIDATIONS
// ═══════════════════════════════════════════════════════════════════
function validateTitre(input) {
    const err = document.getElementById('err-titre');
    if (input.value.length > 0 && !/^[a-zA-ZÀ-ÿ\s\-']+$/.test(input.value)) {
        if (err) err.textContent = '⚠ Lettres et espaces uniquement';
        return false;
    }
    if (err) err.textContent = '';
    return true;
}

function validatePositif(input, errId) {
    const err = document.getElementById(errId);
    const val = parseFloat(input.value);
    if (isNaN(val) || val < 1) {
        if (err) err.textContent = '⚠ Valeur doit être > 0';
        return false;
    }
    if (err) err.textContent = '';
    return true;
}

function validateImageUrl(input) {
    const err = document.getElementById('err-image');
    if (!input.value.trim()) { if (err) err.textContent = ''; return true; }
    if (!/\.(jpg|jpeg|png)$/i.test(input.value)) {
        if (err) err.textContent = '⚠ Doit se terminer par .jpg, .jpeg ou .png';
        return false;
    }
    if (err) err.textContent = '';
    return true;
}

function validateForm() {
    let valid = true;

    let continentSelect = document.getElementById('continent');
    if (!continentSelect) continentSelect = document.querySelector('[name="voyage[continent]"]');
    if (!continentSelect) continentSelect = document.querySelector('select[name*="continent"]');
    if (!continentSelect) continentSelect = document.querySelector('#continent-select');
    const continent = continentSelect ? continentSelect.value : '';

    let destInput = document.getElementById('destination');
    if (!destInput) destInput = document.querySelector('[name="voyage[destination]"]');
    const dest = destInput ? destInput.value.trim() : '';

    const errCont = document.getElementById('err-continent');
    const continentsValides = ['Europe', 'Afrique', 'Asie', 'Amériques', 'Océanie'];

    if (!continent || !continentsValides.includes(continent)) {
        if (errCont) errCont.textContent = '⚠ Choisissez un continent';
        valid = false;
    } else {
        if (errCont) errCont.textContent = '';
    }

    if (!dest) {
        const errDest = document.getElementById('err-destination');
        if (errDest) errDest.textContent = '⚠ Entrez une destination';
        valid = false;
    } else {
        const contDuPays = PAYS_CONTINENT[dest];
        if (continent && contDuPays && contDuPays !== continent) {
            const errDest = document.getElementById('err-destination');
            if (errDest) errDest.textContent = `❌ ${dest} est en ${contDuPays}, pas en ${continent}`;
            valid = false;
        } else {
            const errDest = document.getElementById('err-destination');
            if (errDest) errDest.textContent = '';
        }
    }

    if (!valid) {
        const firstError = document.querySelector('.input-error, .field-error:not(:empty)');
        if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
    }

    // ✅ Valide → modal puis soumission
    const overlay = document.getElementById('success-overlay');
    overlay.style.display = 'flex';
    setTimeout(() => {
        document.getElementById('success-bar').style.width = '100%';
    }, 50);
    setTimeout(() => {
        document.getElementById('voyage-form').submit();
    }, 2100);

    return false;
}

// ═══════════════════════════════════════════════════════════════════
// PREVIEW
// ═══════════════════════════════════════════════════════════════════
function updateTitle(val) {
    const el = document.getElementById('preview-title');
    if (el) el.textContent = val || 'Le Titre...';
}

function updateStat(id, val) {
    const el = document.getElementById(id);
    if (!el) return;
    if (val) { el.textContent = val; el.classList.remove('empty'); }
    else { el.textContent = '—'; el.classList.add('empty'); }
}

function updateBgFromUrl(url) {
    const bg = document.getElementById('preview-bg');
    if (bg && url && /\.(jpg|jpeg|png)$/i.test(url)) bg.style.backgroundImage = `url('${url}')`;
}

function handleUpload(input) {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        const bg = document.getElementById('preview-bg');
        if (bg) bg.style.backgroundImage = `url('${e.target.result}')`;
    };
    reader.readAsDataURL(file);
}

// ═══════════════════════════════════════════════════════════════════
// INIT — pré-remplissage du preview avec les données existantes
// ═══════════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
    const destInput = document.getElementById('destination');
    if (destInput) {
        destInput.addEventListener('blur', () => fermerAutocomplete());
        // Valider la destination déjà remplie
        if (destInput.value.trim()) validerPays(destInput.value.trim());
    }

    // Initialiser le badge preview avec le continent existant
    const initialCont = getCurrentContinent();
    if (initialCont) {
        const badge = document.getElementById('preview-continent-badge');
        if (badge) badge.innerHTML = `<i class="fa-solid fa-globe"></i> ${initialCont}`;
    }
});

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') fermerMap();
});

console.log("✅ Doura Mondo — Modifier Voyage initialisé");
</script>
