    "Tanzanie":"Afrique","Mozambique":"Afrique","Afrique du Sud":"Afrique",
    "Zimbabwe":"Afrique","Namibie":"Afrique","Botswana":"Afrique","Zambie":"Afrique",
    "Angola":"Afrique","Madagascar":"Afrique","Maurice":"Afrique","Réunion":"Afrique",
    "Libye":"Afrique","Soudan":"Afrique","Tchad":"Afrique","Niger":"Afrique",
    "Burkina Faso":"Afrique","Guinée":"Afrique","Congo":"Afrique",
    "République Démocratique du Congo":"Afrique","Rwanda":"Afrique","Uganda":"Afrique",
    // Asie
    "Japon":"Asie","Chine":"Asie","Inde":"Asie","Thaïlande":"Asie","Vietnam":"Asie",
    "Indonésie":"Asie","Malaisie":"Asie","Singapour":"Asie","Philippines":"Asie",
    "Corée du Sud":"Asie","Corée du Nord":"Asie","Taiwan":"Asie","Hong Kong":"Asie",
    "Cambodge":"Asie","Laos":"Asie","Myanmar":"Asie","Bangladesh":"Asie",
    "Sri Lanka":"Asie","Népal":"Asie","Pakistan":"Asie","Afghanistan":"Asie",
    "Iran":"Asie","Irak":"Asie","Syrie":"Asie","Liban":"Asie","Jordanie":"Asie",
    "Israël":"Asie","Arabie Saoudite":"Asie","Émirats Arabes Unis":"Asie",
    "Qatar":"Asie","Koweït":"Asie","Bahreïn":"Asie","Oman":"Asie","Yémen":"Asie",
    "Kazakhstan":"Asie","Ouzbékistan":"Asie","Azerbaïdjan":"Asie","Géorgie":"Asie",
    "Arménie":"Asie","Mongolie":"Asie","Maldives":"Asie","Bhoutan":"Asie",
