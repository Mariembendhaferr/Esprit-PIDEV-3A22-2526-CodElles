{# templates/admin/modifier_voyage.html.twig #}
{% extends "admin/base-admin.html.twig" %}

{% block title %}Doura Mondo - Modifier une Destination{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
/* ═══════════════════════════════════════════════════════════════════
   CHARTE GRAPHIQUE : bordeaux / or / beige
   ═══════════════════════════════════════════════════════════════════ */
:root {
    --bordeaux:       #5C0000;
    --bordeaux-light: #7A0000;
    --bordeaux-dark:  #3A0000;
    --gold:           #C5A880;
    --gold-light:     #D4BC9A;
    --beige-bg:       #F4F1EA;
    --beige-light:    #FDFCF9;
}

/* ── Champ destination + bouton map ── */
.destination-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}
.destination-wrapper input {
    flex: 1;
    border-radius: 8px 0 0 8px !important;
}
.btn-open-map {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; flex-shrink: 0;
    background: linear-gradient(135deg, var(--bordeaux), var(--bordeaux-light));
    border: none; border-radius: 0 8px 8px 0;
    color: var(--gold); font-size: 1.1rem; cursor: pointer;
    transition: background .2s, transform .2s;
}
.btn-open-map:hover {
    background: linear-gradient(135deg, var(--bordeaux-dark), var(--bordeaux));
    transform: scale(1.05);
}

/* ── Autocomplete dropdown ── */
.autocomplete-dropdown {
    position: absolute;
    top: 100%; left: 0; right: 44px;
    background: var(--beige-light);
    border: 1px solid var(--gold);
    border-top: none;
    border-radius: 0 0 10px 10px;
    list-style: none; margin: 0; padding: 0;
    z-index: 9999; display: none;
    max-height: 240px; overflow-y: auto;
    box-shadow: 0 10px 28px rgba(92,0,0,.18);
}
.autocomplete-dropdown li {
    padding: 10px 15px;
    color: var(--bordeaux);
    cursor: pointer;
    font-size: .88rem;
    border-bottom: 1px solid rgba(197,168,128,.25);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background .15s;
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
}
.autocomplete-dropdown li:last-child { border-bottom: none; }
.autocomplete-dropdown li:hover { background: rgba(92,0,0,.07); }
.autocomplete-dropdown li.incompatible {
    opacity: .4; cursor: not-allowed; color: #999;
}
.continent-badge {
    font-size: .7rem;
    background: rgba(92,0,0,.1);
    color: var(--bordeaux);
    border: 1px solid var(--gold);
    padding: 2px 8px; border-radius: 10px;
    white-space: nowrap; margin-left: 8px;
    font-family: 'Cinzel', serif;
    letter-spacing: .05em;
}
.autocomplete-dropdown li.incompatible .continent-badge {
    background: #f5e0e0;
    color: #999;
}

/* ── Champs verrouillés ── */
.form-group label .lock-icon {
    font-size: .75rem;
    color: var(--gold);
    margin-left: 6px;
    opacity: .7;
}

/* ── Erreur champ ── */
.input-error {
    border-color: var(--bordeaux-light) !important;
    box-shadow: 0 0 0 2px rgba(92,0,0,.25) !important;
}
.field-error {
    display: block;
    font-size: .78rem;
    margin-top: 4px;
    color: var(--bordeaux);
    min-height: 16px;
    font-style: italic;
}
.field-ok {
    color: #2e7d32 !important;
    font-style: normal !important;
    font-weight: 600;
}

/* ═══════════════════════════════════════════════════════════════════
   MODAL CARTE
   ═══════════════════════════════════════════════════════════════════ */
.map-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(40,0,0,.72);
    z-index: 10000;
    align-items: center; justify-content: center;
}
.map-overlay.actif { display: flex; }

.map-modal {
    background: var(--beige-light);
    border-radius: 16px;
    width: 94vw; max-width: 1080px; max-height: 92vh;
    display: flex; flex-direction: column; overflow: hidden;
    box-shadow: 0 30px 90px rgba(92,0,0,.45);
    border: 2px solid var(--gold);
}
.map-modal-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 16px 24px 12px;
    background: var(--bordeaux);
    border-bottom: 2px solid var(--gold);
}
.map-modal-badge {
    font-family: 'Cinzel', serif;
    font-size: .68rem; text-transform: uppercase; letter-spacing: .15em;
    color: var(--gold); margin-bottom: 3px;
}
.map-modal-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem; color: var(--beige-bg); margin: 0; font-weight: 600;
}
.map-modal-close {
    background: none; border: 1px solid rgba(197,168,128,.4);
    color: var(--gold); font-size: 1.1rem;
    cursor: pointer; padding: 4px 10px; border-radius: 6px;
    transition: all .2s;
}
.map-modal-close:hover { background: rgba(197,168,128,.15); color: #fff; }

.map-continent-hint {
    padding: 8px 24px;
    font-size: .82rem;
    background: rgba(197,168,128,.15);
    border-bottom: 1px solid var(--gold-light);
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all .2s;
}

#leaflet-map {
    flex: 1; height: 480px; width: 100%;
    background: #e8e0d5;
}

.map-modal-footer {
    display: flex; align-items: center; gap: 18px;
    padding: 10px 24px;
    background: var(--bordeaux);
    border-top: 2px solid var(--gold);
    flex-wrap: wrap;
}
.map-legend {
    display: flex; align-items: center; gap: 6px;
    font-size: .75rem; color: var(--gold-light);
    font-family: 'Cinzel', serif;
}
.map-legend-dot { width: 12px; height: 12px; border-radius: 50%; }
.map-legend-dot.active   { background: var(--bordeaux-light); border: 2px solid var(--gold); }
.map-legend-dot.hover    { background: var(--gold); }
.map-legend-dot.inactive { background: #aaa; border: 1px solid #ccc; }

.map-btn-cancel {
    margin-left: auto;
    background: none;
    border: 1px solid var(--gold);
    color: var(--gold);
    padding: 7px 18px; border-radius: 8px;
    cursor: pointer; font-size: .82rem;
    font-family: 'Cinzel', serif;
    transition: all .2s;
}
.map-btn-cancel:hover { background: rgba(197,168,128,.15); color: #fff; }

/* Leaflet tooltip charte */
.country-tooltip {
    background: var(--bordeaux) !important;
    border: 1px solid var(--gold) !important;
    color: var(--gold-light) !important;
    font-weight: 700 !important;
    padding: 5px 12px !important;
    border-radius: 6px !important;
    font-size: 13px !important;
    font-family: 'Cinzel', serif !important;
    box-shadow: 0 4px 12px rgba(92,0,0,.35) !important;
}
.leaflet-tooltip-pane .country-tooltip::before { display: none; }

.leaflet-popup-content-wrapper {
    background: var(--bordeaux) !important;
    color: var(--beige-bg) !important;
    border-radius: 10px !important;
    border: 2px solid var(--gold) !important;
    box-shadow: 0 6px 20px rgba(92,0,0,.5) !important;
}
.leaflet-popup-tip { background: var(--bordeaux) !important; }
.leaflet-popup-content {
    margin: 10px 14px !important;
    font-size: .9rem;
    font-family: 'Cormorant Garamond', serif;
}
.leaflet-popup-close-button { color: var(--gold) !important; }

/* Spinner chargement carte */
.map-loader {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    height: 480px;
    gap: 14px; color: var(--bordeaux);
    font-family: 'Cinzel', serif; font-size: .9rem;
}
.map-loader-spinner {
    width: 46px; height: 46px;
    border: 4px solid rgba(92,0,0,.15);
    border-top-color: var(--bordeaux);
    border-radius: 50%;
    animation: spin .85s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
</style>
{% endblock %}

{% block content %}

<!-- Modal succès modification -->
<div id="success-overlay" style="
    display:none; position:fixed; inset:0;
    background:rgba(40,0,0,.75);
    z-index:99999;
    align-items:center; justify-content:center;
">
    <div style="
        background: linear-gradient(135deg, #5C0000, #3A0000);
        border: 2px solid #C5A880;
        border-radius: 18px;
        padding: 40px 50px;
        text-align: center;
        color: #C5A880;
        font-family: 'Cormorant Garamond', serif;
        box-shadow: 0 30px 80px rgba(0,0,0,.5);
        max-width: 420px;
    ">
        <i class="fa-solid fa-pen-to-square" style="font-size:3rem; margin-bottom:15px; display:block;"></i>
        <div style="font-size:1.5rem; font-weight:700; margin-bottom:8px;">Voyage modifié avec succès !</div>
        <div style="font-size:1rem; opacity:.8;">Redirection en cours...</div>
        <div style="margin-top:20px; height:4px; background:rgba(197,168,128,.2); border-radius:2px; overflow:hidden;">
            <div id="success-bar" style="height:100%; width:0%; background:#C5A880; transition: width 2s linear;"></div>
        </div>
    </div>
</div>

<!-- STEPPER -->
<div class="stepper-container">
    <div class="step active">
        <div class="step-circle">1</div>
        <div class="step-label">Imaginez et Pensez</div>
    </div>
    <div class="step-line active"></div>
    <div class="step active">
        <div class="step-circle">2</div>
        <div class="step-label">Modifiez votre idée</div>
    </div>
    <div class="step-line"></div>
    <div class="step inactive">
        <div class="step-circle">3</div>
        <div class="step-label">Planifier son séjour</div>
    </div>
</div>

<!-- SPLIT LAYOUT -->
<div class="split-layout">

    <!-- FORMULAIRE -->
    <div class="form-card">
        <p class="form-card-title">Modifier l'Odyssée</p>
        <p class="form-card-subtitle">Ajustez les détails de cette destination</p>

        {% if not form.vars.valid and form.vars.submitted %}
            <div class="form-errors">
                {% for field in form %}
                    {% for error in field.vars.errors %}
                        <div class="form-error-item">
                            <i class="fa-solid fa-circle-exclamation"></i> {{ error.message }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        {{ form_start(form, {
            attr: { class: 'luxury-form', id: 'voyage-form', onsubmit: 'return validateForm()' }
        }) }}

            {# ── Titre ── #}
            <div class="form-group full-row">
                <label for="{{ form.titre.vars.id }}">
                    <i class="fa-solid fa-feather-pointed"></i> Nom de l'Odyssée
                </label>
                {{ form_widget(form.titre, {
                    attr: { oninput: "updateTitle(this.value); validateTitre(this)" }
                }) }}
                {{ form_errors(form.titre) }}
                <span class="field-error" id="err-titre"></span>
            </div>

            {# ── Continent ── #}
            <div class="form-group">
                <label for="{{ form.continent.vars.id }}">
                    <i class="fa-solid fa-globe"></i> Région du monde <i class="fa-solid fa-lock lock-icon" title="Non modifiable"></i>
                </label>
                <div style="position:relative;">
                    {{ form_widget(form.continent, {
                        attr: {
                            id: "continent-select",
                            disabled: "disabled",
                            style: "opacity:.6; cursor:not-allowed; pointer-events:none; background:rgba(92,0,0,.05);"
                        }
                    }) }}
                    <input type="hidden" name="{{ form.continent.vars.full_name }}" value="{{ voyage.continent }}">
                    <i class="fa-solid fa-chevron-down select-icon"></i>
                </div>
                {{ form_errors(form.continent) }}
                <span class="field-error" id="err-continent"></span>
            </div>

            {# ── Destination : autocomplete + bouton map ── #}
            <div class="form-group">
                <label for="{{ form.destination.vars.id }}">
                    <i class="fa-solid fa-location-dot"></i> Pays de destination <i class="fa-solid fa-lock lock-icon" title="Non modifiable"></i>
                </label>
                <div class="destination-wrapper">
                    {{ form_widget(form.destination, {
                        attr: {
                            readonly: "readonly",
                            autocomplete: "off",
                            style: "opacity:.6; cursor:not-allowed; border-radius:8px !important; background:rgba(92,0,0,.05);"
                        }
                    }) }}
                </div>
                {{ form_errors(form.destination) }}
                <span class="field-error" id="err-destination"></span>
            </div>

            {# ── Budget ── #}
            <div class="form-group">
                <label for="{{ form.budget_estime.vars.id }}">
                    <i class="fa-solid fa-euro-sign"></i> Investissement estimé (€)
                </label>
                {{ form_widget(form.budget_estime, {
                    attr: { oninput: "updateStat('prev-budget', this.value ? this.value + ' €' : null); validatePositif(this, 'err-budget')" }
                }) }}
                {{ form_errors(form.budget_estime) }}
                <span class="field-error" id="err-budget"></span>
            </div>

            {# ── Durée ── #}
            <div class="form-group">
                <label for="{{ form.duree.vars.id }}">
                    <i class="fa-regular fa-clock"></i> Temps d'immersion (jours) <i class="fa-solid fa-lock lock-icon" title="Non modifiable"></i>
                </label>
                {{ form_widget(form.duree, {
                    attr: {
                        readonly: "readonly",
                        style: "opacity:.6; cursor:not-allowed; background:rgba(92,0,0,.05);"
                    }
                }) }}
                {{ form_errors(form.duree) }}
                <span class="field-error" id="err-duree"></span>
            </div>

            {# ── Nb personnes ── #}
            <div class="form-group">
                <label for="{{ form.nb_personnes.vars.id }}">
                    <i class="fa-solid fa-users"></i> Ampleur du groupe
                </label>
                {{ form_widget(form.nb_personnes, {
                    attr: { oninput: "updateStat('prev-pers', this.value ? this.value + ' Pers.' : null); validatePositif(this, 'err-pers')" }
                }) }}
                {{ form_errors(form.nb_personnes) }}
                <span class="field-error" id="err-pers"></span>
            </div>

            {# ── Image URL ── #}
            <div class="form-group full-row">
                <label for="{{ form.image_url.vars.id }}">
                    <i class="fa-regular fa-image"></i> URL de la photo de couverture
                </label>
                {{ form_widget(form.image_url, {
                    attr: { oninput: "updateBgFromUrl(this.value); validateImageUrl(this)" }
                }) }}
                {{ form_errors(form.image_url) }}
                <span class="field-error" id="err-image"></span>
                <span class="field-hint">Doit se terminer par .jpg, .jpeg ou .png</span>
            </div>

            {# ── Description ── #}
            <div class="form-group full-row">
                <label for="{{ form.description.vars.id }}">
                    <i class="fa-solid fa-quote-left"></i> Récit du Voyage
                    <span class="optional-badge">Facultatif</span>
                </label>
                {{ form_widget(form.description) }}
            </div>

            <div class="full-row form-actions">
                <a href="{{ path('app_voyage_admin') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-submit">
                    <i class="fa-solid fa-floppy-disk"></i> Enregistrer les modifications
                </button>
            </div>

        {{ form_end(form) }}
    </div>

    <!-- PANNEAU PREVIEW -->
    <div class="preview-panel">
        <div class="preview-card">
            <div class="preview-card-bg" id="preview-bg"
                 style="background-image: url('{{ voyage.imageUrl ?: 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=600&q=80' }}');"></div>
            <div class="preview-card-overlay"></div>
            <div class="preview-card-content">
                <div class="preview-badge" id="preview-continent-badge">
                    <i class="fa-solid fa-globe"></i> {{ voyage.continent ?: 'Destination' }}
                </div>
                <div class="preview-title" id="preview-title">{{ voyage.titre ?: 'Le Titre...' }}</div>
                <div class="preview-dest" id="preview-dest">{{ voyage.destination ?: 'Doura Mondo · Voyages d\'Exception' }}</div>
            </div>
        </div>

        <div class="upload-zone" id="upload-zone">
            <input type="file" accept="image/*" id="photo-upload" onchange="handleUpload(this)">
            <i class="fa-regular fa-image" id="upload-icon"></i>
            <div class="upload-label">Photo de couverture</div>
            <div class="upload-hint" id="upload-hint">Cliquez pour choisir une image</div>
        </div>

        <div class="preview-stats">
            <div class="preview-stats-title">
                <i class="fa-solid fa-chart-simple"></i> Aperçu
            </div>
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
                    <div class="stat-info">
                        <span class="stat-lbl">Budget</span>
                        <span class="stat-val {% if not voyage.budgetEstime %}empty{% endif %}" id="prev-budget">
                            {{ voyage.budgetEstime ? voyage.budgetEstime ~ ' €' : '—' }}
                        </span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon"><i class="fa-regular fa-clock"></i></div>
                    <div class="stat-info">
                        <span class="stat-lbl">Durée</span>
                        <span class="stat-val {% if not voyage.duree %}empty{% endif %}" id="prev-duree">
                            {{ voyage.duree ? voyage.duree ~ ' Jours' : '—' }}
                        </span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
                    <div class="stat-info">
                        <span class="stat-lbl">Voyageurs</span>
                        <span class="stat-val {% if not voyage.nbPersonnes %}empty{% endif %}" id="prev-pers">
                            {{ voyage.nbPersonnes ? voyage.nbPersonnes ~ ' Pers.' : '—' }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ═══════════════════════════════════════════════════════════════ #}
{#  MODAL CARTE LEAFLET                                           #}
{# ═══════════════════════════════════════════════════════════════ #}
<div id="map-overlay" class="map-overlay">
    <div class="map-modal">
        <div class="map-modal-header">
            <div>
                <div class="map-modal-badge">Sélection Géographique</div>
                <h2 class="map-modal-title">Choisissez votre destination sur la carte</h2>
            </div>
            <button type="button" class="map-modal-close" onclick="fermerMap()">&#x2715;</button>
        </div>
        <div class="map-continent-hint" id="map-continent-hint">
            <i class="fa-solid fa-circle-info"></i>
            Sélectionnez d'abord un continent dans le formulaire
        </div>
        <div id="leaflet-map-container">
            <div class="map-loader" id="map-loader">
                <div class="map-loader-spinner"></div>
                <span>Chargement de la carte...</span>
            </div>
            <div id="leaflet-map" style="display:none; flex:1; height:480px; width:100%;"></div>
        </div>
        <div class="map-modal-footer">
            <span class="map-legend">
                <span class="map-legend-dot active"></span> Pays du continent sélectionné
            </span>
            <span class="map-legend">
                <span class="map-legend-dot hover"></span> Survol / sélection
            </span>
            <span class="map-legend">
                <span class="map-legend-dot inactive"></span> Autre continent
            </span>
            <button type="button" class="map-btn-cancel" onclick="fermerMap()">
                <i class="fa-solid fa-xmark"></i> Fermer
            </button>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
"use strict";
// ═══════════════════════════════════════════════════════════════════
// BASE DE DONNÉES PAYS ↔ CONTINENT (étendue)
// ═══════════════════════════════════════════════════════════════════
const PAYS_CONTINENT = {
    // Europe
    "France":"Europe","Allemagne":"Europe","Italie":"Europe","Espagne":"Europe",
