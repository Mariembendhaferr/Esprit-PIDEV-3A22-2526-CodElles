<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doura Mondo - {% block title %}Administration{% endblock %}</title>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Great+Vibes&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand-logo">
            <div class="logo-img-wrapper">
                <img src="{{ asset('img/logo.png') }}" alt="Doura Mondo Logo" class="brand-img">
            </div>
            <h1>Doura Mondo</h1>
            <p>VOYAGES D'EXCEPTION</p>
        </div>

        <nav class="nav-menu">
            <div class="nav-indicator"></div>

             <a href="/dashboard" class="nav-link">
    <i class="fa-regular fa-window-maximize"></i>
    <span>Dashboard</span>
</a>
            <a href="#" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_user' ? 'active' : '' }}">
                <i class="fa-regular fa-user"></i>
                <span>Utilisateurs</span>
            </a>
            <a href="{{ path('app_voyage_admin') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_voyage' ? 'active' : '' }}">
                <i class="fa-solid fa-plane-up"></i>
                <span>Voyages</span>
            </a>
            <a href="{{ path('app_activite_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_activite' and not (app.request.attributes.get('_route') starts with 'app_activite_stats') ? 'active' : '' }}">
                <i class="fa-regular fa-compass"></i>
                <span>Activités</span>
            </a>
                  <a href="{{ path('admin_reservations') }}" class="nav-link {{ app.request.attributes.get('_route') == 'admin_reservations' ? 'active' : '' }}">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>Réservations</span>
                </a>
            <a href="#" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_reclamation' ? 'active' : '' }}">
                <i class="fa-regular fa-envelope"></i>
                <span>Réclamations</span>
            </a>
            <a href="{{ path('app_fournisseur_activite_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_fournisseur' ? 'active' : '' }}">
                <i class="fa-solid fa-building"></i>
                <span>Fournisseurs</span>
            </a>
            <a href="{{ path('app_activite_stats') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_activite_stats' ? 'active' : '' }}">
                <i class="fa-solid fa-chart-bar"></i>
                <span>Statistiques</span>
            </a>
            <a href="{{ path('logout') }}" class="nav-link">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Se déconnecter</span>
            </a>
        </nav>
    </aside>

    <!-- ZONE PRINCIPALE -->
    <main class="main-content">
        {% block content %}{% block admin_content %}{% endblock %}{% endblock %}
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Animation de l'indicateur de navigation
            const navLinks = document.querySelectorAll('.nav-link');
            const indicator = document.querySelector('.nav-indicator');

            function moveIndicator(link) {
                const top = link.offsetTop;
                const height = link.offsetHeight;
                indicator.style.top = top + 'px';
                indicator.style.height = height + 'px';
            }

            const activeLink = document.querySelector('.nav-link.active');
            if (activeLink) setTimeout(() => moveIndicator(activeLink), 50);

            navLinks.forEach(link => {
    link.addEventListener('click', function (e) {
        if (this.getAttribute('href') === '#') {
            e.preventDefault(); // ← bloque uniquement les placeholders
        }
        navLinks.forEach(l => l.classList.remove('active'));
        this.classList.add('active');
        moveIndicator(this);
    });
});
        });

        function toggleDropdown(btn) {
            const wrapper = btn.closest('.filter-wrapper');
            const dropdown = wrapper.querySelector('.filter-dropdown');
            const isOpen = dropdown.classList.contains('show');

            document.querySelectorAll('.filter-dropdown').forEach(d => d.classList.remove('show'));
            document.querySelectorAll('.filter-menubtn').forEach(b => b.classList.remove('open'));

            if (!isOpen) {
                dropdown.classList.add('show');
                btn.classList.add('open');
            }
        }

        function selectFilter(item, label) {
            const dropdown = item.closest('.filter-dropdown');
            const wrapper = item.closest('.filter-wrapper');
            const btn = wrapper.querySelector('.filter-menubtn');
            const btnLabel = btn.querySelector('.btn-label');

            dropdown.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('selected'));
            item.classList.add('selected');

            const icon = btnLabel.querySelector('i').outerHTML;
            btnLabel.innerHTML = icon + ' ' + label;
            btn.classList.add('active');

            dropdown.classList.remove('show');
            btn.classList.remove('open');
        }

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.filter-wrapper')) {
                document.querySelectorAll('.filter-dropdown').forEach(d => d.classList.remove('show'));
                document.querySelectorAll('.filter-menubtn').forEach(b => b.classList.remove('open'));
            }
        });
    </script>

    {% block javascripts %}{% endblock %}
</body>

</html>






