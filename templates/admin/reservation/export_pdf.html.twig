<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des réservations</title>
    <style>
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            font-size: 12px;
            line-height: 1.4;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #6B1E1E;
            padding-bottom: 10px;
        }
        .header h1 {
            font-size: 24px;
            color: #6B1E1E;
            margin: 0;
            font-family: 'Playfair Display', serif;
        }
        .header p {
            font-size: 11px;
            color: #777;
            margin: 5px 0 0;
        }
        .stats {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            gap: 15px;
        }
        .stat-card {
            flex: 1;
            background: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
        }
        .stat-card .label {
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            color: #6B1E1E;
            margin-bottom: 5px;
        }
        .stat-card .value {
            font-size: 20px;
            font-weight: bold;
            color: #2c1810;
        }
        .stat-card .sub {
            font-size: 9px;
            color: #aaa;
            margin-top: 3px;
        }
        .filter-info {
            background: #f5f5f5;
            padding: 10px;
            margin-bottom: 20px;
            font-size: 10px;
            border-left: 4px solid #6B1E1E;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #6B1E1E;
            color: white;
            font-size: 11px;
            text-transform: uppercase;
        }
        td {
            font-size: 11px;
        }
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 9px;
            font-weight: bold;
        }
        .badge-paye { background: #d4edda; color: #155724; }
        .badge-attente { background: #fff3cd; color: #856404; }
        .badge-annule { background: #f8d7da; color: #721c24; }
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 9px;
            color: #aaa;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }
        .reduction {
            color: #28a745;
            font-size: 9px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Doura Mondo</h1>
        <p>Voyages d'Exception - Liste des réservations</p>
        <p>Généré le {{ "now"|date("d/m/Y H:i") }}</p>
    </div>

    <div class="stats">
        <div class="stat-card">
            <div class="label">CHIFFRE D'AFFAIRE</div>
            <div class="value">{{ chiffreAffaire|number_format(2, ',', ' ') }} €</div>
            <div class="sub">Total des paiements validés</div>
        </div>
        <div class="stat-card">
            <div class="label">RÉSERVATIONS TOTALES</div>
            <div class="value">{{ totalReservations }}</div>
            <div class="sub">Toutes réservations confondues</div>
        </div>
        <div class="stat-card">
            <div class="label">PAIEMENTS COMPLETS</div>
            <div class="value">{{ totalPaiements }}</div>
            <div class="sub">Transactions validées</div>
        </div>
        <div class="stat-card">
            <div class="label">CLIENTS</div>
            <div class="value">{{ totalClients }}</div>
            <div class="sub">Clients enregistrés</div>
        </div>
    </div>

    {% if search or statut or dateDebut or dateFin %}
    <div class="filter-info">
        <strong>Filtres appliqués :</strong><br>
        {% if search %}Recherche : {{ search }}<br>{% endif %}
        {% if statut %}Statut : {{ statut }}<br>{% endif %}
        {% if dateDebut %}Du : {{ dateDebut|date('d/m/Y') }}<br>{% endif %}
        {% if dateFin %}Au : {{ dateFin|date('d/m/Y') }}{% endif %}
    </div>
    {% endif %}

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>Date départ</th>
                <th>Date retour</th>
                <th>Personnes</th>
                <th>Montant payé</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
            <tr>
                <td><strong>#DMT{{ reservation.id }}</strong></td>
                <td>
                    {{ reservation.client.prenom }} {{ reservation.client.nom }}<br>
                    <small>{{ reservation.client.email }}</small>
                </td>
                <td>{{ reservation.dateDepart|date('d/m/Y') }}</td>
                <td>{{ reservation.dateRetour|date('d/m/Y') }}</td>
                <td>{{ reservation.nombrePersonnes }}</td>
                <td>
                    {% set montantPaye = reservation.paiements|first ? reservation.paiements|first.montant : null %}
                    {% if montantPaye %}
                        <strong>{{ montantPaye|number_format(2, ',', ' ') }} €</strong>
                        {% if montantPaye != reservation.montantTotal %}
                            <br><span class="reduction">(-{{ ((reservation.montantTotal - montantPaye) / reservation.montantTotal * 100)|round }}%)</span>
                        {% endif %}
                    {% else %}
                        {{ reservation.montantTotal|number_format(2, ',', ' ') }} €
                        <br><small>(non payé)</small>
                    {% endif %}
                </td>
                <td>
                    {% if reservation.statut == 'payé' %}
                        <span class="badge badge-paye">PAYÉE</span>
                    {% elseif reservation.statut == 'annulé' %}
                        <span class="badge badge-annule">ANNULÉE</span>
                    {% else %}
                        <span class="badge badge-attente">EN ATTENTE</span>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" style="text-align:center">Aucune réservation trouvée</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Doura Mondo - Voyages d'Exception<br>
        Document généré automatiquement
    </div>
</body>
</html>