{% extends 'base.html.twig' %}
{% block title %}Modifier réservation #{{ reservation.id }}{% endblock %}

{% block stylesheets %}
<style>
.admin-wrapper {
    background: #FAF6EE;
    min-height: 100vh;
    position: relative;
}
.admin-wrapper::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('https://images.pexels.com/photos/358319/pexels-photo-358319.jpeg?w=1600&auto=compress');
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    opacity: 0.15;
    pointer-events: none;
    z-index: 0;
}
.admin-hero, .admin-body {
    position: relative;
    z-index: 1;
}
.admin-hero {
    background: linear-gradient(135deg, #6B1E1E 0%, #8B2C2C 50%, #6B1E1E 100%);
    padding: 28px 40px;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.admin-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    margin: 0;
    letter-spacing: 2px;
}
.admin-hero p {
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    margin: 6px 0 0;
    opacity: 0.75;
    text-transform: uppercase;
}
.admin-body {
    padding: 30px 40px;
}
.section-card {
    background: rgba(255, 255, 255, 0.85);
    border-radius: 12px;
    padding: 30px;
    border: 1px solid rgba(212,184,150,0.3);
    box-shadow: 0 2px 12px rgba(139,44,44,0.06);
    max-width: 900px;
    margin: 0 auto;
}
.section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8B2C2C;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 2px solid #FAF6EE;
}
.form-group {
    margin-bottom: 20px;
}
.form-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #9B7240;
    display: block;
    margin-bottom: 6px;
}
.form-control, .form-select {
    border: 1px solid #E8DDD0;
    border-radius: 6px;
    padding: 10px 14px;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    color: #3f2c24;
    background: #FDFAF5;
    width: 100%;
}
.form-control:focus, .form-select:focus {
    border-color: #8B2C2C;
    box-shadow: 0 0 0 2px rgba(139,44,44,0.1);
    outline: none;
}
.readonly-info {
    background: #FAF6EE;
    padding: 10px 14px;
    border-radius: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    color: #3f2c24;
    border: 1px solid #E8DDD0;
}
.btn-bordeaux {
    background: linear-gradient(135deg, #8B2C2C, #6B1E1E);
    border: none;
    color: white;
    padding: 12px 28px;
    border-radius: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(139,44,44,0.3);
    transition: 0.2s;
}
.btn-bordeaux:hover {
    opacity: 0.9;
    transform: translateY(-1px);
}
.btn-or {
    background: #F0E8D8;
    border: none;
    color: #9B7240;
    padding: 12px 28px;
    border-radius: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-decoration: none;
    display: inline-block;
    transition: 0.2s;
}
.btn-or:hover {
    background: #e8ddcd;
    text-decoration: none;
    color: #3f2c24;
}
.row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -12px;
}
.col {
    flex: 1;
    padding: 0 12px;
}
.col-6 {
    width: 50%;
    padding: 0 12px;
}
@media (max-width: 768px) {
    .col-6 {
        width: 100%;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="admin-wrapper">
    <div class="admin-hero">
        <div>
            <h1>Modifier la réservation #DMT{{ reservation.id }}</h1>
            <p>Mettez à jour les informations du voyage</p>
        </div>
        <a href="{{ path('admin_reservations') }}" style="color:rgba(232,221,201,0.8); font-family:'Montserrat',sans-serif; font-size:11px; text-decoration:none; letter-spacing:1px;">
            ← Retour à la liste
        </a>
    </div>

    <div class="admin-body">
        <div class="section-card">
            <div class="section-title">
                <i class="fas fa-user"></i> Client (non modifiable)
            </div>
            <div class="readonly-info">
                <strong>{{ reservation.client.prenom }} {{ reservation.client.nom }}</strong><br>
                {{ reservation.client.email }}<br>
                {{ reservation.client.telephone }}
            </div>

            <div class="section-title mt-4">
                <i class="fas fa-edit"></i> Détails du voyage
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            {{ form_label(form.voyage, 'Destination', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.voyage, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.voyage) }}
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            {{ form_label(form.nombrePersonnes, 'Nombre de personnes', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.nombrePersonnes, {'attr': {'class': 'form-control', 'min': 1, 'max': 20}}) }}
                            {{ form_errors(form.nombrePersonnes) }}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            {{ form_label(form.dateDepart, 'Date de départ', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.dateDepart, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateDepart) }}
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            {{ form_label(form.dateRetour, 'Date de retour', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.dateRetour, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateRetour) }}
                        </div>
                    </div>
                </div>

                {{ form_rest(form) }}

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-bordeaux">
                        <i class="fas fa-save me-1"></i> Enregistrer
                    </button>
                    <a href="{{ path('admin_reservations') }}" class="btn-or">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}