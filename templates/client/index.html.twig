{% extends 'client/base_client.html.twig' %}

{% block title %}Activités & Expériences{% endblock %}

{% block stylesheets %}
    <style>
        body { background: linear-gradient(135deg, #f5f1ed 0%, #faf9f7 100%); margin: 0; padding: 0; }
        .client-container { max-width: 1400px; margin: 0 auto; padding: 40px 20px; }
    </style>
    <link rel="stylesheet" href="{{ asset('css/clientActivite.css') }}">
{% endblock %}

{% block body %}
<div class="client-container">
<div id="loader" style="display:none; position:fixed; inset:0; background:rgba(245,241,237,0.7); z-index:999; align-items:center; justify-content:center;">
    <div style="width:40px; height:40px; border:3px solid #E8D8C8; border-top-color:#8B0000; border-radius:50%; animation:spin 0.7s linear infinite;"></div>
</div>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
</style>
    <!-- Hero Section -->
    <div class="client-hero">
        <h1>Découvrez nos activités</h1>
        <p>Explorez nos sélections d'expériences uniques</p>
    </div>

    <!-- Filters Section -->
    <div class="client-filters">
        <form method="GET" id="filterForm" class="filter-form">
            <div class="filter-group">
                <input type="text" 
                       name="search" 
                       placeholder="Chercher une activité..." 
                       value="{{ search }}"
                       class="filter-input">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <div class="filter-group">
                <select name="categorie" class="filter-select" onchange="document.getElementById('filterForm').submit();">
                    <option value="">Toutes les catégories</option>
                    <option value="sports" {% if categorie == 'sports' %}selected{% endif %}>Sports</option>
                    <option value="culture" {% if categorie == 'culture' %}selected{% endif %}>Culture</option>
                    <option value="nature" {% if categorie == 'nature' %}selected{% endif %}>Nature</option>
                    <option value="aventure" {% if categorie == 'aventure' %}selected{% endif %}>Aventure</option>
                    <option value="gastronomie" {% if categorie == 'gastronomie' %}selected{% endif %}>Gastronomie</option>
                    <option value="bien-etre" {% if categorie == 'bien-etre' %}selected{% endif %}>Bien-être</option>
                    <option value="plage" {% if categorie == 'plage' %}selected{% endif %}>Plage</option>
                    <option value="visite" {% if categorie == 'visite' %}selected{% endif %}>Visite guidée</option>
                </select>
            </div>

            <div class="filter-group">
                <select name="sortPrix" class="filter-select" onchange="document.getElementById('filterForm').submit();">
                    <option value="">Trier par...</option>
                    <option value="asc" {% if sortPrix == 'asc' %}selected{% endif %}>Prix (croissant)</option>
                    <option value="desc" {% if sortPrix == 'desc' %}selected{% endif %}>Prix (décroissant)</option>
                </select>
            </div>

            <button type="submit" class="filter-btn">
                <i class="fa-solid fa-filter"></i> Filtrer
            </button>
        </form>
    </div>

    <!-- Results Info -->
    <div class="results-info">
        <p>{{ total }} activité{{ total > 1 ? 's' : '' }} trouvée{{ total > 1 ? 's' : '' }}</p>
    </div>

    <!-- Activities Grid -->
    {% if activites %}
        <div class="activities-grid">
            {% for activite in activites %}
                <div class="activity-card">
                    <div class="card-image">
<div class="card-img-wrap" style="background: #f0e8e0 url('{{ activite.imageActivite }}') center/cover no-repeat;">
    {% if not activite.imageActivite %}
        <div class="placeholder-image">
            <i class="fa-solid fa-image"></i>
        </div>
    {% endif %}
</div>
                    </div>

                    <div class="card-content">
                        <h3>{{ activite.nomActivite }}</h3>
                        
                        <p class="card-description">
                            {{ activite.descriptionActivite|slice(0, 100) }}{{ activite.descriptionActivite|length > 100 ? '...' : '' }}
                        </p>

                        <div class="card-meta">
                            <div class="meta-item">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>{{ activite.localisationActivite }}</span>
                            </div>
                            <div class="meta-item">
                                <i class="fa-solid fa-clock"></i>
                                <span>{{ activite.dureeActivite }} min</span>
                            </div>
                            <div class="meta-item">
                                <i class="fa-solid fa-users"></i>
                                <span>{{ activite.capaciteMaxActivite }} pers.</span>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="price">
                                <span class="amount">{{ activite.coutActivite|number_format(2, ',', ' ') }} DT</span>
                            </div>
                            <a href="{{ path('app_client_activity_show', {'id': activite.id}) }}" class="card-link">
                                Voir plus
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Pagination -->
        {% if totalPages > 1 %}
            <div class="pagination-wrap">
                <div class="pagination-info">
                    Page {{ currentPage }} sur {{ totalPages }} ({{ total }} résultats)
                </div>
                
                <div class="paginator">
                    {% if currentPage > 1 %}
                        <a href="?page=1&search={{ search }}&categorie={{ categorie }}&sortPrix={{ sortPrix }}" class="paginator-btn">
                            <i class="fa-solid fa-angles-left"></i>
                        </a>
                        <a href="?page={{ currentPage - 1 }}&search={{ search }}&categorie={{ categorie }}&sortPrix={{ sortPrix }}" class="paginator-btn">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    {% endif %}

                    {% set start = max(1, currentPage - 2) %}
                    {% set end = min(totalPages, currentPage + 2) %}
                    
                    {% for p in start..end %}
                        {% if p == currentPage %}
                            <span class="paginator-btn paginator-active">{{ p }}</span>
                        {% else %}
                            <a href="?page={{ p }}&search={{ search }}&categorie={{ categorie }}&sortPrix={{ sortPrix }}" class="paginator-btn">{{ p }}</a>
                        {% endif %}
                    {% endfor %}

                    {% if currentPage < totalPages %}
                        <a href="?page={{ currentPage + 1 }}&search={{ search }}&categorie={{ categorie }}&sortPrix={{ sortPrix }}" class="paginator-btn">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a href="?page={{ totalPages }}&search={{ search }}&categorie={{ categorie }}&sortPrix={{ sortPrix }}" class="paginator-btn">
                            <i class="fa-solid fa-angles-right"></i>
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="empty-state">
            <i class="fa-solid fa-search"></i>
            <h3>Aucune activité trouvée</h3>
            <p>Modifiez vos critères de recherche et réessayez</p>
            <a href="{{ path('app_client_activities') }}" class="btn-reset">Réinitialiser les filtres</a>
        </div>
    {% endif %}
</div>


<script>
document.addEventListener('DOMContentLoaded', function () {
    const loader = document.getElementById('loader');

    window.addEventListener('load', function () {
        loader.style.display = 'none';
    });

    // Show loader on filter change or form submit
    document.getElementById('filterForm').addEventListener('submit', function () {
        loader.style.display = 'flex';
    });

    document.querySelectorAll('.filter-select').forEach(function (sel) {
        sel.addEventListener('change', function () {
            loader.style.display = 'flex';
        });
    });

    // Debounce search input to avoid submitting on every keystroke
    const searchInput = document.querySelector('input[name="search"]');
    if (searchInput) {
        let timer;
        searchInput.addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                loader.style.display = 'flex';
                document.getElementById('filterForm').submit();
            }, 500); // wait 500ms after user stops typing
        });
    }

    // Fade out before navigating away
    document.querySelectorAll('a.card-link, a.paginator-btn, a.back-link').forEach(function (link) {
        link.addEventListener('click', function () {
            loader.style.display = 'flex';
        });
    });
});
</script>


{% endblock %}

